     });
   read_profile_direct_batch: (requester: principal, conversation_id: 
    text, subjects: vec principal, expected: opt nat) ->
    (variant {
       Err: text;
       Ok: Batch;
     });
   read_vault_chat_access: (subject: principal, chat_type: text, chat_id:
    text) ->
    (variant {
       Err: text;
       Ok: record {
             can_manage: bool;
             club: text;
             team: opt text;
           };
     });
   recapTransform: (record {
                      context: blob;
                      response: HttpRequestResult;
                    }) -> (HttpRequestResult) query;
   recent_conversations: ("principal": principal, limit: nat16) ->
    (variant {
       Err: text;
       Ok: vec RecentConversation;
     });
   register_attachment_metadata: (conversation_id: text, message_id:
    opt text, kind: text, ref_id: text, url: opt text, size_bytes:
    opt nat64) -> (variant {
                     Err: text;
                     Ok: AttachmentMetadata;
                   });
   register_scheduled_message: (conversation_id: text, body: text,
    scheduled_at_ms: nat64) -> (variant {
                                  Err: text;
                                  Ok: ScheduledMessage;
                                });
   reject_join_request: (conversation_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   rekey_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   removeBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_group_member: (conversation_id: text, member: principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   replay_scheduled_message: (id: text) ->
    (variant {
       Err: text;
       Ok: ScheduledMessage;
     });
   request_join_group: (conversation_id: text) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   resolve_content_report: (id: text, status: text) ->
    (variant {
       Err: text;
       Ok: ContentReport;
     });
   restore_group: (conversation_id: text) -> (variant {
                                                Err: text;
                                                Ok;
                                              });
   run_chat_photo_gallery_reminders: (now_ms: nat64, window_start_hours:
    nat32, window_end_hours: nat32, cooldown_days: nat32) ->
    (ChatPhotoReminderResult);
   seal_account_removal: (request: Request__1) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   seal_private_name_writer_window: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   search_messages: (conversation_id: text, needle: text, limit: nat16) ->
    (variant {
       Err: text;
       Ok: vec Message;
     });
   send_message: (conversation_id: text, body: text, idempotency_key: 
    text, attachment: opt Attachment, reply_to_id: opt text) ->
    (variant {
       Err: text;
       Ok: Message;
     });
   send_system_message: (to_user: principal, body: text, idempotency_key:
    text) -> (variant {
                Err: text;
                Ok: Message;
              });
   send_welcome_message: (body: text) -> (variant {
                                            Err: text;
                                            Ok: Message;
                                          });
   set_chat_photo_reminder_settings: (settings: Settings) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_ai_catch_up: (club_id: text, ai_catch_up_enabled: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_dm_allowed_roles: (club_id: text, allowed_roles: vec text) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_dm_settings: (club_id: text, dm_disabled: bool,
    attachments_disabled: bool) -> (variant {
                                      Err: text;
                                      Ok;
                                    });
   set_club_domain_canister: (id: principal) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
   set_club_message_privacy: (club_id: text, force_disable_previews: 
    bool) -> (variant {
                Err: text;
                Ok;
              });
   set_competition_domain_canister: (id: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_dm_attachments_disabled: (user: principal, disabled: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_group_join_policy: (conversation_id: text, join_policy: text,
    category: opt text) -> (variant {
                              Err: text;
                              Ok;
                            });
   set_minimum_app_versions: (versions: vec record {
                                              text;
                                              text;
                                            }) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   set_mute_preference: (conversation_id: text, muted: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_notification_queue_canister: (id: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_recap_config: (config: opt RecapConfig) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   set_transfer_fence: (club: text, fenced: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_typing: (conversation_id: text, is_typing: bool, name: text) ->
    (variant {
       Err: text;
       Ok;
     });
   set_user_messaging_settings: (hide_message_preview: bool,
    ai_catchup_enabled: bool) -> (variant {
                                    Err: text;
                                    Ok;
                                  });
   set_vault_domain_canister: (id: principal) -> (variant {
                                                    Err: text;
                                                    Ok;
                                                  });
   soft_delete_group: (conversation_id: text) -> (variant {
                                                    Err: text;
                                                    Ok;
                                                  });
   submit_content_report: (subject_kind: text, subject_id: text,
    conversation_id: opt text, reason: text, details: opt text) ->
    (variant {
       Err: text;
       Ok: ContentReport;
     });
   summarize_transcript: (scope_id: text, transcript: text) ->
    (variant {
       Err: text;
       Ok: text;
     });
   toggle_reaction: (message_id: text, emoji: text) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   unblock_user: (user: principal) -> (variant {
                                         Err: text;
                                         Ok;
                                       });
   unpin_message: (conversation_id: text, message_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   unread_count: (conversation_id: text) -> (variant {
                                               Err: text;
                                               Ok: Unread;
                                             });
   unread_count_by_club: ("principal": principal) ->
    (variant {
       Err: text;
       Ok: vec ClubUnreadSummary;
     });
   update_group: (conversation_id: text, name: opt text, avatar: opt text,
    description: opt text, admin_only_posting: opt bool) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   update_message: (message_id: text, body: text) ->
    (variant {
       Err: text;
       Ok: Message;
     });
   upsert_club_membership: (user: principal, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   upsert_group_metadata: (conversation_id: text, name: text, kind: text,
    club_id: opt text, team_id: opt text, members: vec principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   /// Public: aggregate record counts (shown in admin settings). Counts only —
   /// no record contents, so no PII is exposed.
   usage_stats: () ->
    (record {
       conversations: nat;
       messages: nat;
       scheduled_messages: nat;
     }) query;
   vote_poll: (poll_id: text, option_index: nat32) ->
    (variant {
       Err: text;
       Ok;
     });
   ws_close: (args: CanisterWsCloseArguments) -> (CanisterWsCloseResult);
   ws_get_messages: (args: CanisterWsGetMessagesArguments) ->
    (CanisterWsGetMessagesResult) query;
   ws_message: (args: CanisterWsMessageArguments, msg_type:
    opt WsAppMessage) -> (CanisterWsMessageResult);
   ws_open: (args: CanisterWsOpenArguments) -> (CanisterWsOpenResult);
   zz_migrate_schema: (ChatPage) -> () query;
 };
type LinkPreview = 
 record {
   description: opt text;
   image: opt text;
   site_name: opt text;
   title: opt text;
 };
type JoinRequest = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   status: text;
   user: principal;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GroupSummary = 
 record {
   avatar: opt text;
   club_id: opt text;
   conversation_id: text;
   description: opt text;
   is_member: bool;
   kind: text;
   member_count: nat32;
   name: text;
   team_id: opt text;
 };
type GroupRole = 
 record {
   conversation_id: text;
   role: text;
   user: principal;
 };
type GroupMetadata = 
 record {
   admin_only_posting: bool;
   avatar: opt text;
   club_id: opt text;
   conversation_id: text;
   created_at_ms: nat64;
   deleted: bool;
   deleted_at_ms: opt nat64;
   deleted_by: opt principal;
   description: opt text;
   kind: text;
   members: vec principal;
   name: text;
   team_id: opt text;
 };
type GatewayPrincipal = principal;
type ForwardRecord = 
 record {
   from_conversation_id: text;
   from_message_id: text;
   message_id: text;
   original_sender: principal;
   to_conversation_id: text;
 };
type DmLink = 
 record {
   a: principal;
   b: principal;
   conversation_id: text;
 };
type Conversation = 
 record {
   club_id: text;
   id: text;
   next_sequence: nat64;
   participants: vec principal;
   team_id: opt text;
 };
type ContentReport = 
 record {
   conversation_id: opt text;
   created_at_ms: nat64;
   details: opt text;
   id: text;
   reason: text;
   reporter: principal;
   status: text;
   subject_id: text;
   subject_kind: text;
 };
type CompetitionAdmin = 
 record {
   conversation_id: text;
   user: principal;
 };
type ClubUnreadSummary = 
 record {
   club_id: text;
   count: nat64;
 };
type ClubMembership = 
 record {
   club_id: text;
   user: principal;
 };
type ClubDmSettings = 
 record {
   ai_catch_up_enabled: bool;
   allowed_roles: vec text;
   attachments_disabled: bool;
   club_id: text;
   dm_disabled: bool;
   force_disable_previews: bool;
 };
type ClientPrincipal = principal;
type ClientKey = 
 record {
   client_nonce: nat64;
   client_principal: ClientPrincipal;
 };
type ChatPhotoReminderRunResult = 
 record {
   posted: nat32;
   scanned: nat32;
   skipped: nat32;
 };
type ChatPhotoReminderResult = 
 variant {
   Err: text;
   Ok: ChatPhotoReminderRunResult;
 };
type ChatPage = 
 record {
   conversations: vec Conversation;
   messages: vec Message;
   next: opt nat;
   poll_votes: opt vec PollVote;
   polls: opt vec Poll;
 };
type CanisterWsOpenResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsOpenArguments = 
 record {
   client_nonce: nat64;
   gateway_principal: GatewayPrincipal;
 };
type CanisterWsMessageResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsMessageArguments = record {msg: WebsocketMessage;};
type CanisterWsGetMessagesResult = 
 variant {
   Err: text;
   Ok: CanisterOutputCertifiedMessages;
 };
type CanisterWsGetMessagesArguments = record {nonce: nat64;};
type CanisterWsCloseResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsCloseArguments = record {client_key: ClientKey;};
type CanisterOutputMessage = 
 record {
   client_key: ClientKey;
   content: blob;
   key: text;
 };
type CanisterOutputCertifiedMessages = 
 record {
   cert: blob;
   is_end_of_queue: bool;
   messages: vec CanisterOutputMessage;
   tree: blob;
 };
type BroadcastResult = 
 record {
   delivered: nat32;
   skipped: vec text;
 };
type Batch = 
 record {
   club: text;
   members: vec bool;
   requester: principal;
   revision: nat;
   subjects: vec principal;
 };
type AttachmentMetadata = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   id: text;
   kind: text;
   message_id: opt text;
   ref_id: text;
   size_bytes: opt nat64;
   uploader: principal;
   url: opt text;
 };
type Attachment = 
 record {
   kind: text;
   ref_id: text;
   url: opt text;
 };
service : (governorInit: principal) -> Main
