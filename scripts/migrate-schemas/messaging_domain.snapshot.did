type WsAppMessage = variant {
                      chat_poke:
                       record {
                         conversation_id: text;
                         sequence: nat64;
                       };};
type WebsocketMessage = 
 record {
   client_key: ClientKey;
   content: blob;
   is_service_message: bool;
   sequence_num: nat64;
   timestamp: nat64;
 };
type UserMessagingSettings = 
 record {
   ai_catchup_enabled: bool;
   hide_message_preview: bool;
   user: principal;
 };
type UnreadSummary = 
 record {
   conversation_id: text;
   count: nat64;
   kind: text;
 };
type Unread = 
 record {
   conversation_id: text;
   count: nat64;
   last_read_sequence: nat64;
   user: principal;
 };
type TypingUser = 
 record {
   name: text;
   user: principal;
 };
type TypingPing = 
 record {
   conversation_id: text;
   last_typed_ms: nat64;
   name: text;
   user: principal;
 };
type State = 
 record {
   attachmentMetadata: vec AttachmentMetadata;
   clubDmSettings: vec ClubDmSettings;
   clubMemberships: vec ClubMembership;
   competitionAdmins: vec CompetitionAdmin;
   contentReports: vec ContentReport;
   conversations: vec Conversation;
   dmAttachmentsDisabled: vec principal;
   dmLinks: vec DmLink;
   forwardRecords: vec ForwardRecord;
   governor: principal;
   groupMetadata: vec GroupMetadata;
   groupRoles: vec GroupRole;
   joinRequests: vec JoinRequest;
   messages: vec Message;
   mutePreferences: vec MutePreference;
   pinnedMessages: vec PinnedMessage;
   pollVotes: vec PollVote;
   polls: vec Poll;
   reactions: vec Reaction;
   receipts: vec Receipt__2;
   roles: vec RoleGrant;
   scheduledMessages: vec ScheduledMessage;
   schema: nat32;
   typingPings: vec TypingPing;
   unread: vec Unread;
   userMessagingSettings: vec UserMessagingSettings;
 };
type Settings = 
 record {
   cooldown_days: nat32;
   enabled: bool;
   window_end_hours: nat32;
   window_start_hours: nat32;
 };
type ScheduledMessage = 
 record {
   body: text;
   conversation_id: text;
   id: text;
   replayed_at_ms: opt nat64;
   replayed_message_id: opt text;
   scheduled_at_ms: nat64;
   sender: principal;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Request__1 = 
 record {
   account_id: text;
   generation: nat64;
   inventory_digest: blob;
   subjects: vec principal;
 };
type Request = 
 record {
   generation: nat64;
   inventory_digest: blob;
   operation_id: text;
 };
type Reference = 
 record {
   content_hash: opt text;
   path: opt text;
   resource_id: text;
   store: opt text;
   url: text;
 };
type RecentConversation = 
 record {
   conversation_id: text;
   kind: text;
   last_message_at_ms: opt nat64;
   last_message_sequence: nat64;
 };
type Receipt__2 = 
 record {
   conversation_id: text;
   message_id: text;
   read: bool;
   user: principal;
 };
type Receipt__1 = 
 record {
   active: nat;
   closing: bool;
   receiver: principal;
   request: Request;
   sealed: bool;
 };
type Receipt = 
 record {
   outstanding: nat;
   receiver: principal;
   request: Request__1;
 };
type RecapConfig = 
 record {
   api_key: text;
   endpoint_url: text;
   model: text;
 };
type ReactionSummary = 
 record {
   count: nat32;
   emoji: text;
 };
type Reaction = 
 record {
   emoji: text;
   message_id: text;
   user: principal;
 };
type PollVote = 
 record {
   option_index: nat32;
   poll_id: text;
   user: principal;
 };
type PollResults = 
 record {
   counts: vec nat32;
   poll: Poll;
   total_votes: nat32;
   votes: opt vec PollVote;
 };
type Poll = 
 record {
   closed: bool;
   conversation_id: text;
   created_at_ms: nat64;
   creator: principal;
   id: text;
   message_id: opt text;
   options: vec text;
   question: text;
 };
type PinnedMessage = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   id: text;
   message_id: text;
   pinned_by: principal;
 };
type Page = 
 record {
   next: opt nat;
   references: vec Reference;
   revision: nat;
   scanned: nat;
 };
type OnlineUser = 
 record {
   last_seen_ms: nat64;
   platform: opt text;
   user: principal;
 };
type MutePreference = 
 record {
   conversation_id: text;
   muted: bool;
   user: principal;
 };
type MessageWithReactions = 
 record {
   message: Message;
   reactions: vec ReactionSummary;
 };
type MessagePage = 
 record {
   latest_sequence: nat64;
   messages: vec Message;
   next_sequence: opt nat64;
 };
type Message = 
 record {
   attachment: opt Attachment;
   body: text;
   conversation_id: text;
   created_at_ms: nat64;
   edited_at_ms: opt nat64;
   id: text;
   idempotency_key: text;
   reply_to_id: opt text;
   sender: principal;
   sequence: nat64;
 };
type Main = 
 service {
   activate_private_name_preparation: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_group_members: (conversation_id: text, members: vec principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   approve_join_request: (conversation_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   block_user: (user: principal) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
   broadcast_announcement: (club_id: text, team_ids: vec text,
    include_club_chat: bool, body: text, idempotency_key: text) ->
    (variant {
       Err: text;
       Ok: BroadcastResult;
     });
   can_dm_user: (other: principal) -> (bool) query;
   close_poll: (poll_id: text) -> (variant {
                                     Err: text;
                                     Ok: Poll;
                                   });
   create_conversation: (club_id: text, team_id: opt text, participants:
    vec principal) -> (variant {
                         Err: text;
                         Ok: Conversation;
                       });
   create_group_with_roles: (club_id: text, team_id: opt text, name: 
    text, kind: text, role_entries: vec record {
                                          principal;
                                          text;
                                        }) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   create_poll: (conversation_id: text, message_id: opt text, question: 
    text, options: vec text) -> (variant {
                                   Err: text;
                                   Ok: Poll;
                                 });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_club_data: (club_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_message: (message_id: text) -> (variant {
                                            Err: text;
                                            Ok: Message;
                                          });
   delete_poll: (poll_id: text) -> (variant {
                                      Err: text;
                                      Ok;
                                    });
   delete_team_data: (team_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   deliver_scheduled_message: (sender: principal, conversation_id: text,
    body: text, idempotency_key: text, attachment: opt Attachment,
    reply_to_id: opt text) -> (variant {
                                 Err: text;
                                 Ok: Message;
                               });
   dm_attachments_disabled: (user: principal) -> (bool) query;
   enable_ai_catch_up_for_all_members: (club_id: text) ->
    (variant {
       Err: text;
       Ok: nat32;
     });
   ensure_broadcast_conversation: () ->
    (variant {
       Err: text;
       Ok: Conversation;
     });
   ensure_club_admin_thread: (club_id: text, member: principal) ->
    (variant {
       Err: text;
       Ok: Conversation;
     });
   ensure_competition_admin_thread: (competition_id: text, member:
    principal) -> (variant {
                     Err: text;
                     Ok: Conversation;
                   });
   ensure_conversation: (club_id: text, team_id: opt text, participants:
    vec principal) -> (variant {
                         Err: text;
                         Ok: Conversation;
                       });
   ensure_default_club_chat: (club_id: text, standard_key: text, existing_id:
    opt text, role_entries: vec record {
                                  principal;
                                  text;
                                }) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   ensure_mini_league_chat: (club_id: text, league_id: text, name: text,
    members: vec principal) -> (variant {
                                  Err: text;
                                  Ok: GroupSummary;
                                });
   export_club_snapshot_page: (club: text, offset: nat, limit: nat) ->
    (variant {
       Err: text;
       Ok: blob;
     }) query;
   export_state: () -> (variant {
                          Err: text;
                          Ok: State;
                        }) query;
   fetch_link_preview: (url: text) -> (variant {
