type Status = 
 variant {
   Delivered;
   Failed;
   Pending;
   Processing;
 };
type ScheduledStatus = 
 variant {
   Cancelled;
   Failed;
   Pending;
   Sent;
 };
type ScheduledResults = 
 variant {
   Err: text;
   Ok: vec ScheduledMessage;
 };
type ScheduledResult = 
 variant {
   Err: text;
   Ok: ScheduledMessage;
 };
type ScheduledMessage = 
 record {
   attempted_at_ms: opt nat64;
   author: text;
   body: text;
   chat_type: ChatType;
   club_id: opt text;
   conversation_id: opt text;
   created_at_ms: nat64;
   error_message: opt text;
   group_id: opt text;
   id: text;
   image_url: opt text;
   recurrence: Recurrence;
   recurrence_parent_id: opt text;
   recurrence_until_ms: opt nat64;
   reply_to_id: opt text;
   scheduled_for_ms: nat64;
   sent_message_id: opt text;
   status: ScheduledStatus;
   team_id: opt text;
   updated_at_ms: nat64;
 };
type Results = 
 variant {
   Err: text;
   Ok: vec Notification;
 };
type ResultNat16 = 
 variant {
   Err: text;
   Ok: nat16;
 };
type Result = 
 variant {
   Err: text;
   Ok: Notification;
 };
type Request = 
 record {
   account_id: text;
   generation: nat64;
   inventory_digest: blob;
   subjects: vec principal;
 };
type Recurrence = 
 variant {
   Daily;
   Monthly;
   None;
   Weekly;
 };
type Receipt = 
 record {
   outstanding: nat;
   receiver: principal;
   request: Request;
 };
type PushDeliveryHealthResult = 
 variant {
   Err: text;
   Ok: PushDeliveryHealth;
 };
type PushDeliveryHealth = 
 record {
   delivered_24h: nat32;
   device_token_count: nat32;
   failed_24h: nat32;
   generated_at_ms: nat64;
   pending_24h: nat32;
   processing_24h: nat32;
   total_24h: nat32;
   window_hours: nat32;
 };
type PushAlertSettingsInput = 
 record {
   alerts_enabled: bool;
   check_window_hours: nat32;
   cooldown_hours: nat32;
   failure_threshold_percent: nat32;
   min_notifications: nat32;
 };
type PushAlertSettings = 
 record {
   alerts_enabled: bool;
   check_window_hours: nat32;
   cooldown_hours: nat32;
   failure_threshold_percent: nat32;
   min_notifications: nat32;
   updated_at_ms: nat64;
   updated_by: opt text;
 };
type PreferencesResult = 
 variant {
   Err: text;
   Ok: Preferences;
 };
type PreferencesPageResult = 
 variant {
   Err: text;
   Ok: PreferencesPage;
 };
type PreferencesPage = 
 record {
   items: vec Preferences;
   total: nat32;
 };
type PreferencesInput = 
 record {
   admin_enabled: bool;
   email_admin_enabled: bool;
   email_events_enabled: bool;
   email_media_enabled: bool;
   email_membership_enabled: bool;
   email_messages_enabled: bool;
   email_pitch_board_enabled: bool;
   email_pom_enabled: bool;
   email_rewards_enabled: bool;
   events_enabled: bool;
   media_enabled: bool;
   membership_enabled: bool;
   messages_enabled: bool;
   pitch_board_enabled: bool;
   pom_enabled: bool;
   rewards_enabled: bool;
   show_message_preview: bool;
 };
type Preferences = 
 record {
   admin_enabled: bool;
   created_at_ms: nat64;
   email_admin_enabled: bool;
   email_events_enabled: bool;
   email_media_enabled: bool;
   email_membership_enabled: bool;
   email_messages_enabled: bool;
   email_pitch_board_enabled: bool;
   email_pom_enabled: bool;
   email_rewards_enabled: bool;
   events_enabled: bool;
   media_enabled: bool;
   membership_enabled: bool;
   messages_enabled: bool;
   pitch_board_enabled: bool;
   pom_enabled: bool;
   rewards_enabled: bool;
   show_message_preview: bool;
   updated_at_ms: nat64;
   user: text;
 };
type Notification = 
 record {
   attempts: nat32;
   body: text;
   club: text;
   created_at_ms: nat64;
   id: text;
   idempotency_key: text;
   kind: text;
   next_attempt_ms: nat64;
   read: bool;
   related_id: opt text;
   status: Status;
   user: text;
 };
type Main = 
 service {
   acknowledge: (id: text, key: text) -> (Result);
   authorize_delivery: (id: text, key: text) ->
    (variant {
       Err: text;
       Ok: bool;
     });
   cancel_scheduled: (id: text, author: text) -> (ScheduledResult);
   claim: (now_ms: nat64, limit: nat16) -> (Results);
   cleanup_stale_device_tokens: (now_ms: nat64, max_age_ms: nat64) ->
    (DeviceTokenCountResult);
   clear_inbox: (user: text, club: opt text) -> (ResultNat16);
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_notification: (id: text) -> (variant {
                                         Err: text;
                                         Ok;
                                       });
   due_scheduled: (now_ms: nat64, limit: nat16) -> (ScheduledResults);
   enqueue: (id: text, user: text, club: text, kind: text, body: text, key:
    text) -> (Result);
   enqueue_competition_broadcast: (users: vec text, club: text, related:
    text, body: text, key: text) -> (variant {
                                       Err: text;
                                       Ok: nat16;
                                     });
   export_club_snapshot: (club: text) ->
    (variant {
       Err: text;
       Ok: blob;
     }) query;
   fail: (id: text, error: text, retry_at_ms: opt nat64) -> (Result);
   fan_out: (inputUsers: vec text, club: text, kind: text, body: text,
    key_prefix: text, related_id: opt text) -> (ResultNat16);
   get_digest: (source: DigestSource, chat_scope_id: text, since_ms: 
    nat64, limit: nat16) -> (DigestResults) query;
   get_notification: (id: text) -> (opt Notification);
   get_preferences: (user: text) -> (Preferences) query;
   get_push_alert_settings: () -> (PushAlertSettings) query;
   get_push_delivery_health: (now_ms: nat64) -> (PushDeliveryHealthResult);
   get_schedule_refreshes: (clubs: vec text) ->
    (vec record {
           club: text;
           key: text;
           team: opt text;
         }) query;
   get_update_reminder_audience: (users: vec text, club: text) ->
    (variant {
       Err: text;
       Ok:
        vec
         record {
           app_version: opt text;
           build_number: opt text;
           platform: text;
           user: text;
         };
     });
   grant_worker: ("principal": principal) -> (variant {
                                                Err: text;
                                                Ok;
                                              });
   import_club_snapshot: (club: text, snapshot: blob) ->
    (variant {
       Err: text;
       Ok: nat;
     });
   list_admin_preferences: (limit: nat32, offset: nat32) ->
    (PreferencesPageResult);
   list_device_tokens: (users: vec text) -> (DeviceTokensResult);
   list_inbox: (user: text, club: opt text, limit: nat16) -> (Results);
   list_preferences_by_club: (club_id: text, limit: nat32, offset: nat32) ->
    (PreferencesPageResult) query;
   list_scheduled: (author: text, target: opt text) ->
    (ScheduledResults) query;
   mark_all_read: (user: text, club: opt text) -> (ResultNat16);
   mark_failed: (id: text, error: text) -> (ScheduledResult);
   mark_read: (id: text) -> (Result);
   mark_sent: (id: text, sent_message_id: text) -> (ScheduledResult);
   memory_stats: () ->
    (record {
       heap_bytes: nat;
       memory_bytes: nat;
       stable_bytes: nat;
     }) query;
   merge_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   prepare_account_removal: (request: Request) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   prepare_my_broadcast_erasure: () -> (variant {
                                          Err: text;
                                          Ok;
                                        });
   purge_club_snapshot: (club: text) -> (variant {
                                           Err: text;
                                           Ok: nat;
                                         });
   purge_my_data: () -> (variant {
                           Err: text;
                           Ok: nat;
                         });
   read_account_get_digest: (source: DigestSource, chat_scope_id: text,
    since_ms: nat64, limit: nat16) -> (DigestResults);
   read_account_get_preferences: (user: text) -> (Preferences);
   read_account_get_push_alert_settings: () -> (PushAlertSettings);
   read_account_get_schedule_refreshes: (clubs: vec text) ->
    (vec record {
           club: text;
           key: text;
           team: opt text;
         });
   read_account_list_scheduled: (author: text, target: opt text) ->
    (ScheduledResults);
   read_account_removal_drain: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   read_competition_broadcast_receipt: (club: text, key: text) ->
    (variant {
       Err: text;
       Ok:
        opt
         record {
           audience: vec text;
           body: text;
           club: text;
           count: nat16;
           related: text;
         };
     });
   read_group_opening_configuration: () -> (vec record {
                                                  text;
                                                  text;
                                                });
   record_chat_notify_batch: (message_id: text, conversation_id: text,
    sender: text, preview: text, recipients: vec text, mute_list:
    vec text) -> (ChatNotifyBatchResult);
   record_digest_item: (id: text, message_id: text, message_type:
    DigestSource, chat_scope_id: text, message_created_at_ms: nat64,
    classification: DigestClassification, summary: text, topic: opt text,
    mentions: vec text, provider: opt text) -> (DigestResult);
   recover: () -> (ResultNat16);
   register_device_token: (platform: text, token: text, p256dh: opt text,
    auth: opt text) -> (variant {
                          Err: text;
                          Ok;
                        });
   register_device_version: (platform: text, app_version: opt text,
    build_number: opt text) -> (variant {
                                  Err: text;
                                  Ok;
                                });
   rekey_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   remove_device_tokens: (user: text, tokens: vec text) ->
    (DeviceTokenCountResult);
   retire_competition_broadcast: (club: text, key: text, audience: vec text,
    count: nat16) -> (variant {
                        Err: text;
                        Ok;
                      });
   schedule_message: (id: text, author: text, chat_type: ChatType, team_id:
    opt text, club_id: opt text, group_id: opt text, conversation_id:
    opt text, body: text, image_url: opt text, reply_to_id: opt text,
    scheduled_for_ms: nat64, recurrence: Recurrence, recurrence_until_ms:
    opt nat64) -> (ScheduledResult);
   seal_account_removal: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   set_club_domain_canister: (id: principal) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
   set_identity_access_canister: (id: principal) -> (variant {
                                                       Err: text;
                                                       Ok;
                                                     });
   set_messaging_domain_canister: (id: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_transfer_fence: (club: text, fenced: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   unregister_device_token: (token: text) -> (DeviceTokenCountResult);
   update_scheduled_message: (id: text, author: text, body: opt text,
    image_url: opt text, scheduled_for_ms: opt nat64, recurrence:
    opt Recurrence, recurrence_until_ms: opt nat64) -> (ScheduledResult);
   upsert_preferences: (user: text, input: PreferencesInput) ->
    (PreferencesResult);
   upsert_push_alert_settings: (input: PushAlertSettingsInput) ->
    (PushAlertSettings);
   zz_migrate_schema: (FenceSnapshot) -> () query;
 };
type FenceSnapshot = 
 record {
   broadcast_proofs: opt vec record {
                               text;
                               BroadcastReceipt;
                               vec text;
                             };
   items: vec Notification;
   scheduled: vec ScheduledMessage;
 };
type DigestSource = 
 variant {
   Club;
   Group;
   Team;
 };
type DigestResults = 
 variant {
   Err: text;
   Ok: vec DigestItem;
 };
type DigestResult = 
 variant {
   Err: text;
   Ok: DigestItem;
 };
type DigestItem = 
 record {
   chat_scope_id: text;
   classification: DigestClassification;
   digested_at_ms: nat64;
   id: text;
   mentions: vec text;
   message_created_at_ms: nat64;
   message_id: text;
   message_type: DigestSource;
   provider: opt text;
   summary: text;
   topic: opt text;
 };
type DigestClassification = 
 variant {
   Action;
   Decision;
   Info;
   Question;
   Social;
 };
type DeviceTokensResult = 
 variant {
   Err: text;
   Ok: vec DeviceToken;
 };
type DeviceTokenCountResult = 
 variant {
   Err: text;
   Ok: nat16;
 };
type DeviceToken = 
 record {
   auth: opt text;
   p256dh: opt text;
   platform: text;
   token: text;
   updated_at_ms: nat64;
   user: text;
 };
type ChatType = 
 variant {
   Broadcast;
   Club;
   ClubAdmin;
   Direct;
   Group;
   Team;
 };
type ChatNotifyBatchResult = 
 variant {
   Err: text;
   Ok: nat16;
 };
type BroadcastReceipt = 
 record {
   body: text;
   club: text;
   count: nat16;
   related: text;
 };
service : (governorInit: principal) -> Main
