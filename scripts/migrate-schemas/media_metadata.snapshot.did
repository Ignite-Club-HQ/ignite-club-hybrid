type State = 
 record {
   albums: vec Album;
   assets: vec Asset;
   capabilities: vec Capability;
   comments: vec Comment;
   galleryChatCards: vec GalleryChatCard;
   governor: principal;
   reactions: vec Reaction;
   roles: vec RoleGrant;
   schema: nat32;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Result = 
 variant {
   Err: text;
   Ok: Page__1;
 };
type Request = 
 record {
   account_id: text;
   generation: nat64;
   inventory_digest: blob;
   subjects: vec principal;
 };
type Reference = 
 record {
   content_hash: opt text;
   path: opt text;
   resource_id: text;
   store: opt text;
   url: text;
 };
type Receipt = 
 record {
   outstanding: nat;
   receiver: principal;
   request: Request;
 };
type Reaction = 
 record {
   asset_id: text;
   created_at_ms: nat64;
   kind: text;
   user: principal;
 };
type Page__1 = 
 record {
   assets: vec Asset;
   next: opt Cursor;
   scanned: nat;
 };
type Page = 
 record {
   next: opt nat;
   references: vec Reference;
   revision: nat;
   scanned: nat;
 };
type Main = 
 service {
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_comment: (asset_id: text, body: text, created_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Comment;
     });
   add_comment_reply: (asset_id: text, body: text, reply_to_id: opt text) ->
    (variant {
       Err: text;
       Ok: Comment;
     });
   add_reaction: (asset_id: text, kind: text, created_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Reaction;
     });
   announce_gallery_asset: (asset_id: text) ->
    (variant {
       Err: text;
       Ok: text;
     });
   build_asset_page_index: () ->
    (variant {
       Err: text;
       Ok: record {
             complete: bool;
             scanned: nat;
           };
     });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_asset: (asset_id: text) -> (variant {
                                        Err: text;
                                        Ok: Asset;
                                      });
   delete_comment: (comment_id: text) -> (variant {
                                            Err: text;
                                            Ok: Comment;
                                          });
   delete_gallery_chat_card: (card_id: text) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
   export_club_snapshot: (club: text) ->
    (variant {
       Err: text;
       Ok: blob;
     }) query;
   export_state: () -> (variant {
                          Err: text;
                          Ok: State;
                        }) query;
   get_asset: (asset_id: text) -> (opt Asset) query;
   get_gallery_chat_card: (card_id: text) -> (opt GalleryChatCard) query;
   grant_role: ("principal": principal, role: text, club_id: opt text,
    team_id: opt text) -> (variant {
                             Err: text;
                             Ok;
                           });
   import_club_snapshot: (club: text, snapshot: blob) ->
    (variant {
       Err: text;
       Ok: nat;
     });
   issue_capability: (asset_id: text, action: text, purpose: text,
    expires_at_ms: nat64) -> (variant {
                                Err: text;
                                Ok: Capability;
                              });
   listBulkAccessPrincipals: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
   list_assets: (club_id: text) -> (vec Asset) query;
   list_assets_page: (club_id: text, cursor: opt Cursor, limit: nat) ->
    (Result) query;
   list_comments: (asset_id: text) -> (vec Comment) query;
   list_gallery_chat_cards: (club_id: text, team_id: text) ->
    (vec GalleryChatCard) query;
   list_reactions: (asset_id: text) -> (vec Reaction) query;
   memory_stats: () ->
    (record {
       heap_bytes: nat;
       memory_bytes: nat;
       stable_bytes: nat;
     }) query;
   merge_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   prepare_account_removal: (request: Request) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   purge_club_snapshot: (club: text) -> (variant {
                                           Err: text;
                                           Ok: nat;
                                         });
   read_account_get_asset: (asset_id: text) -> (opt Asset);
   read_account_get_gallery_chat_card: (card_id: text) ->
    (opt GalleryChatCard);
   read_account_list_assets: (club_id: text) -> (vec Asset);
   read_account_list_assets_page: (club_id: text, cursor: opt Cursor, limit:
    nat) -> (Result);
   read_account_list_comments: (asset_id: text) -> (vec Comment);
   read_account_list_gallery_chat_cards: (club_id: text, team_id: text) ->
    (vec GalleryChatCard);
   read_account_list_reactions: (asset_id: text) -> (vec Reaction);
   read_account_removal_drain: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   read_club_media_references: (club: text, offset: nat, expected:
    opt nat) -> (variant {
                   Err: text;
                   Ok: Page;
                 });
   read_gallery_asset_for_service: (user: principal, asset_id: text) ->
    (variant {
       Err: text;
       Ok: Asset;
     });
   read_gallery_view_counts: (ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec record {
                 text;
                 nat;
               };
     });
   read_group_opening_configuration: () -> (vec record {
                                                  text;
                                                  text;
                                                });
   record_gallery_view: (asset_id: text) -> (variant {
                                               Err: text;
                                               Ok: nat;
                                             });
   register_asset: (club_id: text, kind: text, mime: text, checksum: 
    text, storage_path: text, visibility: text, expires_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Asset;
     });
   rekey_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   removeBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_gallery_asset: (asset_id: text, mode: text) ->
    (variant {
       Err: text;
       Ok: record {vault_updated: bool;};
     });
   remove_reaction: (asset_id: text) -> (variant {
                                           Err: text;
                                           Ok;
                                         });
   save_gallery_chat_card: (id: opt text, club_id: text, team_id: text,
    event_id: opt text, message_id: text, hero_photo_id: opt text,
    hero_image_url: opt text, photo_count: nat32, photo_ids: vec text,
    is_prompt: bool, push_sent: bool) ->
    (variant {
       Err: text;
       Ok: GalleryChatCard;
     });
   seal_account_removal: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   set_asset_scope: (asset_id: text, team_id: opt text, mini_league_id:
    opt text, competition_id: opt text, event_id: opt text, caption:
    opt text, album_id: opt text) -> (variant {
                                        Err: text;
                                        Ok: Asset;
                                      });
   set_blob_ref: (asset_id: text, blob_ref: opt BlobRef) ->
    (variant {
       Err: text;
       Ok: Asset;
     });
   set_gallery_authorities: (club: principal, vault: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_transfer_fence: (club: text, fenced: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   zz_migrate_schema: (FenceSnapshot) -> () query;
 };
type GalleryChatCard = 
 record {
   club_id: text;
   created_at_ms: nat64;
   event_id: opt text;
   hero_image_url: opt text;
   hero_photo_id: opt text;
   id: text;
   is_prompt: bool;
   message_id: text;
   photo_count: nat32;
   photo_ids: vec text;
   push_sent: bool;
   team_id: text;
   updated_at_ms: nat64;
   uploader_id: principal;
 };
type FenceSnapshot = 
 record {
   albums: opt vec Album;
   assets: vec Asset;
   capabilities: vec Capability;
   cards: vec GalleryChatCard;
   comments: vec Comment;
   reactions: vec Reaction;
   roles: vec RoleGrant;
 };
type Cursor = 
 record {
   before: text;
   club_id: text;
   revision: nat;
 };
type Comment = 
 record {
   asset_id: text;
   author: principal;
   body: text;
   created_at_ms: nat64;
   deleted: bool;
   id: text;
   reply_to_id: opt text;
 };
type Capability = 
 record {
   action: text;
   allowed: bool;
   asset_id: text;
   expires_at_ms: nat64;
   owner: principal;
   purpose: text;
 };
type BlobRef = 
 record {
   canister: text;
   content_hash: text;
   path: text;
 };
type Asset = 
 record {
   album_id: opt text;
   blob_ref: opt BlobRef;
   caption: opt text;
   checksum: text;
   child_sensitive: bool;
   club_id: text;
   competition_id: opt text;
   content_length: nat64;
   created_at_ms: nat64;
   deleted: bool;
   encrypted: bool;
   event_id: opt text;
   expires_at_ms: nat64;
   id: text;
   kind: text;
   mime: text;
   mini_league_id: opt text;
   owner: principal;
   retention_until_ms: nat64;
   storage_path: text;
   team_id: opt text;
   visibility: text;
 };
type Album = 
 record {
   club_id: text;
   cover_asset_id: opt text;
   created_at_ms: nat64;
   created_by: principal;
   id: text;
   title: text;
 };
service : (governorInit: principal) -> Main
