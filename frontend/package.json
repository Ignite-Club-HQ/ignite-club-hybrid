{
  "name": "ignite-club-hybrid-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-live-config.mjs && node scripts/dev-live.mjs",
    "dev:lab": "node scripts/check-isolation.mjs && vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "npm run build:live",
    "build:lab": "node scripts/check-isolation.mjs && vite build",
    "build:product": "node scripts/build-product.mjs",
    "build:live": "node scripts/check-live-config.mjs && node scripts/build-live.mjs",
    "check:product-bundle": "node scripts/check-product-bundle.mjs",
    "preview:lab": "node scripts/check-isolation.mjs && vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "node --test lab-tests/*.test.mjs && vitest run --config vitest.lab.config.mjs --configLoader runner",
    "test:lab": "vitest run --config vitest.lab.config.mjs --configLoader runner",
    "test:legacy": "vitest run --config vitest.legacy.config.mjs",
    "test:provider-matrix": "vitest run --config vitest.lab.config.mjs --configLoader runner lab-tests/backend-provider-matrix.test.tsx",
    "test:backend:icp": "vitest run --config vitest.lab.config.mjs --configLoader runner lab-tests/backend-provider-matrix.test.tsx -t icp",
    "test:backend:supabase": "vitest run --config vitest.lab.config.mjs --configLoader runner lab-tests/backend-provider-matrix.test.tsx -t supabase",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:all": "npm run test && npm run test:legacy && npm run test:e2e && npm run test:icp:local-baseline",
    "test:all:icp": "node scripts/run-forced-backend-matrix.mjs icp",
    "test:all:supabase": "node scripts/run-forced-backend-matrix.mjs supabase",
    "test:backend:switch": "sh -c 'status=0; node scripts/local-icp.mjs deploy && IGNITE_LAB_BACKEND_SWITCH_E2E=1 npx playwright test --config playwright.config.ts e2e/backend-switch.spec.ts || status=$?; node scripts/local-icp.mjs stop || status=$?; exit $status'",
    "test:auth:icp:internet-identity": "sh -c 'status=0; node scripts/local-icp.mjs deploy && node scripts/test-local-internet-identity.mjs || status=$?; node scripts/local-icp.mjs stop || status=$?; exit $status'",
    "test:icp:local-baseline": "node scripts/run-local-icp-baseline.mjs",
    "test:messaging:icp:performance": "sh -c 'status=0; node scripts/local-icp.mjs deploy && node scripts/test-icp-messaging-performance.mjs \"$@\" || status=$?; node scripts/local-icp.mjs stop || status=$?; exit $status' sh",
    "check:exported-tests": "node scripts/check-exported-test-inventory.mjs",
    "test:exported": "npm run test && npm run test:legacy && npm run check:exported-tests",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:quality-ratchet": "node scripts/check-quality-ratchet.mjs",
    "check:duplication": "node scripts/check-duplication-ratchet.mjs",
    "check:duplication:update-baseline": "node scripts/check-duplication-ratchet.mjs --update-baseline",
    "lint": "eslint --max-warnings=0 src/lib/observability src/lib/csv.ts src/product-main.tsx vite.product.config.ts scripts/build-product.mjs scripts/check-product-bundle.mjs",
    "typecheck:strict": "tsc -p tsconfig.strict.json",
    "typecheck:product": "node scripts/check-product-type-errors.mjs",
    "typecheck:product:update-baseline": "node scripts/check-product-type-errors.mjs --write-baseline",
    "test:observability": "vitest run --config vitest.legacy.config.mjs src/lib/observability/observability.test.ts",
    "test:frontend-boundaries": "vitest run --config vitest.legacy.config.mjs src/lib/observability/observability.test.ts src/lib/csv.test.ts",
    "check:route-classification": "node scripts/check-route-classification.mjs",
    "check:prod-secrets": "node scripts/check-production-secrets.mjs",
    "check:live-config": "node scripts/check-live-config.mjs",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "check:topology": "node scripts/check-topology.mjs",
    "check:candid-drift": "node scripts/check-candid-drift.mjs",
    "check:step1": "npm run check:topology && npm run check:candid-drift",
    "check:parity": "node scripts/check-parity-matrix.mjs",
    "check:parity-evidence": "node scripts/check-parity-evidence.mjs",
    "test:server": "node scripts/server-smoke.mjs",
    "typecheck:lab": "tsc -p tsconfig.lab.json",
    "bindings:lab": "icp-bindgen --did-file ../backend/club_links/club_links.did --out-dir src/lab/bindings --actor-disabled --force",
    "test:icp": "node scripts/test-canister.mjs exercise",
    "test:identity-access": "node scripts/test-identity-access.mjs",
    "test:club-domain": "node scripts/test-club-domain.mjs",
    "test:domain-canisters": "node scripts/test-domain-canisters.mjs",
    "test:events-motoko-comparison": "node scripts/test-events-motoko-comparison.mjs",
    "test:product-motoko-canisters": "node scripts/test-product-motoko-canisters.mjs",
    "bootstrap:identity-local": "node scripts/bootstrap-identity-local.mjs",
    "test:browser": "node scripts/browser-poc.mjs",
    "test:browser:supabase": "node scripts/supabase-browser-poc.mjs",
    "test:browser:hybrid": "node scripts/hybrid-browser-poc.mjs",
    "test:placement-registry": "node scripts/test-placement-registry.mjs",
    "test:placement-admin-live": "node scripts/test-placement-admin-live.mjs",
    "test:live-smoke": "node scripts/test-live-smoke.mjs",
    "test:control-plane-federation": "node scripts/test-control-plane-federation.mjs",
    "test:timer-jobs": "node scripts/test-timer-jobs.mjs",
    "test:timer-client": "node --experimental-strip-types scripts/test-timer-client.mjs",
    "test:timer-upgrade": "node scripts/test-timer-upgrade.mjs",
    "test:notification-queue": "node scripts/test-notification-queue.mjs",
    "test:hybrid-notification-live": "node --experimental-strip-types scripts/test-hybrid-notification-live.mjs",
    "test:notification-upgrade": "node scripts/test-notification-upgrade.mjs",
    "benchmark:notification-implementations": "node scripts/benchmark-notification-implementations.mjs",
    "benchmark:scaling": "node scripts/scaling-benchmark.mjs",
    "benchmark:local-icp": "node scripts/local-load-test.mjs",
    "benchmark:messaging:icp": "node scripts/test-icp-messaging-performance.mjs --json"
  },
  "dependencies": {
