type backend = variant { Icp : record { canister : principal }; Supabase : record { environment : text } };
type backend_kind = variant { Icp; Supabase };
type availability = record { icp_enabled : bool; supabase_enabled : bool; version : nat64 };
type policy = record { country : text; icp_enabled : bool; supabase_enabled : bool; version : nat64 };
type init = record { governor : principal };
type page = record { next : opt text; placements : vec placement; registry_version : nat64 };
type placement_state = variant { Active; Blocked; MigrationRequired; ReadOnly };
type placement = record { backend : backend; club_id : text; country : text; state : placement_state; version : nat64 };
type decision = record { backend_enabled : bool; country_allowed : bool; placement : placement; reason : text; writable : bool };
type result_availability = variant { Ok : availability; Err : text };
type result_decision = variant { Ok : opt decision; Err : text };
type result_opt_placement = variant { Ok : opt placement; Err : text };
type result_page = variant { Ok : page; Err : text };
type result_policy = variant { Ok : policy; Err : text };
type result_placement = variant { Ok : placement; Err : text };
type audit_event = record { id : nat64; at_ns : nat64; caller : principal; action : text; club_id : opt text; detail : text; registry_version : nat64 };
type audit_page = record { events : vec audit_event; next : opt nat64 };
type result_audit_page = variant { Ok : audit_page; Err : text };
type target = record { alias : text; site_id : opt text; profile : text; backend : backend; deployment_class : text; enabled : bool; healthy : bool; version : nat64 };
type site_availability = record { site_id : text; enabled : bool; version : nat64 };
type result_site_availability = variant { Ok : site_availability; Err : text };
type result_bool = variant { Ok : bool; Err : text };
type residency_assignment = record { club_id : text; profile : text; target_alias : text; version : nat64 };
type residency_policy = record { country : text; allowed_profiles : vec text; version : nat64 };
type operator_role = variant { PlacementAdmin; MigrationOperator; SecurityAdmin; InfrastructureAdmin; Auditor };
type operator_record = record { user : principal; roles : vec operator_role };
type result_target = variant { Ok : target; Err : text };
type result_opt_target = variant { Ok : opt target; Err : text };
type result_residency = variant { Ok : residency_assignment; Err : text };
type result_opt_residency = variant { Ok : opt residency_assignment; Err : text };
type result_residency_policy = variant { Ok : residency_policy; Err : text };
type result_operator = variant { Ok : operator_record; Err : text };
type result_unit = variant { Ok; Err : text };
service : (init) -> {
  get_availability : () -> (availability) query;
  get_site_availability : (text) -> (result_bool) query;
  get_decision : (text) -> (result_decision) query;
  get_policy : (text) -> (result_policy) query;
  get_placement : (text) -> (result_opt_placement) query;
  list_placements : (opt text, nat16) -> (result_page) query;
  list_audit : (opt nat64, nat16) -> (result_audit_page) query;
  get_target : (text) -> (result_opt_target) query;
  get_residency : (text) -> (result_opt_residency) query;
  get_residency_policy : (text) -> (result_residency_policy) query;
  get_operator : (principal) -> (result_operator) query;
  grant_operator : (principal, vec operator_role) -> (result_operator);
  revoke_operator : (principal) -> (result_unit);
  set_target : (text, opt text, text, backend, text, bool, nat64) -> (result_target);
  set_target_health : (text, bool, nat64) -> (result_target);
  set_site_availability : (text, bool, nat64) -> (result_site_availability);
  set_residency_policy : (text, vec text, nat64) -> (result_residency_policy);
  set_residency : (text, text, text, nat64) -> (result_residency);
  set_availability : (backend_kind, bool, nat64) -> (result_availability);
  set_placement : (text, text, backend, nat64) -> (result_placement);
  set_policy : (text, bool, bool, nat64) -> (result_policy);
  set_state : (text, placement_state, nat64) -> (result_placement);
  version : () -> (nat64) query;
};
