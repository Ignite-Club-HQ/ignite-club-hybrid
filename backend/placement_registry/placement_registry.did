type AuditEvent = record {
  id : nat64;
  action : text;
  at_ns : nat64;
  registry_version : nat64;
  detail : text;
  caller : principal;
  club_id : opt text;
};
type AuditPage = record { next : opt nat64; events : vec AuditEvent };
type Availability = record {
  icp_enabled : bool;
  version : nat64;
  supabase_enabled : bool;
};
type Backend = variant {
  Icp : record { canister : principal };
  Supabase : record { environment : text };
};
type BackendKind = variant { Icp; Supabase };
type Decision = record {
  writable : bool;
  placement : Placement;
  country_allowed : bool;
  backend_enabled : bool;
  reason : text;
};
type Init = record { governor : principal };
type MemoryStats = record {
  memory_bytes : nat;
  stable_bytes : nat;
  heap_bytes : nat;
};
type Operator = record { user : principal; roles : vec OperatorRole };
type OperatorRole = variant {
  Auditor;
  PlacementAdmin;
  SecurityAdmin;
  InfrastructureAdmin;
  MigrationOperator;
};
type Page = record {
  placements : vec Placement;
  next : opt text;
  registry_version : nat64;
};
type Placement = record {
  country : text;
  version : nat64;
  state : PlacementState;
  club_id : text;
  backend : Backend;
};
type PlacementState = variant { Blocked; Active; ReadOnly; MigrationRequired };
type Policy = record {
  country : text;
  icp_enabled : bool;
  version : nat64;
  supabase_enabled : bool;
};
type ResidencyAssignment = record {
  version : nat64;
  target_alias : text;
  club_id : text;
  profile : text;
};
type ResidencyPolicy = record {
  country : text;
  allowed_profiles : vec text;
  version : nat64;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : opt Decision; Err : text };
type Result_10 = variant { Ok : AuditPage; Err : text };
type Result_11 = variant { Ok : Page; Err : text };
type Result_12 = variant { Ok : WriterReceipt; Err : text };
type Result_13 = variant { Ok : Availability; Err : text };
type Result_14 = variant { Ok : Placement; Err : text };
type Result_15 = variant { Ok : ResidencyAssignment; Err : text };
type Result_16 = variant { Ok : SiteAvailability; Err : text };
type Result_17 = variant { Ok : Target; Err : text };
type Result_2 = variant { Ok : opt Operator; Err : text };
type Result_3 = variant { Ok : opt Placement; Err : text };
type Result_4 = variant { Ok : Policy; Err : text };
type Result_5 = variant { Ok : opt ResidencyAssignment; Err : text };
type Result_6 = variant { Ok : ResidencyPolicy; Err : text };
type Result_7 = variant { Ok : bool; Err : text };
type Result_8 = variant { Ok : opt Target; Err : text };
type Result_9 = variant { Ok : Operator; Err : text };
type SiteAvailability = record {
  version : nat64;
  enabled : bool;
  site_id : text;
};
type Target = record {
  alias : text;
  deployment_class : text;
  healthy : bool;
  version : nat64;
  enabled : bool;
  site_id : opt text;
  profile : text;
  backend : Backend;
};
type WriterReceipt = record {
  active : nat;
  request : WriterRequest;
  sealed : bool;
  closing : bool;
  receiver : principal;
};
type WriterRequest = record {
  inventory_digest : blob;
  generation : nat64;
  operation_id : text;
};
service : (Init) -> {
  activate_private_name_preparation : (WriterRequest) -> (Result);
  // Public: remaining cycles (shown in admin settings).
  cycles_balance : () -> (nat) query;
  finish_private_name_preparation : (WriterRequest) -> (Result);
  freeze_private_name_preparation : (WriterRequest) -> (Result);
  get_availability : () -> (Availability) query;
  get_decision : (text) -> (Result_1) query;
  get_operator : (principal) -> (Result_2) query;
  get_placement : (text) -> (Result_3) query;
  get_policy : (text) -> (Result_4) query;
  get_residency : (text) -> (Result_5) query;
  get_residency_policy : (text) -> (Result_6) query;
  get_site_availability : (text) -> (Result_7) query;
  get_target : (text) -> (Result_8) query;
  grant_operator : (principal, vec OperatorRole) -> (Result_9);
  list_audit : (opt nat64, nat16) -> (Result_10) query;
  list_placements : (opt text, nat16) -> (Result_11) query;
  // Public: live memory reading for the admin health page.
  memory_stats : () -> (MemoryStats) query;
  open_private_name_writer_window : (WriterRequest) -> (Result);
  read_private_name_preparation : (WriterRequest) -> (Result_12);
  read_private_name_writer_window : (WriterRequest) -> (Result_12);
  revoke_operator : (principal) -> (Result);
  seal_private_name_writer_window : (WriterRequest) -> (Result);
  set_availability : (BackendKind, bool, nat64) -> (Result_13);
  set_placement : (text, text, Backend, nat64) -> (Result_14);
  set_policy : (text, bool, bool, nat64) -> (Result_4);
  set_residency : (text, text, text, nat64) -> (Result_15);
  set_residency_policy : (text, vec text, nat64) -> (Result_6);
  set_site_availability : (text, bool, nat64) -> (Result_16);
  set_state : (text, PlacementState, nat64) -> (Result_14);
  set_target : (text, opt text, text, Backend, text, bool, nat64) -> (
      Result_17,
    );
  set_target_health : (text, bool, nat64) -> (Result_17);
  version : () -> (nat64) query;
}