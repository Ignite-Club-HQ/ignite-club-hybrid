type status = variant { Pending; Processing; Completed; Failed };
type job = record { id : text; scope : text; callback : opt principal; run_at_ms : nat64; lease_until_ms : opt nat64; idempotency_key : text; status : status; attempts : nat32; last_error : opt text };
type page = record { jobs : vec job; next : opt text };
type queue_state = record { armed : bool; next_run_at_ms : opt nat64 };
type snapshot = record { jobs : vec job; state : queue_state };
type reconciliation = record { local_jobs : nat32; incoming_jobs : nat32; matching_jobs : nat32 };
type result_unit = variant { Ok; Err : text };
type result_job = variant { Ok : job; Err : text };
type result_jobs = variant { Ok : vec job; Err : text };
type result_page = variant { Ok : page; Err : text };
type result_state = variant { Ok : queue_state; Err : text };
type result_nat16 = variant { Ok : nat16; Err : text };
type result_snapshot = variant { Ok : snapshot; Err : text };
type result_reconciliation = variant { Ok : reconciliation; Err : text };
service : () -> {
  arm : (nat64) -> (result_state);
  claim : (nat64, nat16) -> (result_jobs);
  claim_with_lease : (nat64, nat16, nat64) -> (result_jobs);
  complete : (text, text) -> (result_job);
  fail : (text, text, opt nat64) -> (result_job);
  grant_callback_scope : (principal, text) -> (result_unit);
  grant_worker_scope : (principal, text) -> (result_unit);
  get_job : (text) -> (opt job) query;
  get_state : () -> (queue_state) query;
  initialize : () -> (result_unit);
  grant_worker : (principal) -> (result_unit);
  list_jobs : (opt text, nat16) -> (result_page) query;
  recover_interrupted : () -> (result_nat16);
  recover_expired : (nat64) -> (result_nat16);
  export_state : () -> (result_snapshot) query;
  import_state : (snapshot) -> (result_unit);
  reconcile : (snapshot) -> (result_reconciliation) query;
  schedule : (text, text, nat64, text) -> (result_job);
  schedule_with_callback : (text, text, opt principal, nat64, text) -> (result_job);
};
