    text, location: opt text, opponent: opt text, address: opt text,
    mini_league_id: opt text, starts_at_ms: nat64, ends_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Event;
     });
   update_series: (id: text, title: text, description: text, event_type:
    text, location: opt text, from_ms: nat64) ->
    (variant {
       Err: text;
       Ok: EventSeries;
     });
 };
type LineupSnapshot = 
 record {
   ball_x: opt float64;
   ball_y: opt float64;
   event_id: text;
   formation: opt text;
   players: vec LineupPlayer;
   revision: nat64;
   team_id: opt text;
   team_size: nat16;
   updated_at_ms: nat64;
   updated_by: principal;
 };
type LineupPlayer = 
 record {
   bench: bool;
   member: text;
   number: opt nat16;
   slot: text;
   x: opt float64;
   y: opt float64;
 };
type LineupEntry = 
 record {
   event_id: text;
   member: text;
   slot: text;
   team_id: opt text;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GroupSpecInput = 
 record {
   ability_band: opt text;
   display_order: nat16;
   duties: vec GroupDutyInput;
   name: text;
   pitch_name: opt text;
   players: vec GroupPlayerInput;
   team_a_colour: opt text;
   team_b_colour: opt text;
 };
type GroupPlayerInput = 
 record {
   account_id: text;
   team_letter: opt text;
 };
type GroupDutyInput = 
 record {
   account_id: opt text;
   duty: text;
 };
type GameSummary = 
 record {
   event_id: text;
   formation_used: opt text;
   half_duration: nat32;
   team_id: text;
   total_game_time: nat32;
   total_substitutions: nat16;
   updated_at_ms: nat64;
 };
type GameResult = 
 record {
   away_label: text;
   away_score: nat32;
   event_id: opt text;
   home_label: text;
   home_score: nat32;
   id: text;
   mvp_player_id: opt text;
   mvp_player_name: opt text;
   period_scores_json: text;
   player_stats_json: text;
   saved_by: principal;
   sport: text;
   team_id: text;
   updated_at_ms: nat64;
 };
type GamePlayerStatInput = 
 record {
   fill_in_player_name: opt text;
   goals_scored: nat16;
   jersey_number: opt nat16;
   minutes_played: nat32;
   positions_played: vec text;
   started_on_pitch: bool;
   substitutions_count: nat16;
   user_id: opt text;
 };
type GamePlayerStat = 
 record {
   event_id: text;
   fill_in_player_name: opt text;
   goals_scored: nat16;
   jersey_number: opt nat16;
   minutes_played: nat32;
   positions_played: vec text;
   started_on_pitch: bool;
   substitutions_count: nat16;
   team_id: text;
   user_id: opt text;
 };
type EventView = 
 record {
   event_id: text;
   viewed_at_ms: nat64;
   viewer: principal;
 };
type EventSeries = 
 record {
   club_id: text;
   creator: principal;
   deleted: bool;
   description: text;
   event_type: text;
   first_ends_at_ms: nat64;
   first_starts_at_ms: nat64;
   frequency: text;
   id: text;
   location: opt text;
   revision: nat64;
   team_id: opt text;
   title: text;
   until_ms: nat64;
 };
type EventRoster = 
 record {
   guests: vec EventGuest;
   rsvps: vec RsvpWithChild;
 };
type EventGuest = 
 record {
   added_by: principal;
   created_at_ms: nat64;
   event_id: text;
   guest_name: text;
   id: text;
 };
type EventGroupPlayer = 
 record {
   account_id: text;
   group_id: text;
   team_letter: opt text;
 };
type EventGroupDuty = 
 record {
   account_id: opt text;
   duty: text;
   group_id: text;
 };
type EventGroup = 
 record {
   ability_band: opt text;
   colour: opt text;
   created_at_ms: nat64;
   display_order: nat16;
   event_id: text;
   id: text;
   name: text;
   pitch_name: opt text;
   team_b_colour: opt text;
   team_letter: opt text;
 };
type EventAttendance = 
 record {
   event_id: text;
   marked_at_ms: nat64;
   marked_by: principal;
   notes: text;
   status: text;
   subject_id: text;
   subject_kind: text;
 };
type Event = 
 record {
   address: opt text;
   cancelled: bool;
   club_id: text;
   creator: principal;
   deleted: bool;
   description: text;
   ends_at_ms: nat64;
   event_type: text;
   id: text;
   location: opt text;
   mini_league_id: opt text;
   opponent: opt text;
   revision: nat64;
   series_id: opt text;
   starts_at_ms: nat64;
   team_id: opt text;
   title: text;
   updated_at_ms: nat64;
 };
type Duty = 
 record {
   account_id: text;
   completed: bool;
   duty: text;
   event_id: text;
 };
type CoachNote = 
 record {
   event_id: text;
   note: text;
   updated_at_ms: nat64;
   updated_by: principal;
 };
type ChildTeamAssignment = 
 record {
   child_id: text;
   club_id: text;
   team_id: text;
 };
type ChildGuardian = 
 record {
   child_id: text;
   guardian_id: text;
   is_primary: bool;
 };
type Child = 
 record {
   id: text;
   parent_id: opt text;
 };
type AttendanceInput = 
 record {
   notes: text;
   status: text;
   subject_id: text;
   subject_kind: text;
 };
type Attendance = 
 record {
   account_id: text;
   event_id: text;
   note: text;
   present: bool;
 };
type AssociationEvent = 
 record {
   association_id: text;
   child_event_ids: vec text;
   created_at_ms: nat64;
   created_by: principal;
   deleted: bool;
   description: text;
   ends_at_ms: nat64;
   id: text;
   location: opt text;
   starts_at_ms: nat64;
   title: text;
 };
type ActiveGame = 
 record {
   board_session_id: text;
   id: text;
   is_active: bool;
   pitch_state_json: text;
   team_id: opt text;
   timer_state_json: text;
   updated_at_ms: nat64;
   user_id: principal;
 };
service : (governorInit: principal) -> Main
