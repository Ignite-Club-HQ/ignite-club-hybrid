type TeamTrainingPause = 
 record {
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   ends_at_ms: nat64;
   id: text;
   reason: text;
   starts_at_ms: nat64;
   team_id: text;
 };
type RsvpWithChild = 
 record {
   child: opt Child;
   rsvp: Rsvp;
 };
type RsvpSubject = 
 variant {
   account: text;
   mini_league_player: text;
 };
type Rsvp = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
   has_paid: opt bool;
   notes: text;
   source: text;
   state: text;
   updated_at_ms: nat64;
 };
type RosterEntry = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
 };
type RoleGrant = 
 record {
   club_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type ReminderLog = 
 record {
   channel: text;
   event_id: text;
   id: text;
   recipient: text;
   sent_at_ms: nat64;
 };
type Recurrence = 
 record {
   event_id: text;
   frequency: text;
   until_ms: nat64;
 };
type PushReachability = 
 record {
   reachable: bool;
   updated_at_ms: nat64;
   user: principal;
 };
type PlayHQMatch = 
 record {
   away_team_name: opt text;
   external_away_team_id: opt text;
   external_home_team_id: opt text;
   home_team_name: opt text;
 };
type PlayHQConfig = 
 record {
   api_key: text;
   base_url: text;
   updated_at_ms: nat64;
 };
type PlayHQCompetition = 
 record {
   id: text;
   name: text;
   season: opt text;
 };
type PitchBoardSettings = 
 record {
   disable_batch_subs: bool;
   disable_position_swaps: bool;
   formation: opt text;
   max_spread_minutes: nat16;
   minutes_per_half: nat16;
   rotate_gk_at_halftime: bool;
   rotation_speed: nat16;
   show_lineup_picker: bool;
   show_match_header: bool;
   team_id: text;
   team_size: nat16;
   updated_at_ms: nat64;
 };
type OpenDuty = 
 record {
   claimed_by: opt text;
   created_at_ms: nat64;
   duty: text;
   event_id: text;
   id: text;
 };
type MiniLeagueRsvp = 
 record {
   event_id: text;
   state: text;
   subject: RsvpSubject;
   updated_at_ms: nat64;
 };
type Main = 
 service {
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_event_guest: (event_id: text, guest_name: text) ->
    (variant {
       Err: text;
       Ok: EventGuest;
     });
   add_group_player: (group_id: text, account_id: text, team_letter:
    opt text) -> (variant {
                    Err: text;
                    Ok: EventGroupPlayer;
                  });
   add_lineup: (event_id: text, member: text, slot: text, team_id:
    opt text) -> (variant {
                    Err: text;
                    Ok: LineupEntry;
                  });
   add_series_occurrence: (series_id: text, starts_at_ms: nat64, ends_at_ms:
    nat64) -> (variant {
                 Err: text;
                 Ok: Event;
               });
   admin_link_guardian: (child_id: text, guardian_id: text, is_primary:
    bool) -> (variant {
                Err: text;
                Ok: ChildGuardian;
              });
   admin_update_rsvp_status: (event_id: text, account_id: text, child_id:
    opt text, status: text) -> (variant {
                                  Err: text;
                                  Ok: Rsvp;
                                });
   admin_upsert_child: (id: text, parent_id: opt text) ->
    (variant {
       Err: text;
       Ok: Child;
     });
   admin_upsert_child_team_assignment: (child_id: text, team_id: text,
    club_id: text) -> (variant {
                         Err: text;
                         Ok: ChildTeamAssignment;
                       });
   admin_upsert_rsvp: (event_id: text, account_id: text, child_id: opt text,
    status: text, notes: text) -> (variant {
                                     Err: text;
                                     Ok: Rsvp;
                                   });
   check_event_membership: (user_id: text, event_id: text) -> (bool) query;
   child_is_in_event_audience: (child_id: text, event_id: text) ->
    (variant {
       Err: text;
       Ok: bool;
     }) query;
   claim_open_duty: (id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok: OpenDuty;
     });
   complete_duty: (event_id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok: Duty;
     });
   create_association_event: (association_id: text, club_ids: vec text,
    title: text, description: text, location: opt text, starts_at_ms: 
    nat64, ends_at_ms: nat64) -> (variant {
                                    Err: text;
                                    Ok: nat16;
                                  });
   create_event: (club_id: text, team_id: opt text, title: text, description:
    text, event_type: text, location: opt text, opponent: opt text, address:
    opt text, mini_league_id: opt text, starts_at_ms: nat64, ends_at_ms:
    nat64) -> (variant {
                 Err: text;
                 Ok: Event;
               });
   create_event_group: (event_id: text, name: text, team_letter: opt text,
    colour: opt text, ability_band: opt text, pitch_name: opt text) ->
    (variant {
       Err: text;
       Ok: EventGroup;
     });
   create_open_duty: (event_id: text, duty: text) ->
    (variant {
       Err: text;
       Ok: OpenDuty;
     });
   create_recurring_series: (club_id: text, team_id: opt text, title: 
    text, description: text, event_type: text, location: opt text, frequency:
    text, first_starts_at_ms: nat64, first_ends_at_ms: nat64, occurrences:
    opt nat32, until_ms: opt nat64) ->
    (variant {
       Err: text;
       Ok: record {
             events: vec Event;
             series: EventSeries;
           };
     });
   create_series: (club_id: text, team_id: opt text, title: text,
    description: text, event_type: text, location: opt text, frequency: 
    text, first_starts_at_ms: nat64, first_ends_at_ms: nat64, until_ms:
    nat64) ->
    (variant {
       Err: text;
       Ok: record {
             events: vec Event;
             series: EventSeries;
           };
     });
   create_team_training_pause: (club_id: text, team_id: text, starts_at_ms:
    nat64, ends_at_ms: nat64, reason: text) ->
    (variant {
       Err: text;
       Ok: TeamTrainingPause;
     });
   deactivate_active_game: (team_id: opt text) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   delete_club_data: (club_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_event: (id: text) -> (variant {
                                  Err: text;
                                  Ok: Event;
                                });
   delete_event_group: (group_id: text) -> (variant {
                                              Err: text;
                                              Ok;
                                            });
   delete_series: (id: text, from_ms: nat64) ->
    (variant {
       Err: text;
       Ok: nat32;
     });
   delete_team_data: (team_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_team_training_pause: (id: text) -> (variant {
                                                Err: text;
                                                Ok;
                                              });
   detach_occurrence: (event_id: text) -> (variant {
                                             Err: text;
                                             Ok: Event;
                                           });
   event_roster: (event_id: text) ->
    (variant {
       Err: text;
       Ok: EventRoster;
     }) query;
   export_state: () ->
    (variant {
       Err: text;
       Ok:
        record {
          attendance: vec Attendance;
          childGuardians: vec ChildGuardian;
          childTeamAssignments: vec ChildTeamAssignment;
          children: vec Child;
          coachNotes: vec CoachNote;
          duties: vec Duty;
          eventAttendance: vec EventAttendance;
          eventGroupDuties: vec EventGroupDuty;
          eventGroupPlayers: vec EventGroupPlayer;
          eventGroups: vec EventGroup;
          eventGuests: vec EventGuest;
          eventViews: vec EventView;
          events: vec Event;
          governor: principal;
          lineupSnapshots: vec LineupSnapshot;
          lineups: vec LineupEntry;
          miniLeagueRsvps: vec MiniLeagueRsvp;
          openDuties: vec OpenDuty;
          pushReachability: vec PushReachability;
          recurrences: vec Recurrence;
          reminderLogs: vec ReminderLog;
          roles: vec RoleGrant;
          roster: vec RosterEntry;
          rsvps: vec Rsvp;
          schema: nat32;
          series: vec EventSeries;
          teamTrainingPauses: vec TeamTrainingPause;
        };
     }) query;
   get_active_game: (team_id: opt text) ->
    (variant {
       Err: text;
       Ok: opt ActiveGame;
     }) query;
   get_attendance: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventAttendance;
     }) query;
   get_coach_note: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt CoachNote;
     }) query;
   get_event_auto_reminder: (event_id: text) ->
    (opt record {
           hours_before: nat16;
           sent: bool;
         }) query;
   get_event_child: (event_id: text, child_id: text) ->
    (variant {
       Err: text;
       Ok: Child;
     }) query;
   get_event_roster: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec RosterEntry;
     }) query;
   get_event_view_count: (event_id: text) ->
    (variant {
       Err: text;
       Ok: nat32;
     }) query;
   get_game_result: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt GameResult;
     }) query;
   get_game_summary: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt GameSummary;
     }) query;
   get_lineup_snapshot: (event_id: text, team_id: opt text) ->
    (variant {
       Err: text;
       Ok: opt LineupSnapshot;
     }) query;
   get_pitch_board_settings: (team_id: text) ->
    (variant {
       Err: text;
       Ok: opt PitchBoardSettings;
     }) query;
   get_push_reachable: ("principal": principal) ->
    (variant {
       Err: text;
       Ok: opt bool;
     }) query;
   get_reminder_log: (event_id: text) ->
    (variant {
       Err: text;
       Ok: record {
             recipients_count: nat32;
             sent_at_ms: opt nat64;
           };
     }) query;
   grant_role: ("principal": principal, role: text, club_id: text, team_id:
    opt text) -> (variant {
                    Err: text;
                    Ok;
                  });
   is_guardian_of: ("principal": principal, child_id: text) -> (bool) query;
   is_paused: (club_id: text, team_id: text, at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: bool;
     }) query;
   is_reachable: (account_id: text) -> (variant {
                                          Err: text;
                                          Ok: bool;
                                        }) query;
   is_team_member: ("principal": principal, club_id: text, team_id: text) ->
    (bool) query;
   listBulkAccessPrincipals: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
   list_association_events: (association_id: text) ->
    (variant {
       Err: text;
       Ok: vec AssociationEvent;
     }) query;
   list_child_team_assignments: (club_id: text, team_id: text) ->
    (variant {
       Err: text;
       Ok: vec ChildTeamAssignment;
     }) query;
   list_duties: (event_id: text) -> (variant {
                                       Err: text;
                                       Ok: vec Duty;
                                     }) query;
   list_event_groups: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventGroup;
     }) query;
   list_event_views: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventView;
     }) query;
   list_events: (club_id: opt text, team_id: opt text) -> (vec Event) query;
   list_game_player_stats: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec GamePlayerStat;
     }) query;
   list_group_duties: (group_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventGroupDuty;
     }) query;
   list_group_players: (group_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventGroupPlayer;
     }) query;
   list_mini_league_rsvps: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec MiniLeagueRsvp;
     }) query;
   list_my_viewed_event_ids: (event_ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec text;
     }) query;
   list_open_duties: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec OpenDuty;
     }) query;
   list_playhq_competitions: (tenant: text, org_id: text) ->
    (variant {
       Err: text;
       Ok: vec PlayHQCompetition;
     });
   list_playhq_fixtures: (competition_id: text) ->
    (variant {
       Err: text;
       Ok: vec PlayHQMatch;
     });
   list_reminders: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec ReminderLog;
     }) query;
   list_series: (club_id: opt text, team_id: opt text) ->
    (vec EventSeries) query;
   list_series_occurrences: (series_id: text) ->
    (variant {
       Err: text;
       Ok:
        vec
         record {
           deleted: bool;
           ends_at_ms: nat64;
           id: text;
           starts_at_ms: nat64;
         };
     }) query;
   list_team_training_pauses: (club_id: text, team_id: text) ->
    (variant {
       Err: text;
       Ok: vec TeamTrainingPause;
     }) query;
   mark_attendance: (event_id: text, records: vec AttendanceInput) ->
    (variant {
       Err: text;
       Ok: vec EventAttendance;
     });
   move_group_player: (from_group_id: text, to_group_id: text, account_id:
    text, team_letter: opt text) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
   my_attendance: (event_id: opt text) -> (vec EventAttendance) query;
   my_child_rsvps: (event_id: opt text, club_id: opt text) ->
    (vec RsvpWithChild) query;
   my_child_team_assignments: (child_id: text) ->
    (variant {
       Err: text;
       Ok: vec ChildTeamAssignment;
     }) query;
   my_children: () -> (vec Child) query;
   my_rsvps: () -> (vec Rsvp) query;
   playhqTransform: (record {
                       context: blob;
                       response: HttpRequestResult;
                     }) -> (HttpRequestResult) query;
   record_event_view: (event_id: text) -> (variant {
                                             Err: text;
                                             Ok;
                                           });
   record_reminder_sent: (event_id: text, channel: text, recipient: text) ->
    (variant {
       Err: text;
       Ok: ReminderLog;
     });
   removeBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_child_team_assignment: (child_id: text, team_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_duty: (event_id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_event_guest: (id: text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
   remove_group_duty: (group_id: text, duty: text) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_group_player: (group_id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   rename_event_group: (group_id: text, name: text) ->
    (variant {
       Err: text;
       Ok: EventGroup;
     });
   replace_event_groups: (event_id: text, groups: vec GroupSpecInput,
    delete_existing: bool) -> (variant {
                                 Err: text;
                                 Ok: vec text;
                               });
   save_game_player_stats: (event_id: text, team_id: text, stats:
    vec GamePlayerStatInput) -> (variant {
                                   Err: text;
                                   Ok: vec GamePlayerStat;
                                 });
   save_game_result: (team_id: text, event_id: opt text, sport: text,
    home_label: text, away_label: text, home_score: nat32, away_score: 
    nat32, period_scores_json: text, player_stats_json: text, mvp_player_id:
    opt text, mvp_player_name: opt text) ->
    (variant {
       Err: text;
       Ok: GameResult;
     });
   save_game_summary: (event_id: text, team_id: text, total_game_time: 
    nat32, half_duration: nat32, formation_used: opt text,
    total_substitutions: nat16) -> (variant {
                                      Err: text;
                                      Ok: GameSummary;
                                    });
   save_lineup_snapshot: (event_id: text, team_id: opt text, formation:
    opt text, team_size: nat16, ball_x: opt float64, ball_y: opt float64,
    players: vec LineupPlayer) -> (variant {
                                     Err: text;
                                     Ok: LineupSnapshot;
                                   });
   save_pitch_board_settings: (team_id: text, rotation_speed: nat16,
    disable_position_swaps: bool, disable_batch_subs: bool,
    rotate_gk_at_halftime: bool, minutes_per_half: nat16, max_spread_minutes:
    nat16, team_size: nat16, formation: opt text, show_match_header: 
    bool, show_lineup_picker: bool) ->
    (variant {
       Err: text;
       Ok: PitchBoardSettings;
     });
   send_event_reminders: (event_id: text) -> (variant {
                                                Err: text;
                                                Ok: nat16;
                                              });
   set_attendance: (event_id: text, account_id: text, present: bool, note:
    text) -> (variant {
                Err: text;
                Ok: Attendance;
              });
