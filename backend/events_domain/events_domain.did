type TeamTrainingPause = 
 record {
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   ends_at_ms: nat64;
   id: text;
   reason: text;
   starts_at_ms: nat64;
   team_id: text;
 };
type RsvpWithChild = 
 record {
   child: opt Child;
   rsvp: Rsvp;
 };
type RsvpSubject = 
 variant {
   account: text;
   mini_league_player: text;
 };
type Rsvp = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
   has_paid: opt bool;
   notes: text;
   source: text;
   state: text;
   updated_at_ms: nat64;
 };
type RosterEntry = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
 };
type RoleGrant = 
 record {
   club_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type ReminderLog = 
 record {
   channel: text;
   event_id: text;
   id: text;
   recipient: text;
   sent_at_ms: nat64;
 };
type Recurrence = 
 record {
   event_id: text;
   frequency: text;
   until_ms: nat64;
 };
type PushReachability = 
 record {
   reachable: bool;
   updated_at_ms: nat64;
   user: principal;
 };
type OpenDuty = 
 record {
   claimed_by: opt text;
   created_at_ms: nat64;
   duty: text;
   event_id: text;
   id: text;
 };
type MiniLeagueRsvp = 
 record {
   event_id: text;
   state: text;
   subject: RsvpSubject;
   updated_at_ms: nat64;
 };
type LineupSnapshot = 
 record {
   ball_x: opt float64;
   ball_y: opt float64;
   event_id: text;
   formation: opt text;
   players: vec LineupPlayer;
   revision: nat64;
   team_id: opt text;
   team_size: nat16;
   updated_at_ms: nat64;
   updated_by: principal;
 };
type LineupPlayer = 
 record {
   bench: bool;
   member: text;
   number: opt nat16;
   slot: text;
   x: opt float64;
   y: opt float64;
 };
type LineupEntry = 
 record {
   event_id: text;
   member: text;
   slot: text;
   team_id: opt text;
 };
type EventView = 
 record {
   event_id: text;
   viewed_at_ms: nat64;
   viewer: principal;
 };
type EventSeries = 
 record {
   club_id: text;
   creator: principal;
   deleted: bool;
   description: text;
   event_type: text;
   first_ends_at_ms: nat64;
   first_starts_at_ms: nat64;
   frequency: text;
   id: text;
   location: opt text;
   revision: nat64;
   team_id: opt text;
   title: text;
   until_ms: nat64;
 };
type EventRoster = 
 record {
   guests: vec EventGuest;
   rsvps: vec RsvpWithChild;
 };
type EventGuest = 
 record {
   added_by: principal;
   created_at_ms: nat64;
   event_id: text;
   guest_name: text;
   id: text;
 };
type EventGroupPlayer = 
 record {
   account_id: text;
   group_id: text;
   team_letter: opt text;
 };
type EventGroupDuty = 
 record {
   account_id: opt text;
   duty: text;
   group_id: text;
 };
type EventGroup = 
 record {
   ability_band: opt text;
   colour: opt text;
   created_at_ms: nat64;
   event_id: text;
   id: text;
   name: text;
   pitch_name: opt text;
   team_letter: opt text;
 };
type EventAttendance = 
 record {
   event_id: text;
   marked_at_ms: nat64;
   marked_by: principal;
   notes: text;
   status: text;
   subject_id: text;
   subject_kind: text;
 };
type Event = 
 record {
   cancelled: bool;
   club_id: text;
   creator: principal;
   deleted: bool;
   description: text;
   ends_at_ms: nat64;
   event_type: text;
   id: text;
   location: opt text;
   revision: nat64;
   series_id: opt text;
   starts_at_ms: nat64;
   team_id: opt text;
   title: text;
 };
type Duty = 
 record {
   account_id: text;
   completed: bool;
   duty: text;
   event_id: text;
 };
type CoachNote = 
 record {
   event_id: text;
   note: text;
   updated_at_ms: nat64;
   updated_by: principal;
 };
type ChildGuardian = 
 record {
   child_id: text;
   guardian_id: text;
   is_primary: bool;
 };
type Child = 
 record {
   id: text;
   name: text;
   parent_id: opt text;
 };
type AttendanceInput = 
 record {
   notes: text;
   status: text;
   subject_id: text;
   subject_kind: text;
 };
type Attendance = 
 record {
   account_id: text;
   event_id: text;
   note: text;
   present: bool;
 };
service : {
  addBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  add_event_guest: (event_id: text, guest_name: text) ->
   (variant {
      Err: text;
      Ok: EventGuest;
    });
  add_group_player: (group_id: text, account_id: text, team_letter:
   opt text) -> (variant {
                   Err: text;
                   Ok: EventGroupPlayer;
                 });
  add_lineup: (event_id: text, member: text, slot: text, team_id:
   opt text) -> (variant {
                   Err: text;
                   Ok: LineupEntry;
                 });
  add_series_occurrence: (series_id: text, starts_at_ms: nat64, ends_at_ms:
   nat64) -> (variant {
                Err: text;
                Ok: Event;
              });
  admin_link_guardian: (child_id: text, guardian_id: text, is_primary:
   bool) -> (variant {
               Err: text;
               Ok: ChildGuardian;
             });
  admin_update_rsvp_status: (event_id: text, account_id: text, child_id:
   opt text, status: text) -> (variant {
                                 Err: text;
                                 Ok: Rsvp;
                               });
  admin_upsert_child: (id: text, name: text, parent_id: opt text) ->
   (variant {
      Err: text;
      Ok: Child;
    });
  admin_upsert_rsvp: (event_id: text, account_id: text, child_id: opt text,
   status: text, notes: text) -> (variant {
                                    Err: text;
                                    Ok: Rsvp;
                                  });
  child_is_in_event_audience: (child_id: text, event_id: text) ->
   (variant {
      Err: text;
      Ok: bool;
    }) query;
  claim_open_duty: (id: text, account_id: text) ->
   (variant {
      Err: text;
      Ok: OpenDuty;
    });
  complete_duty: (event_id: text, account_id: text) ->
   (variant {
      Err: text;
      Ok: Duty;
    });
  create_event: (club_id: text, team_id: opt text, title: text, description:
   text, event_type: text, location: opt text, starts_at_ms: nat64,
   ends_at_ms: nat64) -> (variant {
                            Err: text;
                            Ok: Event;
                          });
  create_event_group: (event_id: text, name: text, team_letter: opt text,
   colour: opt text, ability_band: opt text, pitch_name: opt text) ->
   (variant {
      Err: text;
      Ok: EventGroup;
    });
  create_open_duty: (event_id: text, duty: text) ->
   (variant {
      Err: text;
      Ok: OpenDuty;
    });
  create_recurring_series: (club_id: text, team_id: opt text, title: 
   text, description: text, event_type: text, location: opt text, frequency:
   text, first_starts_at_ms: nat64, first_ends_at_ms: nat64, occurrences:
   opt nat32, until_ms: opt nat64) ->
   (variant {
      Err: text;
      Ok: record {
            events: vec Event;
            series: EventSeries;
          };
    });
  create_series: (club_id: text, team_id: opt text, title: text, description:
   text, event_type: text, location: opt text, frequency: text,
   first_starts_at_ms: nat64, first_ends_at_ms: nat64, until_ms: nat64) ->
   (variant {
      Err: text;
      Ok: record {
            events: vec Event;
            series: EventSeries;
          };
    });
  create_team_training_pause: (club_id: text, team_id: text, starts_at_ms:
   nat64, ends_at_ms: nat64, reason: text) ->
   (variant {
      Err: text;
      Ok: TeamTrainingPause;
    });
  delete_event: (id: text) -> (variant {
                                 Err: text;
                                 Ok: Event;
                               });
  delete_event_group: (group_id: text) -> (variant {
                                             Err: text;
                                             Ok;
                                           });
  delete_series: (id: text, from_ms: nat64) ->
   (variant {
      Err: text;
      Ok: nat32;
    });
  delete_team_training_pause: (id: text) -> (variant {
                                               Err: text;
                                               Ok;
                                             });
  detach_occurrence: (event_id: text) -> (variant {
                                            Err: text;
                                            Ok: Event;
                                          });
  event_roster: (event_id: text) ->
   (variant {
      Err: text;
      Ok: EventRoster;
    }) query;
  export_state: () ->
   (variant {
      Err: text;
      Ok:
       record {
         attendance: vec Attendance;
         childGuardians: vec ChildGuardian;
         children: vec Child;
         coachNotes: vec CoachNote;
         duties: vec Duty;
         eventAttendance: vec EventAttendance;
         eventGroupDuties: vec EventGroupDuty;
         eventGroupPlayers: vec EventGroupPlayer;
         eventGroups: vec EventGroup;
         eventGuests: vec EventGuest;
         eventViews: vec EventView;
         events: vec Event;
         governor: principal;
         lineupSnapshots: vec LineupSnapshot;
         lineups: vec LineupEntry;
         miniLeagueRsvps: vec MiniLeagueRsvp;
         openDuties: vec OpenDuty;
         pushReachability: vec PushReachability;
         recurrences: vec Recurrence;
         reminderLogs: vec ReminderLog;
         roles: vec RoleGrant;
         roster: vec RosterEntry;
         rsvps: vec Rsvp;
         schema: nat32;
         series: vec EventSeries;
         teamTrainingPauses: vec TeamTrainingPause;
       };
    }) query;
  get_attendance: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec EventAttendance;
    }) query;
  get_coach_note: (event_id: text) ->
   (variant {
      Err: text;
      Ok: opt CoachNote;
    }) query;
  get_event_roster: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec RosterEntry;
    }) query;
  get_event_view_count: (event_id: text) ->
   (variant {
      Err: text;
      Ok: nat32;
    }) query;
  get_lineup_snapshot: (event_id: text, team_id: opt text) ->
   (variant {
      Err: text;
      Ok: opt LineupSnapshot;
    }) query;
  get_push_reachable: ("principal": principal) ->
   (variant {
      Err: text;
      Ok: opt bool;
    }) query;
  get_reminder_log: (event_id: text) ->
   (variant {
      Err: text;
      Ok: record {
            recipients_count: nat32;
            sent_at_ms: opt nat64;
          };
    }) query;
  grant_role: ("principal": principal, role: text, club_id: text, team_id:
   opt text) -> (variant {
                   Err: text;
                   Ok;
                 });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  is_guardian_of: ("principal": principal, child_id: text) -> (bool) query;
  is_paused: (club_id: text, team_id: text, at_ms: nat64) ->
   (variant {
      Err: text;
      Ok: bool;
    }) query;
  is_reachable: (account_id: text) -> (variant {
                                         Err: text;
                                         Ok: bool;
                                       }) query;
  is_team_member: ("principal": principal, club_id: text, team_id: text) ->
   (bool) query;
  listBulkAccessPrincipals: () ->
   (variant {
      Err: text;
      Ok: vec principal;
    }) query;
  list_event_groups: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec EventGroup;
    }) query;
  list_events: (club_id: opt text, team_id: opt text) -> (vec Event) query;
  list_group_duties: (group_id: text) ->
   (variant {
      Err: text;
      Ok: vec EventGroupDuty;
    }) query;
  list_group_players: (group_id: text) ->
   (variant {
      Err: text;
      Ok: vec EventGroupPlayer;
    }) query;
  list_mini_league_rsvps: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueRsvp;
    }) query;
  list_open_duties: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec OpenDuty;
    }) query;
  list_reminders: (event_id: text) ->
   (variant {
      Err: text;
      Ok: vec ReminderLog;
    }) query;
  list_series: (club_id: opt text, team_id: opt text) ->
   (vec EventSeries) query;
  list_series_occurrences: (series_id: text) ->
   (variant {
      Err: text;
      Ok:
       vec
        record {
          deleted: bool;
          ends_at_ms: nat64;
          id: text;
          starts_at_ms: nat64;
        };
    }) query;
  list_team_training_pauses: (club_id: text, team_id: text) ->
   (variant {
      Err: text;
      Ok: vec TeamTrainingPause;
    }) query;
  mark_attendance: (event_id: text, records: vec AttendanceInput) ->
   (variant {
      Err: text;
      Ok: vec EventAttendance;
    });
  move_group_player: (from_group_id: text, to_group_id: text, account_id:
   text) -> (variant {
               Err: text;
               Ok;
             });
  my_attendance: (event_id: opt text) -> (vec EventAttendance) query;
  my_child_rsvps: (event_id: opt text, club_id: opt text) ->
   (vec RsvpWithChild) query;
  my_rsvps: () -> (vec Rsvp) query;
  record_event_view: (event_id: text) -> (variant {
                                            Err: text;
                                            Ok;
                                          });
  record_reminder_sent: (event_id: text, channel: text, recipient: text) ->
   (variant {
      Err: text;
      Ok: ReminderLog;
    });
  removeBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_duty: (event_id: text, account_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_event_guest: (id: text) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
  remove_group_duty: (group_id: text, duty: text) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_group_player: (group_id: text, account_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  rename_event_group: (group_id: text, name: text) ->
   (variant {
      Err: text;
      Ok: EventGroup;
    });
  save_lineup_snapshot: (event_id: text, team_id: opt text, formation:
   opt text, team_size: nat16, ball_x: opt float64, ball_y: opt float64,
   players: vec LineupPlayer) -> (variant {
                                    Err: text;
                                    Ok: LineupSnapshot;
                                  });
  set_attendance: (event_id: text, account_id: text, present: bool, note:
   text) -> (variant {
               Err: text;
               Ok: Attendance;
             });
  set_coach_note: (event_id: text, note: text) ->
   (variant {
      Err: text;
      Ok: CoachNote;
    });
  set_duty: (event_id: text, account_id: text, duty: text) ->
   (variant {
      Err: text;
      Ok: Duty;
    });
  set_event_cancelled: (id: text, cancelled: bool) ->
   (variant {
      Err: text;
      Ok: Event;
    });
  set_event_group_appearance: (group_id: text, team_letter: opt text, colour:
   opt text, ability_band: opt text, pitch_name: opt text) ->
   (variant {
      Err: text;
      Ok: EventGroup;
    });
  set_group_duty: (group_id: text, duty: text, account_id: opt text) ->
   (variant {
      Err: text;
      Ok: EventGroupDuty;
    });
  set_mini_league_rsvp: (event_id: text, subject: RsvpSubject, state:
   text) -> (variant {
               Err: text;
               Ok: MiniLeagueRsvp;
             });
  set_push_reachable: (reachable: bool) ->
   (variant {
      Err: text;
      Ok: PushReachability;
    });
  set_recurrence: (event_id: text, frequency: text, until_ms: nat64) ->
   (variant {
      Err: text;
      Ok: Recurrence;
    });
  set_roster: (event_id: text, account_id: text, child_id: opt text) ->
   (variant {
      Err: text;
      Ok: RosterEntry;
    });
  set_rsvp: (event_id: text, account_id: text, state: text) ->
   (variant {
      Err: text;
      Ok: Rsvp;
    });
  soft_delete_series: (id: text) -> (variant {
                                       Err: text;
                                       Ok: EventSeries;
                                     });
  swap_group_players: (group_a: text, account_a: text, group_b: text,
   account_b: text) -> (variant {
                          Err: text;
                          Ok;
                        });
  transfer_governorship: (new_governor: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  unclaim_open_duty: (id: text) -> (variant {
                                      Err: text;
                                      Ok: OpenDuty;
                                    });
  uncomplete_duty: (event_id: text, account_id: text) ->
   (variant {
      Err: text;
      Ok: Duty;
    });
  update_event: (id: text, title: text, description: text, event_type: 
   text, location: opt text, starts_at_ms: nat64, ends_at_ms: nat64) ->
   (variant {
      Err: text;
      Ok: Event;
    });
  update_series: (id: text, title: text, description: text, event_type: 
   text, location: opt text, from_ms: nat64) ->
   (variant {
      Err: text;
      Ok: EventSeries;
    });
}
