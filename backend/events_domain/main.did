type LineupSnapshot = 
 record {
   ball_x: opt float64;
   ball_y: opt float64;
   event_id: text;
   formation: opt text;
   players: vec LineupPlayer;
   revision: nat64;
   team_id: opt text;
   team_size: nat16;
   updated_at_ms: nat64;
   updated_by: principal;
 };
type LineupPlayer = 
 record {
   bench: bool;
   member: text;
   number: opt nat16;
   slot: text;
   x: opt float64;
   y: opt float64;
 };
type LineupEntry = 
 record {
   event_id: text;
   member: text;
   slot: text;
   team_id: opt text;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GroupSpecInput = 
 record {
   ability_band: opt text;
   display_order: nat16;
   duties: vec GroupDutyInput;
   name: text;
   pitch_name: opt text;
   players: vec GroupPlayerInput;
   team_a_colour: opt text;
   team_b_colour: opt text;
 };
type GroupPlayerInput = 
 record {
   account_id: text;
   team_letter: opt text;
 };
type GroupDutyInput = 
 record {
   account_id: opt text;
   duty: text;
 };
type GameSummary = 
 record {
   event_id: text;
   formation_used: opt text;
   half_duration: nat32;
   team_id: text;
   total_game_time: nat32;
   total_substitutions: nat16;
   updated_at_ms: nat64;
 };
type GameResult = 
 record {
   away_label: text;
   away_score: nat32;
   event_id: opt text;
   home_label: text;
   home_score: nat32;
   id: text;
   mvp_player_id: opt text;
   mvp_player_name: opt text;
   period_scores_json: text;
   player_stats_json: text;
   saved_by: principal;
   sport: text;
   team_id: text;
   updated_at_ms: nat64;
 };
type GamePlayerStatInput = 
 record {
   fill_in_player_name: opt text;
   goals_scored: nat16;
   jersey_number: opt nat16;
   minutes_played: nat32;
   positions_played: vec text;
   started_on_pitch: bool;
   substitutions_count: nat16;
   user_id: opt text;
 };
type GamePlayerStat = 
 record {
   event_id: text;
   fill_in_player_name: opt text;
   goals_scored: nat16;
   jersey_number: opt nat16;
   minutes_played: nat32;
   positions_played: vec text;
   started_on_pitch: bool;
   substitutions_count: nat16;
   team_id: text;
   user_id: opt text;
 };
type EventView = 
 record {
   event_id: text;
   viewed_at_ms: nat64;
   viewer: principal;
 };
type EventTimer = 
 record {
   accumulated_pause_ms: nat64;
   current_half: nat8;
   event_id: text;
   half_ended_at_ms: opt nat64;
   half_paused_at_ms: opt nat64;
   half_started_at_ms: opt nat64;
   is_game_finished: bool;
   is_running: bool;
   last_event_at_ms: nat64;
   minutes_per_half: nat16;
   schema_version: nat8;
   updated_by: principal;
 };
type EventSeries = 
 record {
   adults_only: bool;
   club_id: text;
   creator: principal;
   deleted: bool;
   description: text;
   event_type: text;
   first_ends_at_ms: nat64;
   first_starts_at_ms: nat64;
   frequency: text;
   id: text;
   location: opt text;
   restricted_to_roles: opt vec text;
   revision: nat64;
   rsvp_audience: opt text;
   target_team_ids: opt vec text;
   team_id: opt text;
   title: text;
   until_ms: nat64;
 };
type EventRoster = 
 record {
   guests: vec EventGuest;
   rsvps: vec RsvpWithChild;
 };
type EventGuest = 
 record {
   added_by: principal;
   created_at_ms: nat64;
   event_id: text;
   guest_name: text;
   id: text;
 };
type EventGroupPlayer = 
 record {
   account_id: text;
   group_id: text;
   team_letter: opt text;
 };
type EventGroupDuty = 
 record {
   account_id: opt text;
   duty: text;
