type Value = 
 variant {
   "bool": bool;
   "int": int;
   "null";
   "text": text;
 };
type TeamTrainingPause = 
 record {
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   ends_at_ms: nat64;
   id: text;
   reason: text;
   starts_at_ms: nat64;
   team_id: text;
 };
type SavedLocation = 
 record {
   account_id: text;
   address: text;
   created_at_ms: nat64;
   id: text;
   lat: float64;
   lng: float64;
   location_label: text;
 };
type RsvpWithChild = 
 record {
   child: opt Child;
   rsvp: Rsvp;
 };
type RsvpSubject = 
 variant {
   account: text;
   mini_league_player: text;
 };
type Rsvp = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
   has_paid: opt bool;
   notes: text;
   source: text;
   state: text;
   updated_at_ms: nat64;
 };
type Row = vec Cell;
type RosterEntry = 
 record {
   account_id: text;
   child_id: opt text;
   event_id: text;
 };
type RoleGrant = 
 record {
   club_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec Row;
 };
type ReminderLog = 
 record {
   channel: text;
   event_id: text;
   id: text;
   recipient: text;
   sent_at_ms: nat64;
 };
type Recurrence = 
 record {
   event_id: text;
   frequency: text;
   until_ms: nat64;
 };
type Read = 
 record {
   away_label: text;
   away_score: opt nat32;
   event_id: opt text;
   home_label: text;
   home_score: opt nat32;
   id: text;
   mvp_player_id: opt text;
   mvp_player_name: opt text;
   period_scores_json: text;
   player_stats_json: text;
   saved_by: principal;
   scores_hidden: bool;
   sport: text;
   team_id: text;
   updated_at_ms: nat64;
 };
type PushReachability = 
 record {
   reachable: bool;
   updated_at_ms: nat64;
   user: principal;
 };
type PlayerStatRow = 
 record {
   captain_count: nat32;
   goalkeeper_count: nat32;
   mvp_count: nat32;
   ref_id: text;
   ref_kind: text;
   vice_count: nat32;
 };
type PlayHQTeamSync = 
 record {
   auto: bool;
   club_id: text;
   competition_id: text;
   last_error: opt text;
   last_synced_at_ms: opt nat64;
   playhq_team_id: text;
   team_id: text;
   updated_by: principal;
 };
type PlayHQMatch = 
 record {
   away_team_name: opt text;
   external_away_team_id: opt text;
   external_home_team_id: opt text;
   home_team_name: opt text;
 };
type PlayHQImportResult = 
 record {
   cancelled: nat32;
   created: nat32;
   updated: nat32;
 };
type PlayHQConfig = 
 record {
   api_key: text;
   base_url: text;
   updated_at_ms: nat64;
 };
type PlayHQCompetition = 
 record {
   id: text;
   name: text;
   season: opt text;
 };
type PitchBoardSettings = 
 record {
   disable_batch_subs: bool;
   disable_position_swaps: bool;
   formation: opt text;
   max_spread_minutes: nat16;
   minutes_per_half: nat16;
   rotate_gk_at_halftime: bool;
   rotation_speed: nat16;
   show_lineup_picker: bool;
   show_match_header: bool;
   team_id: text;
   team_size: nat16;
   updated_at_ms: nat64;
 };
type OpenDuty = 
 record {
   claimed_by: opt text;
   created_at_ms: nat64;
   duty: text;
   event_id: text;
   id: text;
 };
type MiniLeagueRsvp = 
 record {
   event_id: text;
   state: text;
   subject: RsvpSubject;
   updated_at_ms: nat64;
 };
type MatchGoalkeeperAssignment = 
 record {
   assigned_by: principal;
   event_id: text;
   period: text;
   ref_id: text;
   ref_kind: text;
   updated_at_ms: nat64;
 };
type MatchEventInput = 
 record {
   competition_id: text;
   creator: principal;
   ends_at_ms: nat64;
   match_id: text;
   starts_at_ms: nat64;
   teams: vec CompetitionEventTarget;
   title: text;
   venue: opt text;
 };
type MatchCaptainAssignment = 
 record {
   assigned_by: principal;
   event_id: text;
   ref_id: text;
   ref_kind: text;
   role: text;
   updated_at_ms: nat64;
 };
type Main = 
 service {
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_event_guest: (event_id: text, guest_name: text) ->
    (variant {
       Err: text;
       Ok: EventGuest;
     });
   add_favourite_event_title: (title: text) -> (variant {
                                                  Err: text;
                                                  Ok;
                                                });
   add_group_player: (group_id: text, account_id: text, team_letter:
    opt text) -> (variant {
                    Err: text;
                    Ok: EventGroupPlayer;
                  });
   add_lineup: (event_id: text, member: text, slot: text, team_id:
    opt text) -> (variant {
                    Err: text;
                    Ok: LineupEntry;
                  });
   add_series_occurrence: (series_id: text, starts_at_ms: nat64, ends_at_ms:
    nat64) -> (variant {
                 Err: text;
                 Ok: Event;
               });
   admin_link_guardian: (child_id: text, guardian_id: text, is_primary:
    bool) -> (variant {
                Err: text;
                Ok: ChildGuardian;
              });
   admin_update_rsvp_status: (event_id: text, account_id: text, child_id:
    opt text, status: text) -> (variant {
                                  Err: text;
                                  Ok: Rsvp;
                                });
   admin_upsert_child: (id: text, parent_id: opt text) ->
    (variant {
       Err: text;
       Ok: Child;
     });
   admin_upsert_child_team_assignment: (child_id: text, team_id: text,
    club_id: text) -> (variant {
                         Err: text;
                         Ok: ChildTeamAssignment;
                       });
   admin_upsert_rsvp: (event_id: text, account_id: text, child_id: opt text,
    status: text, notes: text) -> (variant {
                                     Err: text;
                                     Ok: Rsvp;
                                   });
   check_event_membership: (user_id: text, event_id: text) -> (bool) query;
   child_is_in_event_audience: (child_id: text, event_id: text) ->
    (variant {
       Err: text;
       Ok: bool;
     }) query;
   claim_open_duty: (id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok: OpenDuty;
     });
   complete_duty: (event_id: text, account_id: text) ->
    (variant {
       Err: text;
       Ok: Duty;
     });
   create_association_event: (association_id: text, club_ids: vec text,
    title: text, description: text, location: opt text, starts_at_ms: 
    nat64, ends_at_ms: nat64) -> (variant {
                                    Err: text;
                                    Ok: nat16;
                                  });
   create_competition_events: (operation_id: text, competition_id: text,
    creator: principal, competition_club_id: text, targets:
    vec CompetitionEventTarget, title: text, description: text, event_type:
    text, location: opt text, starts_at_ms: nat64, ends_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: vec text;
     });
   create_event: (club_id: text, team_id: opt text, title: text, description:
    text, event_type: text, location: opt text, opponent: opt text, address:
    opt text, mini_league_id: opt text, starts_at_ms: nat64, ends_at_ms:
    nat64, rsvp_audience: opt text, adults_only: bool, restricted_to_roles:
    opt vec text, target_team_ids: opt vec text) ->
    (variant {
       Err: text;
       Ok: Event;
     });
   create_event_group: (event_id: text, name: text, team_letter: opt text,
    colour: opt text, ability_band: opt text, pitch_name: opt text) ->
    (variant {
       Err: text;
       Ok: EventGroup;
     });
   create_open_duty: (event_id: text, duty: text) ->
    (variant {
       Err: text;
       Ok: OpenDuty;
     });
   create_recurring_series: (club_id: text, team_id: opt text, title: 
    text, description: text, event_type: text, location: opt text, frequency:
    text, first_starts_at_ms: nat64, first_ends_at_ms: nat64, occurrences:
    opt nat32, until_ms: opt nat64, rsvp_audience: opt text, adults_only:
    bool, restricted_to_roles: opt vec text, target_team_ids:
    opt vec text) ->
    (variant {
       Err: text;
       Ok: record {
             events: vec Event;
             series: EventSeries;
           };
     });
   create_series: (club_id: text, team_id: opt text, title: text,
    description: text, event_type: text, location: opt text, frequency: 
    text, first_starts_at_ms: nat64, first_ends_at_ms: nat64, until_ms:
    nat64, rsvp_audience: opt text, adults_only: bool, restricted_to_roles:
    opt vec text, target_team_ids: opt vec text) ->
    (variant {
       Err: text;
       Ok: record {
             events: vec Event;
             series: EventSeries;
           };
     });
   create_team_training_pause: (club_id: text, team_id: text, starts_at_ms:
    nat64, ends_at_ms: nat64, reason: text) ->
    (variant {
       Err: text;
       Ok: TeamTrainingPause;
     });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   deactivate_active_game: (team_id: opt text) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   delete_club_data: (club_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_event: (id: text) -> (variant {
                                  Err: text;
                                  Ok: Event;
                                });
   delete_event_group: (group_id: text) -> (variant {
                                              Err: text;
                                              Ok;
                                            });
   delete_game_result: (event_id: text) -> (variant {
                                              Err: text;
                                              Ok;
                                            });
   delete_saved_location: (id: text) -> (variant {
                                           Err: text;
                                           Ok;
                                         });
   delete_series: (id: text, from_ms: nat64) ->
    (variant {
       Err: text;
       Ok: nat32;
     });
   delete_team_data: (team_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_team_training_pause: (id: text) -> (variant {
                                                Err: text;
                                                Ok;
                                              });
   detach_occurrence: (event_id: text) -> (variant {
                                             Err: text;
                                             Ok: Event;
                                           });
   event_roster: (event_id: text) ->
    (variant {
       Err: text;
       Ok: EventRoster;
     }) query;
   execute: (input: text) -> (Result) query;
   export_club_snapshot: (club: text) ->
    (variant {
       Err: text;
       Ok: blob;
     }) query;
   export_state: () ->
    (variant {
       Err: text;
       Ok:
        record {
          attendance: vec Attendance;
          childGuardians: vec ChildGuardian;
          childTeamAssignments: vec ChildTeamAssignment;
          children: vec Child;
          coachNotes: vec CoachNote;
          competitionEventOperations: vec CompetitionEventOperation;
          duties: vec Duty;
          dutyTeamReminderSent: vec text;
          eventAttendance: vec EventAttendance;
          eventDutyTeams: vec EventDutyTeam;
          eventGroupDuties: vec EventGroupDuty;
          eventGroupPlayers: vec EventGroupPlayer;
          eventGroups: vec EventGroup;
          eventGuests: vec EventGuest;
          eventViews: vec EventView;
          events: vec Event;
          governor: principal;
          individualDutyReminderSent: vec text;
          lineupSnapshots: vec LineupSnapshot;
          lineups: vec LineupEntry;
          miniLeagueRsvps: vec MiniLeagueRsvp;
          openDuties: vec OpenDuty;
          pointsReminderSent: vec text;
          pushReachability: vec PushReachability;
          recurrences: vec Recurrence;
          reminderLogs: vec ReminderLog;
          roles: vec RoleGrant;
          roster: vec RosterEntry;
          rsvps: vec Rsvp;
          schema: nat32;
          series: vec EventSeries;
          teamTrainingPauses: vec TeamTrainingPause;
        };
     }) query;
   fetch_playhq_grade: (tenant: text, grade: text) ->
    (variant {
       Err: text;
       Ok:
        record {
          games:
           vec
            record {
              away_id: text;
              away_name: text;
              away_score: opt nat16;
              game_id: text;
              home_id: text;
              home_name: text;
              home_score: opt nat16;
              starts_at_ms: opt nat64;
              status: text;
              venue: opt text;
            };
          stats:
           vec
            record {
              game_id: text;
              player_id: text;
              player_name: text;
              stats_json: text;
              team_id: text;
            };
        };
     });
   getApiDoc: () -> (text) query;
   get_active_game: (team_id: opt text) ->
    (variant {
       Err: text;
       Ok: opt ActiveGame;
     }) query;
   get_attendance: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec EventAttendance;
     }) query;
   get_coach_note: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt CoachNote;
     }) query;
   get_event_auto_reminder: (event_id: text) ->
    (opt record {
           hours_before: nat16;
           sent: bool;
         }) query;
   get_event_child: (event_id: text, child_id: text) ->
    (variant {
       Err: text;
       Ok: Child;
     }) query;
   get_event_duty_team: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt EventDutyTeam;
     }) query;
   get_event_group: (group_id: text) ->
    (variant {
       Err: text;
       Ok: opt EventGroup;
     }) composite_query;
   get_event_roster: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec RosterEntry;
     }) query;
   get_event_rosters: (event_ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec RosterEntry;
     }) query;
   get_event_sponsors: (event_id: text) ->
    (variant {
       Err: text;
       Ok: vec text;
     }) query;
   get_event_timer: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt EventTimer;
     }) query;
   get_event_view_count: (event_id: text) ->
    (variant {
       Err: text;
       Ok: nat32;
     }) query;
   get_game_result: (event_id: text) -> (variant {
                                           Err: text;
                                           Ok: opt Read;
                                         });
   get_game_summary: (event_id: text) ->
    (variant {
       Err: text;
       Ok: opt GameSummary;
     }) query;
   get_group_edit_access: (group_id: text) ->
    (variant {
       Err: text;
       Ok: bool;
     }) composite_query;
   get_lineup_snapshot: (event_id: text, team_id: opt text) ->
    (variant {
       Err: text;
       Ok: opt LineupSnapshot;
     }) query;
   get_pitch_board_settings: (team_id: text) ->
    (variant {
       Err: text;
       Ok: opt PitchBoardSettings;
     }) query;
   get_player_stats_report: (club_id: text, team_id: opt text, from_ms:
    nat64, to_ms: nat64) ->
    (variant {
       Err: text;
       Ok: vec PlayerStatRow;
     }) query;
   get_playhq_config_status: () ->
    (variant {
       Err: text;
       Ok:
        record {
          base_url: opt text;
          configured: bool;
          updated_at_ms: opt nat64;
        };
     }) query;
   get_playhq_team_sync: (team_id: text) ->
    (variant {
       Err: text;
       Ok: opt PlayHQTeamSync;
     }) query;
   get_push_reachable: ("principal": principal) ->
    (variant {
       Err: text;
       Ok: opt bool;
     }) query;
   get_reminder_log: (event_id: text) ->
    (variant {
       Err: text;
       Ok: record {
             recipients_count: nat32;
             sent_at_ms: opt nat64;
           };
     }) query;
   get_rsvp_created_at: (event_id: text, account_id: text) ->
    (opt nat64) query;
   get_training_default: (club_id: text, team_id: text, child_id:
    opt text) -> (variant {
                    Err: text;
                    Ok: opt text;
                  }) query;
   grant_role: ("principal": principal, role: text, club_id: text, team_id:
    opt text) -> (variant {
                    Err: text;
                    Ok;
                  });
   import_club_snapshot: (club: text, snapshot: blob) ->
    (variant {
       Err: text;
       Ok: nat;
     });
   /// Imports the linked team's PlayHQ fixtures as game events now.
   import_playhq_team_fixtures: (club_id: text, team_id: text,
    competition_id: text, playhq_team_id: text) ->
    (variant {
       Err: text;
       Ok: PlayHQImportResult;
     });
   is_guardian_of: ("principal": principal, child_id: text) -> (bool) query;
   is_paused: (club_id: text, team_id: text, at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: bool;
     }) query;
   is_reachable: (account_id: text) -> (variant {
                                          Err: text;
                                          Ok: bool;
                                        }) query;
   is_team_member: ("principal": principal, club_id: text, team_id: text) ->
    (bool) query;
   listBulkAccessPrincipals: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
