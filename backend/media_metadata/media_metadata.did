type BlobRef = record {
  canister : text;
  path : text;
  content_hash : text;
};
type Asset = record {
  id : text;
  club_id : text;
  owner : principal;
  kind : text;
  mime : text;
  checksum : text;
  storage_path : text;
  blob_ref : opt BlobRef;
  visibility : text;
  content_length : nat64;
  encrypted : bool;
  child_sensitive : bool;
  retention_until_ms : nat64;
  deleted : bool;
  expires_at_ms : nat64;
};
type Capability = record {
  asset_id : text;
  action : text;
  owner : principal;
  allowed : bool;
  purpose : text;
  expires_at_ms : nat64;
};
type Reaction = record {
  asset_id : text;
  user : principal;
  kind : text;
  created_at_ms : nat64;
};
type Comment = record {
  id : text;
  asset_id : text;
  author : principal;
  body : text;
  created_at_ms : nat64;
  deleted : bool;
};
type RoleGrant = record {
  user : principal;
  role : text;
  club_id : opt text;
  team_id : opt text;
};
type Init = record { governor : principal };
type Result = variant { Ok : Asset; Err : text };
type Result_1 = variant { Ok : Capability; Err : text };
type Result_2 = variant { Ok : State; Err : text };
type Result_3 = variant { Ok : Asset; Err : text };
type Result_4 = variant { Ok; Err : text };
type Result_5 = variant { Ok : Reaction; Err : text };
type Result_6 = variant { Ok : Comment; Err : text };
type Result_7 = variant { Ok; Err : text };
type Result_8 = variant { Ok : vec principal; Err : text };
type State = record {
  schema : nat32;
  governor : principal;
  assets : vec Asset;
  capabilities : vec Capability;
  reactions : vec Reaction;
  comments : vec Comment;
  roles : vec RoleGrant;
};
service : {
  initialize : () -> (variant { Ok; Err : text });
  addBulkAccessPrincipal : (principal) -> (Result_7);
  removeBulkAccessPrincipal : (principal) -> (Result_7);
  listBulkAccessPrincipals : () -> (Result_8) query;
  export_state : () -> (Result_2) query;
  get_asset : (text) -> (opt Asset) query;
  issue_capability : (text, text, text, nat64) -> (Result_1);
  delete_asset : (text) -> (Result_3);
  register_asset : (text, text, text, text, text, text, nat64) -> (Result);
  set_blob_ref : (text, opt BlobRef) -> (Result);
  grant_role : (principal, text, opt text, opt text) -> (Result_4);
  list_assets : (text) -> (vec Asset) query;
  add_reaction : (text, text, nat64) -> (Result_5);
  remove_reaction : (text) -> (Result_4);
  list_reactions : (text) -> (vec Reaction) query;
  add_comment : (text, text, nat64) -> (Result_6);
  list_comments : (text) -> (vec Comment) query;
  delete_comment : (text) -> (Result_6);
};
