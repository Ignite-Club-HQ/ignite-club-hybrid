type State = 
 record {
   assets: vec Asset;
   capabilities: vec Capability;
   comments: vec Comment;
   galleryChatCards: vec GalleryChatCard;
   governor: principal;
   reactions: vec Reaction;
   roles: vec RoleGrant;
   schema: nat32;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Reaction = 
 record {
   asset_id: text;
   created_at_ms: nat64;
   kind: text;
   user: principal;
 };
type Main = 
 service {
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_comment: (asset_id: text, body: text, created_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Comment;
     });
   add_reaction: (asset_id: text, kind: text, created_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Reaction;
     });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_asset: (asset_id: text) -> (variant {
                                        Err: text;
                                        Ok: Asset;
                                      });
   delete_comment: (comment_id: text) -> (variant {
                                            Err: text;
                                            Ok: Comment;
                                          });
   delete_gallery_chat_card: (card_id: text) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
   export_state: () -> (variant {
                          Err: text;
                          Ok: State;
                        }) query;
   get_asset: (asset_id: text) -> (opt Asset) query;
   get_gallery_chat_card: (card_id: text) -> (opt GalleryChatCard) query;
   grant_role: ("principal": principal, role: text, club_id: opt text,
    team_id: opt text) -> (variant {
                             Err: text;
                             Ok;
                           });
   issue_capability: (asset_id: text, action: text, purpose: text,
    expires_at_ms: nat64) -> (variant {
                                Err: text;
                                Ok: Capability;
                              });
   listBulkAccessPrincipals: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
   list_assets: (club_id: text) -> (vec Asset) query;
   list_comments: (asset_id: text) -> (vec Comment) query;
   list_gallery_chat_cards: (club_id: text, team_id: text) ->
    (vec GalleryChatCard) query;
   list_reactions: (asset_id: text) -> (vec Reaction) query;
   merge_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   register_asset: (club_id: text, kind: text, mime: text, checksum: 
    text, storage_path: text, visibility: text, expires_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: Asset;
     });
   rekey_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   removeBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_reaction: (asset_id: text) -> (variant {
                                           Err: text;
                                           Ok;
                                         });
   save_gallery_chat_card: (id: opt text, club_id: text, team_id: text,
    event_id: opt text, message_id: text, hero_photo_id: opt text,
    hero_image_url: opt text, photo_count: nat32, photo_ids: vec text,
    is_prompt: bool, push_sent: bool) ->
    (variant {
       Err: text;
       Ok: GalleryChatCard;
     });
   set_asset_scope: (asset_id: text, team_id: opt text, mini_league_id:
    opt text, competition_id: opt text, event_id: opt text, caption:
    opt text, album_id: opt text) -> (variant {
                                        Err: text;
                                        Ok: Asset;
                                      });
   set_blob_ref: (asset_id: text, blob_ref: opt BlobRef) ->
    (variant {
       Err: text;
       Ok: Asset;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
 };
type GalleryChatCard = 
 record {
   club_id: text;
   created_at_ms: nat64;
   event_id: opt text;
   hero_image_url: opt text;
   hero_photo_id: opt text;
   id: text;
   is_prompt: bool;
   message_id: text;
   photo_count: nat32;
   photo_ids: vec text;
   push_sent: bool;
   team_id: text;
   updated_at_ms: nat64;
   uploader_id: principal;
 };
type Comment = 
 record {
   asset_id: text;
   author: principal;
   body: text;
   created_at_ms: nat64;
   deleted: bool;
   id: text;
 };
type Capability = 
 record {
   action: text;
   allowed: bool;
   asset_id: text;
   expires_at_ms: nat64;
   owner: principal;
   purpose: text;
 };
type BlobRef = 
 record {
   canister: text;
   content_hash: text;
   path: text;
 };
type Asset = 
 record {
   album_id: opt text;
   blob_ref: opt BlobRef;
   caption: opt text;
   checksum: text;
   child_sensitive: bool;
   club_id: text;
   competition_id: opt text;
   content_length: nat64;
   created_at_ms: nat64;
   deleted: bool;
   encrypted: bool;
   event_id: opt text;
   expires_at_ms: nat64;
   id: text;
   kind: text;
   mime: text;
   mini_league_id: opt text;
   owner: principal;
   retention_until_ms: nat64;
   storage_path: text;
   team_id: opt text;
   visibility: text;
 };
service : (governorInit: principal) -> Main
