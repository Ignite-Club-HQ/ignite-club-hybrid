type TeamEntry = 
 record {
   club_id: text;
   competition_id: text;
   division_id: opt text;
   status: text;
   team_id: text;
 };
type State = 
 record {
   chatSettings: vec ChatSettings;
   competitionInvites: vec CompetitionInvite;
   competitionJoinLinks: vec CompetitionJoinLink;
   competitions: vec Competition;
   entries: vec TeamEntry;
   eoiSubmissions: vec EoiSubmission;
   governor: principal;
   matches: vec Match;
   roles: vec RoleGrant;
   schema: nat32;
   seasons: vec Season;
   tokens: vec JoinToken;
 };
type Season = 
 record {
   competition_id: text;
   divisions: vec text;
   name: text;
   revision: nat64;
   status: text;
 };
type RoleGrant = 
 record {
   competition_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Match = 
 record {
   arrival_minutes_before: opt nat16;
   away_score: nat16;
   away_team: text;
   competition_id: text;
   division_id: opt text;
   duration_minutes: opt nat16;
   home_score: nat16;
   home_team: text;
   id: text;
   notes: opt text;
   pitch_number: opt text;
   revision: nat64;
   round_number: opt nat16;
   scheduled_at_ms: opt nat64;
   status: text;
   venue: opt text;
 };
type JoinToken = 
 record {
   competition_id: text;
   expires_at_ms: nat64;
   id: text;
   issued_by: principal;
   team_id: text;
   used: bool;
 };
type EoiTeamSuggestion = 
 record {
   age_group: text;
   avg_skill: float64;
   player_count: nat;
   submission_ids: vec text;
 };
type EoiSubmission = 
 record {
   age_group: opt text;
   allocated_at_ms: opt nat64;
   assigned_team_id: opt text;
   child_id: opt text;
   claim_token: text;
   claimed_at_ms: opt nat64;
   club_id: text;
   confirmed_at_ms: opt nat64;
   created_at_ms: nat64;
   extra_notes: opt text;
   game_days: vec text;
   id: text;
   invite_sent_at_ms: opt nat64;
   invite_sent_count: nat16;
   notes: opt text;
   parent_confirmed_at_ms: opt nat64;
   parent_email: text;
   parent_mobile: opt text;
   parent_name: text;
   parent_user_id: opt principal;
   player_dob: opt text;
   player_gender: opt text;
   player_name: text;
   preferred_position: opt text;
   preferred_teammates: opt text;
   registered_at_ms: opt nat64;
   returning_player: bool;
   revision: nat64;
   season_id: text;
   skill_level: opt nat16;
   source: text;
   status: text;
   submitted_at_ms: nat64;
   training_days: vec text;
   updated_at_ms: nat64;
   withdrawn_at_ms: opt nat64;
 };
type EoiStats = 
 record {
   allocated: nat;
   confirmed: nat;
   conversion_rate: float64;
   new_players: nat;
   registered: nat;
   returning_players: nat;
   submitted: nat;
   total: nat;
   views: nat;
   withdrawn: nat;
 };
type CompetitionJoinLink = 
 record {
   competition_id: text;
   created_at_ms: nat64;
   created_by: principal;
   revision: nat64;
   revoked: bool;
   role: text;
   team_id: opt text;
   token: text;
 };
type CompetitionInvite = 
 record {
   competition_id: text;
   created_at_ms: nat64;
   created_by: principal;
   id: text;
   invitee: principal;
   responded_at_ms: opt nat64;
   role: text;
   status: text;
   team_id: opt text;
 };
type CompetitionEngagementSummary = 
 record {
   active_teams: nat;
   broadcasts: nat;
   competition_id: text;
   results_entered: nat;
   total_matches: nat;
 };
type Competition = 
 record {
   club_id: text;
   id: text;
   name: text;
   revision: nat64;
   season: text;
   status: text;
 };
type ChatSettings = 
 record {
   admins_only: bool;
   chat_enabled: bool;
   competition_id: text;
   revision: nat64;
 };
service : {
  accept_competition_invite: (invite_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionInvite;
    });
  addBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  add_competition_role: (competition_id: text, "principal": principal, role:
   text, team_id: opt text) -> (variant {
                                  Err: text;
                                  Ok: RoleGrant;
                                });
  allocate_eoi_to_team: (id: text, team_id: opt text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  assign_division: (competition_id: text, team_id: text, division_id:
   opt text) -> (variant {
                   Err: text;
                   Ok: TeamEntry;
                 });
  assign_eoi_team: (id: text, team_id: opt text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  bulk_resend_eoi_invites: (ids: vec text) ->
   (variant {
      Err: text;
      Ok: record {
            fail: nat;
            ok: nat;
          };
    });
  claim_eoi_by_token: (token: text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  claim_join_token: (token_id: text) -> (variant {
                                           Err: text;
                                           Ok: text;
                                         });
  competition_engagement_summary: (competition_ids: vec text, since_ms: 
   int, until_ms: int) ->
   (variant {
      Err: text;
      Ok: vec CompetitionEngagementSummary;
    }) query;
  confirm_eoi_placement: (submission_id: text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  create_competition: (club_id: text, name: text, season: text) ->
   (variant {
      Err: text;
      Ok: Competition;
    });
  create_competition_invite: (competition_id: text, invitee: principal, role:
   text, team_id: opt text) -> (variant {
                                  Err: text;
                                  Ok: CompetitionInvite;
                                });
  create_competition_join_link: (competition_id: text, role: text, team_id:
   opt text) -> (variant {
                   Err: text;
                   Ok: CompetitionJoinLink;
                 });
  create_season: (competition_id: text, name: text) ->
   (variant {
      Err: text;
      Ok: Season;
    });
  decline_competition_invite: (invite_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionInvite;
    });
  delete_eoi: (id: text) -> (variant {
                               Err: text;
                               Ok;
                             });
  delete_match: (match_id: text) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
  duplicate_season: (competition_id: text, source_name: text, new_name:
   text) -> (variant {
               Err: text;
               Ok: Season;
             });
  export_state: () -> (variant {
                         Err: text;
                         Ok: State;
                       }) query;
  get_chat_settings: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: ChatSettings;
    }) query;
  get_eoi_stats: (club_id: text, season_id: opt text) ->
   (variant {
      Err: text;
      Ok: EoiStats;
    }) query;
  get_my_pending_eois: () ->
   (variant {
      Err: text;
      Ok: vec EoiSubmission;
    }) query;
  grant_role: ("principal": principal, role: text, competition_id: text,
   team_id: opt text) -> (variant {
                            Err: text;
                            Ok;
                          });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  invite_team: (competition_id: text, team_id: text) ->
   (variant {
      Err: text;
      Ok: TeamEntry;
    });
  is_competition_admin: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: bool;
    }) query;
  issue_join_token: (competition_id: text, team_id: text, expires_at_ms:
   nat64) -> (variant {
                Err: text;
                Ok: JoinToken;
              });
  join_competition_by_token: (token: text) ->
   (variant {
      Err: text;
      Ok: RoleGrant;
    });
  listBulkAccessPrincipals: () ->
   (variant {
      Err: text;
      Ok: vec principal;
    }) query;
  list_competition_invites: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec CompetitionInvite;
    }) query;
  list_competition_roles: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec RoleGrant;
    }) query;
  list_competitions: (club_id: text) ->
   (variant {
      Err: text;
      Ok: vec Competition;
    }) query;
  list_competitions_multi: (club_ids: vec text) ->
   (variant {
      Err: text;
      Ok: vec Competition;
    }) query;
  list_entries: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec TeamEntry;
    }) query;
  list_entries_by_team: (team_id: text) ->
   (variant {
      Err: text;
      Ok: vec TeamEntry;
    }) query;
  list_eoi_submissions: (club_id: text, season_id: opt text) ->
   (variant {
      Err: text;
      Ok: vec EoiSubmission;
    }) query;
  list_invites_by_invitee: () ->
   (variant {
      Err: text;
      Ok: vec CompetitionInvite;
    }) query;
  list_matches: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec Match;
    }) query;
  list_seasons: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec Season;
    }) query;
  record_match: (competition_id: text, home_team: text, away_team: text) ->
   (variant {
      Err: text;
      Ok: Match;
    });
  register_team: (competition_id: text, team_id: text, club_id: text) ->
   (variant {
      Err: text;
      Ok: TeamEntry;
    });
  removeBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_competition_role: (competition_id: text, "principal": principal,
   role: text, team_id: opt text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
  resend_eoi_invite: (id: text) -> (variant {
                                      Err: text;
                                      Ok: EoiSubmission;
                                    });
  respond_to_entry_invite: (competition_id: text, team_id: text, accept:
   bool) -> (variant {
               Err: text;
               Ok: TeamEntry;
             });
  revoke_competition_join_link: (competition_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  rotate_competition_join_link: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionJoinLink;
    });
  set_chat_settings: (competition_id: text, chat_enabled: bool, admins_only:
   bool, expected_revision: nat64) -> (variant {
                                         Err: text;
                                         Ok: ChatSettings;
                                       });
  set_match_result: (match_id: text, home_score: nat16, away_score: nat16,
   expected_revision: nat64) -> (variant {
                                   Err: text;
                                   Ok: Match;
                                 });
  set_season_divisions: (competition_id: text, name: text, divisions:
   vec text) -> (variant {
                   Err: text;
                   Ok: Season;
                 });
  set_season_status: (competition_id: text, status: text, expected_revision:
   nat64) -> (variant {
                Err: text;
                Ok: Season;
              });
  suggest_eoi_teams: (season_id: text) ->
   (variant {
      Err: text;
      Ok: vec EoiTeamSuggestion;
    }) query;
  transfer_governorship: (new_governor: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  trim_rounds: (competition_id: text, max_round: nat16) ->
   (variant {
      Err: text;
      Ok: nat;
    });
  update_eoi_status: (id: text, status: text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  update_eoi_submission: (id: text, extra_notes: opt text,
   preferred_teammates: opt text, preferred_position: opt text) ->
   (variant {
      Err: text;
      Ok: EoiSubmission;
    });
  update_match_details: (match_id: text, home_team: text, away_team: 
   text, division_id: opt text, scheduled_at_ms: opt nat64, venue: opt text,
   pitch_number: opt text, round_number: opt nat16, duration_minutes:
   opt nat16, arrival_minutes_before: opt nat16, notes: opt text,
   expected_revision: nat64) -> (variant {
                                   Err: text;
                                   Ok: Match;
                                 });
}
