type TeamEntry = 
 record {
   club_id: text;
   competition_id: text;
   division_id: opt text;
   status: text;
   team_id: text;
 };
type State = 
 record {
   chatSettings: vec ChatSettings;
   competitionInvites: vec CompetitionInvite;
   competitionJoinLinks: vec CompetitionJoinLink;
   competitionOfficialEmailInvites: vec CompetitionOfficialEmailInvite;
   competitionWelcomeSettings:
    vec
     record {
       competition_id: text;
       enabled: bool;
       message: text;
       subject: text;
     };
   competitions: vec Competition;
   entries: vec TeamEntry;
   eoiSubmissions: vec EoiSubmission;
   governor: principal;
   matches: vec Match;
   roles: vec RoleGrant;
   schema: nat32;
   seasons: vec Season;
   tokens: vec JoinToken;
 };
type Settings = 
 record {
   competition_id: text;
   enabled: bool;
   message: text;
   subject: text;
 };
type Setting = 
 record {
   competition_id: text;
   division: opt text;
   hide_scores: bool;
 };
type Season = 
 record {
   competition_id: text;
   divisions: vec text;
   name: text;
   revision: nat64;
   status: text;
 };
type RoleLinkPreview = 
 record {
   competition_id: text;
   name: text;
   role: text;
 };
type RoleLink = 
 record {
   competition_id: text;
   created_at_ms: nat64;
   created_by: principal;
   revoked: bool;
   role: text;
   token: text;
 };
type RoleGrant = 
 record {
   competition_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Result = 
 variant {
   Err: text;
   Ok: Settings;
 };
type Request = 
 record {
   account_id: text;
   generation: nat64;
   inventory_digest: blob;
   subjects: vec principal;
 };
type Receipt = 
 record {
   outstanding: nat;
   receiver: principal;
   request: Request;
 };
type PlayHQStat = 
 record {
   competition_id: text;
   game_id: text;
   match_id: text;
   player_id: text;
   player_name: text;
   stats_json: text;
   team_id: text;
   tenant: text;
 };
type PlayHQMatchMeta = 
 record {
   away_id: text;
   away_name: text;
   competition_id: text;
   game_id: text;
   grade_id: text;
   home_id: text;
   home_name: text;
   match_id: text;
   synced_revision: nat64;
   tenant: text;
 };
type OfficialChat = 
 record {
   competition_id: text;
   conversation_id: text;
   scope: text;
 };
type MatchRead = 
 record {
   arrival_minutes_before: opt nat16;
   away_score: opt nat16;
   away_team: text;
   competition_id: text;
   division_id: opt text;
   duration_minutes: opt nat16;
   home_score: opt nat16;
   home_team: text;
   id: text;
   notes: opt text;
   pitch_number: opt text;
   revision: nat64;
   round_number: opt nat16;
   scheduled_at_ms: opt nat64;
   status: text;
   venue: opt text;
 };
type Match = 
 record {
   arrival_minutes_before: opt nat16;
   away_score: nat16;
   away_team: text;
   competition_id: text;
   division_id: opt text;
   duration_minutes: opt nat16;
   home_score: nat16;
   home_team: text;
   id: text;
   notes: opt text;
   pitch_number: opt text;
   revision: nat64;
   round_number: opt nat16;
   scheduled_at_ms: opt nat64;
   status: text;
   venue: opt text;
 };
type Main = 
 service {
   accept_competition_invite: (invite_id: text) ->
    (variant {
       Err: text;
       Ok: CompetitionInvite;
     });
   accept_competition_official_email_invite: (token: text, email_hash: 
    text, verification_code_hash: text) ->
    (variant {
       Err: text;
       Ok: RoleGrant;
     });
   accept_role_link: (token: text) -> (variant {
                                         Err: text;
                                         Ok: RoleGrant;
                                       });
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_competition_role: (competition_id: text, "principal": principal, role:
    text, team_id: opt text) -> (variant {
                                   Err: text;
                                   Ok: RoleGrant;
                                 });
   allocate_eoi_to_team: (id: text, team_id: opt text) ->
    (variant {
       Err: text;
       Ok: EoiSubmission;
     });
   assign_division: (competition_id: text, team_id: text, division_id:
    opt text) -> (variant {
                    Err: text;
                    Ok: TeamEntry;
                  });
   assign_eoi_team: (id: text, team_id: opt text) ->
    (variant {
       Err: text;
       Ok: EoiSubmission;
     });
   bulk_resend_eoi_invites: (ids: vec text) ->
    (variant {
       Err: text;
       Ok: record {
             fail: nat;
             ok: nat;
           };
     });
   can_invite_players_to_team: (team_id: text) -> (bool) query;
   claim_eoi_by_token: (token: text) ->
    (variant {
       Err: text;
       Ok: EoiSubmission;
     });
   claim_join_token: (token_id: text) -> (variant {
                                            Err: text;
                                            Ok: text;
                                          });
   claim_playhq_player: (competition_id: text, tenant: text, player_id:
    text) -> (variant {
                Err: text;
                Ok;
              });
   competition_engagement_summary: (competition_ids: vec text, since_ms: 
    int, until_ms: int) ->
    (variant {
       Err: text;
       Ok: vec CompetitionEngagementSummary;
     }) query;
   confirm_eoi_placement: (submission_id: text) ->
    (variant {
       Err: text;
       Ok: EoiSubmission;
     });
   create_competition: (club_id: text, name: text, season: text) ->
    (variant {
       Err: text;
       Ok: Competition;
     });
   create_competition_event: (operation_id: text, competition_id: text,
    title: text, description: text, event_type: text, location: opt text,
    starts_at_ms: nat64, ends_at_ms: nat64) ->
    (variant {
       Err: text;
       Ok: nat16;
     });
   create_competition_invite: (competition_id: text, invitee: principal,
    role: text, team_id: opt text) ->
    (variant {
       Err: text;
       Ok: CompetitionInvite;
     });
   create_competition_join_link: (competition_id: text, role: text, team_id:
    opt text) -> (variant {
                    Err: text;
                    Ok: CompetitionJoinLink;
                  });
   create_competition_official_email_invite: (competition_id: text, role:
    text, token: text, email_hash: text, verification_code_hash: text) ->
    (variant {
       Err: text;
       Ok: CompetitionOfficialEmailInvite;
     });
   create_competition_official_link: (competition_id: text, role: text,
    token: text) -> (variant {
                       Err: text;
                       Ok: CompetitionJoinLink;
                     });
   create_personal_competition: (name: text, season: text) ->
