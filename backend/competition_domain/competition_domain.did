    (variant {
       Err: text;
       Ok: RoleLink;
     });
   create_season: (competition_id: text, name: text) ->
    (variant {
       Err: text;
       Ok: Season;
     });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   decline_competition_invite: (invite_id: text) ->
    (variant {
       Err: text;
       Ok: CompetitionInvite;
     });
   delete_eoi: (id: text) -> (variant {
                                Err: text;
                                Ok;
                              });
