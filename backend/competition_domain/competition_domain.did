type TeamEntry = 
 record {
   club_id: text;
   competition_id: text;
   division_id: opt text;
   status: text;
   team_id: text;
 };
type State = 
 record {
   chatSettings: vec ChatSettings;
   competitionInvites: vec CompetitionInvite;
   competitionJoinLinks: vec CompetitionJoinLink;
   competitions: vec Competition;
   entries: vec TeamEntry;
   governor: principal;
   matches: vec Match;
   roles: vec RoleGrant;
   schema: nat32;
   seasons: vec Season;
   tokens: vec JoinToken;
 };
type Season = 
 record {
   competition_id: text;
   divisions: vec text;
   name: text;
   revision: nat64;
   status: text;
 };
type RoleGrant = 
 record {
   competition_id: text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Match = 
 record {
   arrival_minutes_before: opt nat16;
   away_score: nat16;
   away_team: text;
   competition_id: text;
   division_id: opt text;
   duration_minutes: opt nat16;
   home_score: nat16;
   home_team: text;
   id: text;
   notes: opt text;
   pitch_number: opt text;
   revision: nat64;
   round_number: opt nat16;
   scheduled_at_ms: opt nat64;
   status: text;
   venue: opt text;
 };
type JoinToken = 
 record {
   competition_id: text;
   expires_at_ms: nat64;
   id: text;
   issued_by: principal;
   team_id: text;
   used: bool;
 };
type CompetitionJoinLink = 
 record {
   competition_id: text;
   created_at_ms: nat64;
   created_by: principal;
   revision: nat64;
   revoked: bool;
   role: text;
   team_id: opt text;
   token: text;
 };
type CompetitionInvite = 
 record {
   competition_id: text;
   created_at_ms: nat64;
   created_by: principal;
   id: text;
   invitee: principal;
   responded_at_ms: opt nat64;
   role: text;
   status: text;
   team_id: opt text;
 };
type Competition = 
 record {
   club_id: text;
   id: text;
   name: text;
   revision: nat64;
   season: text;
   status: text;
 };
type ChatSettings = 
 record {
   chat_enabled: bool;
   competition_id: text;
   revision: nat64;
 };
service : {
  accept_competition_invite: (invite_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionInvite;
    });
  addBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  add_competition_role: (competition_id: text, "principal": principal, role:
   text, team_id: opt text) -> (variant {
                                  Err: text;
                                  Ok: RoleGrant;
                                });
  assign_division: (competition_id: text, team_id: text, division_id:
   opt text) -> (variant {
                   Err: text;
                   Ok: TeamEntry;
                 });
  claim_join_token: (token_id: text) -> (variant {
                                           Err: text;
                                           Ok: text;
                                         });
  create_competition: (club_id: text, name: text, season: text) ->
   (variant {
      Err: text;
      Ok: Competition;
    });
  create_competition_invite: (competition_id: text, invitee: principal, role:
   text, team_id: opt text) -> (variant {
                                  Err: text;
                                  Ok: CompetitionInvite;
                                });
  create_competition_join_link: (competition_id: text, role: text, team_id:
   opt text) -> (variant {
                   Err: text;
                   Ok: CompetitionJoinLink;
                 });
  create_season: (competition_id: text, name: text) ->
   (variant {
      Err: text;
      Ok: Season;
    });
  decline_competition_invite: (invite_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionInvite;
    });
  delete_match: (match_id: text) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
  duplicate_season: (competition_id: text, source_name: text, new_name:
   text) -> (variant {
               Err: text;
               Ok: Season;
             });
  export_state: () -> (variant {
                         Err: text;
                         Ok: State;
                       }) query;
  get_chat_settings: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: ChatSettings;
    }) query;
  grant_role: ("principal": principal, role: text, competition_id: text,
   team_id: opt text) -> (variant {
                            Err: text;
                            Ok;
                          });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  is_competition_admin: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: bool;
    }) query;
  issue_join_token: (competition_id: text, team_id: text, expires_at_ms:
   nat64) -> (variant {
                Err: text;
                Ok: JoinToken;
              });
  join_competition_by_token: (token: text) ->
   (variant {
      Err: text;
      Ok: RoleGrant;
    });
  listBulkAccessPrincipals: () ->
   (variant {
      Err: text;
      Ok: vec principal;
    }) query;
  list_competition_invites: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec CompetitionInvite;
    }) query;
  list_competition_roles: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec RoleGrant;
    }) query;
  list_competitions: (club_id: text) ->
   (variant {
      Err: text;
      Ok: vec Competition;
    }) query;
  list_competitions_multi: (club_ids: vec text) ->
   (variant {
      Err: text;
      Ok: vec Competition;
    }) query;
  list_entries: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec TeamEntry;
    }) query;
  list_invites_by_invitee: () ->
   (variant {
      Err: text;
      Ok: vec CompetitionInvite;
    }) query;
  list_matches: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec Match;
    }) query;
  list_seasons: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: vec Season;
    }) query;
  record_match: (competition_id: text, home_team: text, away_team: text) ->
   (variant {
      Err: text;
      Ok: Match;
    });
  register_team: (competition_id: text, team_id: text, club_id: text) ->
   (variant {
      Err: text;
      Ok: TeamEntry;
    });
  removeBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_competition_role: (competition_id: text, "principal": principal,
   role: text, team_id: opt text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
  revoke_competition_join_link: (competition_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  rotate_competition_join_link: (competition_id: text) ->
   (variant {
      Err: text;
      Ok: CompetitionJoinLink;
    });
  set_chat_settings: (competition_id: text, chat_enabled: bool,
   expected_revision: nat64) -> (variant {
                                   Err: text;
                                   Ok: ChatSettings;
                                 });
  set_match_result: (match_id: text, home_score: nat16, away_score: nat16,
   expected_revision: nat64) -> (variant {
                                   Err: text;
                                   Ok: Match;
                                 });
  set_season_divisions: (competition_id: text, name: text, divisions:
   vec text) -> (variant {
                   Err: text;
                   Ok: Season;
                 });
  set_season_status: (competition_id: text, status: text, expected_revision:
   nat64) -> (variant {
                Err: text;
                Ok: Season;
              });
  transfer_governorship: (new_governor: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  trim_rounds: (competition_id: text, max_round: nat16) ->
   (variant {
      Err: text;
      Ok: nat;
    });
  update_match_details: (match_id: text, home_team: text, away_team: 
   text, division_id: opt text, scheduled_at_ms: opt nat64, venue: opt text,
   pitch_number: opt text, round_number: opt nat16, duration_minutes:
   opt nat16, arrival_minutes_before: opt nat16, notes: opt text,
   expected_revision: nat64) -> (variant {
                                   Err: text;
                                   Ok: Match;
                                 });
}
