type AssignDomainRequest = record {
  domain : text;
  shard : principal;
  expected_revision : nat64;
  club_id : text;
};
type AssignDomainResult = record { revision : nat64; route : DomainRoute };
type AssignRequest = record {
  shard : principal;
  expected_revision : nat64;
  club_id : text;
};
type AssignResult = record { revision : nat64; route : Route };
type DomainCanister = record { domain : text; canister : principal };
type DomainMigration = record {
  destination : principal;
  domain : text;
  source : principal;
  route_revision : nat64;
  club_id : text;
  migration_revision : nat64;
};
type DomainRoute = record {
  domain : text;
  shard : principal;
  revision : nat64;
  club_id : text;
};
type GroupAssignment = record {
  group_id : text;
  revision : nat64;
  club_id : text;
};
type Init = record { governor : principal };
type MemoryStats = record {
  memory_bytes : nat;
  stable_bytes : nat;
  heap_bytes : nat;
};
type Migration = record {
  destination : principal;
  source : principal;
  route_revision : nat64;
  club_id : text;
  migration_revision : nat64;
};
type Page = record { next : opt text; routes : vec Route; revision : nat64 };
type Result = variant { Ok : nat64; Err : text };
type Result_1 = variant { Ok : AssignResult; Err : text };
type Result_10 = variant { Ok : opt Route; Err : text };
type Result_11 = variant { Ok : vec ShardGroup; Err : text };
type Result_12 = variant { Ok : Page; Err : text };
type Result_2 = variant { Ok : AssignDomainResult; Err : text };
type Result_3 = variant { Ok : GroupAssignment; Err : text };
type Result_4 = variant { Ok : DomainMigration; Err : text };
type Result_5 = variant { Ok : Migration; Err : text };
type Result_6 = variant { Ok : opt DomainMigration; Err : text };
type Result_7 = variant { Ok : opt DomainRoute; Err : text };
type Result_8 = variant { Ok : opt GroupAssignment; Err : text };
type Result_9 = variant { Ok : opt Migration; Err : text };
type Route = record { shard : principal; revision : nat64; club_id : text };
type ShardGroup = record {
  id : text;
  max_clubs : nat32;
  observed_at_ns : nat64;
  accepting : bool;
  heap_budget_bytes : nat64;
  cycles : nat64;
  assigned_clubs : nat32;
  domains : vec DomainCanister;
  target_alias : text;
  min_cycles : nat64;
  heap_bytes : nat64;
};
service : (Init) -> {
  abort_domain_migration : (text, text, nat64) -> (Result);
  abort_migration : (text, nat64) -> (Result);
  assign : (AssignRequest) -> (Result_1);
  assign_domain : (AssignDomainRequest) -> (Result_2);
  assign_new_club_group : (text, text, nat64) -> (Result_3);
  begin_domain_migration : (text, text, principal, nat64) -> (Result_4);
  begin_migration : (text, principal, nat64) -> (Result_5);
  commit_domain_migration : (text, text, nat64) -> (Result_2);
  commit_migration : (text, nat64) -> (Result_1);
  // Public: remaining cycles (shown in admin settings).
  cycles_balance : () -> (nat) query;
  get_domain_migration : (text, text) -> (Result_6) query;
  get_domain_route : (text, text) -> (Result_7) query;
  get_group_assignment : (text) -> (Result_8) query;
  get_migration : (text) -> (Result_9) query;
  get_route : (text) -> (Result_10) query;
  list_groups : () -> (Result_11) query;
  list_routes : (opt text, nat16) -> (Result_12) query;
  // Public: live memory reading for the admin health page.
  memory_stats : () -> (MemoryStats) query;
  record_group_health : (text, nat64, nat64, nat64) -> (Result);
  register_group : (ShardGroup, nat64) -> (Result);
  version : () -> (nat64) query;
}