type WorkloadIdentityFilter = 
 record {
   opt_from_ts: opt nat64;
   opt_principal: opt principal;
   opt_scope: opt text;
   opt_to_ts: opt nat64;
 };
type WorkloadIdentity = 
 record {
   allowed_scopes: vec text;
   last_used: nat64;
   registered_at: nat64;
   status: variant {
             Active;
             Revoked;
             Suspended;
           };
   workload_name: text;
   workload_principal: principal;
 };
type SecretAccessResult = 
 record {
   approved: bool;
   reason: text;
   timestamp: nat64;
 };
type SecretAccessAudit = 
 record {
   approved: bool;
   denial_reason: opt text;
   nonce: text;
   requesting_principal: principal;
   secret_scope: text;
   timestamp: nat64;
   workload_name: text;
 };
type AuditSummary = 
 record {
   approved: nat64;
   denied: nat64;
   total_accesses: nat64;
 };
/// Secret Workload Identity Canister
/// Manages workload identity registration and vault secret access control
/// Enforces least-privilege access to vault secrets by canister principal
service : {
  audit_secret_access: (filter: WorkloadIdentityFilter) ->
   (vec SecretAccessAudit) query;
  get_audit_summary: () -> (AuditSummary) query;
  get_workload: (workload_principal: principal) ->
   (variant {
      Err: text;
      Ok: WorkloadIdentity;
    }) query;
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  list_workloads: () -> (vec WorkloadIdentity) query;
  register_workload: (workload_principal: principal, workload_name: text,
   allowed_scopes: vec text) -> (variant {
                                   Err: text;
                                   Ok: WorkloadIdentity;
                                 });
  revoke_workload: (workload_principal: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  update_workload_scopes: (workload_principal: principal, allowed_scopes:
   vec text) -> (variant {
                   Err: text;
                   Ok: WorkloadIdentity;
                 });
  verify_secret_access: (workload_principal: principal, secret_scope: 
   text, nonce: text) -> (SecretAccessResult);
}
