type Request__1 = 
 record {
   account_id: text;
   generation: nat64;
   inventory_digest: blob;
   subjects: vec principal;
 };
type Request = 
 record {
   generation: nat64;
   inventory_digest: blob;
   operation_id: text;
 };
type Receipt__3 = 
 record {
   completed: bool;
   receiver: principal;
   release_epoch: nat;
   request: Request;
 };
type Receipt__2 = 
 record {
   active: nat;
   closing: bool;
   receiver: principal;
   request: Request;
   sealed: bool;
 };
type Receipt__1 = 
 record {
   club: text;
   id: text;
   original_retained: bool;
   replica_absent: bool;
   subject: principal;
 };
type Receipt = 
 record {
   outstanding: nat;
   receiver: principal;
   request: Request__1;
 };
type PrivateNameScope = 
 record {
   authority: principal;
   kind: text;
   profile_revision: nat64;
   resource: text;
 };
type PiiDeleteResult = 
 record {
   key_destroyed: bool;
   shredded_at: nat64;
 };
type Main = 
 service {
   activate_private_name_preparation: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   add_guardian_relationship: (guardian: principal, child_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   audit_access: (filter: AuditFilter) -> (vec AuditRecord) query;
   club_media_lock_version: () -> (nat) query;
   complete_private_name_release_fence: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt__3;
     });
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_pii: (pii_id: text, field_id: text) ->
    (variant {
       Err: text;
       Ok: PiiDeleteResult;
     });
   emergency_shutdown: () -> (variant {
                                Err: text;
                                Ok;
                              });
   export_club_snapshot: (club: text) ->
    (variant {
       Err: text;
       Ok: blob;
     }) query;
   finish_private_name_preparation: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   freeze_private_name_preparation: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   get_club_media_vetkey: (club_id: text, transport_public_key: blob) ->
    (variant {
       Err: text;
       Ok: blob;
     });
   get_encrypted_pii_batch: (pii_ids: vec text, field_id: text, operation:
    text, purpose: text) -> (variant {
                               Err: text;
                               Ok: vec EncryptedPii;
                             });
   get_encrypted_pii_vetkeys_batch: (pii_ids: vec text, field_id: text,
    transport_public_key: blob) -> (variant {
                                      Err: text;
                                      Ok: vec opt blob;
                                    });
   get_private_profile_club_name_vetkey: (ids: vec text, scope:
    PrivateNameScope, transport: blob) -> (variant {
                                             Err: text;
                                             Ok: blob;
                                           });
   get_private_profile_name_vetkeys_batch: (ids: vec text, scope:
    PrivateNameScope, transport: blob) ->
    (variant {
       Err: text;
       Ok: vec opt blob;
     });
   get_private_profile_names_batch: (ids: vec text, scope:
    PrivateNameScope) -> (variant {
                            Err: text;
                            Ok: vec EncryptedPii;
                          });
   get_shared_audience_vetkey: (kind: text, scope: text,
    transport_public_key: blob) -> (variant {
                                      Err: text;
                                      Ok: blob;
                                    });
   grant_pii_read: (pii_id: text, field_id: text, reader: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   grant_pii_read_club: (pii_id: text, field_id: text, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   grant_pii_read_competition: (pii_id: text, field_id: text, competition_id:
    text) -> (variant {
                Err: text;
                Ok;
              });
   import_club_snapshot: (club: text, snapshot: blob) ->
    (variant {
       Err: text;
       Ok: nat;
     });
   memory_stats: () ->
    (record {
       heap_bytes: nat;
       memory_bytes: nat;
       stable_bytes: nat;
     }) query;
   merge_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   my_guardian_children: () -> (vec text) composite_query;
   open_private_name_writer_window: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   pii_vetkey_verification_key: () -> (blob);
   prepare_account_removal: (request: Request__1) ->
    (variant {
       Err: text;
       Ok;
     });
   prepare_private_name_release_fence: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt__3;
     });
   purge_club_grants: (club_id: text) -> (variant {
                                            Err: text;
                                            Ok: nat32;
                                          });
   purge_club_snapshot: (club: text) -> (variant {
                                           Err: text;
                                           Ok: nat;
                                         });
   purge_private_club_name_lifecycle: (subject: principal, club: text,
    expectedCiphertext: vec nat8) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
   purge_removed_private_club_name: (id: text, club: text, subject:
    principal) -> (variant {
                     Err: text;
                     Ok: Receipt__1;
                   });
   read_account_audit_access: (filter: AuditFilter) -> (vec AuditRecord);
   read_account_my_guardian_children: () -> (vec text);
   read_account_removal_drain: (request: Request__1) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   read_club_media_authority: (club: text) ->
    (variant {
       Err: text;
       Ok: ClubMediaAuthority;
     });
   read_group_opening_configuration: () -> (vec record {
                                                  text;
                                                  text;
                                                });
   read_private_club_name_lifecycle: (subject: principal, club: text,
    expectedOriginal: opt vec nat8) ->
    (variant {
       Err: text;
       Ok: opt EncryptedPii;
     });
   read_private_club_name_preparation: (subject: principal, club: text) ->
    (variant {
       Err: text;
       Ok: EncryptedPii;
     });
   read_private_media_authority: (club: text) ->
    (variant {
       Err: text;
       Ok: record {
             competition: opt principal;
             move_id: text;
             revision: nat;
           };
     });
   read_private_name_cleanup_absence: (subjects: vec principal, club:
    opt text) -> (variant {
                    Err: text;
                    Ok: bool;
                  });
   read_private_name_preparation: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt__2;
     });
   read_private_name_release_fence: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt__3;
     });
   read_private_name_writer_window: (request: Request) ->
    (variant {
       Err: text;
       Ok: Receipt__2;
     });
   read_removed_private_club_name_receipt: (id: text, club: text, subject:
    principal) -> (variant {
                     Err: text;
                     Ok: opt Receipt__1;
                   });
   refresh_private_club_name_lifecycle: (subject: principal, club: text,
    originalCiphertext: vec nat8, ciphertext: vec nat8) ->
    (variant {
       Err: text;
       Ok;
     });
   register_conversion_name: (request: Request, subject: principal, club:
    opt text, ciphertext: vec nat8) -> (variant {
                                          Err: text;
                                          Ok;
                                        });
   register_pii: (pii_id: text, field_id: text, ciphertext: vec nat8,
    domain_owner: principal) -> (variant {
                                   Err: text;
                                   Ok: EncryptedPii;
                                 });
   register_private_club_name: (subject: principal, club: text, ciphertext:
    vec nat8) -> (variant {
                    Err: text;
                    Ok: EncryptedPii;
                  });
   rekey_principal: (old: principal, new: principal, dry_run: bool) ->
    (variant {
       err: text;
       ok: nat;
     });
   remove_guardian_relationship: (guardian: principal, child_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   revoke_pii_read: (pii_id: text, field_id: text, reader: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   revoke_pii_read_club: (pii_id: text, field_id: text, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   revoke_pii_read_competition: (pii_id: text, field_id: text,
    competition_id: text) -> (variant {
                                Err: text;
                                Ok;
                              });
   seal_account_removal: (request: Request__1) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   seal_private_name_writer_window: (request: Request) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_domain_canister: (canister: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_media_authority: (club: text, authority: opt principal, move_id:
    text, expected_revision: nat) ->
    (variant {
       Err: text;
       Ok: ClubMediaAuthority;
     });
   set_competition_domain_canister: (canister: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_private_media_authority: (club: text, competition: opt principal,
    move_id: text, expected: nat) ->
    (variant {
       Err: text;
       Ok: record {
             competition: opt principal;
             move_id: text;
             revision: nat;
           };
     });
   set_transfer_fence: (club: text, fenced: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   verify_secure_profile_name: (subject: principal) ->
    (variant {
       Err: text;
       Ok: bool;
     });
 };
type EncryptedPii = 
 record {
   ciphertext: vec nat8;
   field_id: text;
   master_key_id: text;
   nonce: vec nat8;
   pii_id: text;
 };
type ClubMediaAuthority = 
 record {
   authority: opt principal;
   move_id: text;
   revision: nat;
 };
type AuditRecord = 
 record {
   allowed: bool;
   field_id: text;
   operation: text;
   pii_id: text;
   purpose: text;
   requesting_principal: principal;
   timestamp: nat64;
 };
type AuditFilter = 
 record {
   opt_field_id: opt text;
   opt_from_ts: opt nat64;
   opt_pii_id: opt text;
   opt_principal: opt principal;
   opt_to_ts: opt nat64;
 };
service : (governorInit: principal) -> Main
