type PiiDeleteResult = 
 record {
   key_destroyed: bool;
   shredded_at: nat64;
 };
type Main = 
 service {
   add_guardian_relationship: (guardian: principal, child_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   audit_access: (filter: AuditFilter) -> (vec AuditRecord) query;
   /// Public: remaining cycles (shown in admin settings).
   cycles_balance: () -> (nat) query;
   delete_pii: (pii_id: text, field_id: text) ->
    (variant {
       Err: text;
       Ok: PiiDeleteResult;
     });
   emergency_shutdown: () -> (variant {
                                Err: text;
                                Ok;
                              });
   get_encrypted_pii_batch: (pii_ids: vec text, field_id: text, operation:
    text, purpose: text) -> (variant {
                               Err: text;
                               Ok: vec EncryptedPii;
                             });
   get_encrypted_pii_vetkeys_batch: (pii_ids: vec text, field_id: text,
    transport_public_key: blob) -> (variant {
                                      Err: text;
                                      Ok: vec opt blob;
                                    });
   grant_pii_read: (pii_id: text, field_id: text, reader: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   grant_pii_read_club: (pii_id: text, field_id: text, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   my_guardian_children: () -> (vec text) query;
   pii_vetkey_verification_key: () -> (blob);
   purge_club_grants: (club_id: text) -> (variant {
                                            Err: text;
                                            Ok: nat32;
                                          });
   register_pii: (pii_id: text, field_id: text, ciphertext: vec nat8,
    domain_owner: principal) -> (variant {
                                   Err: text;
                                   Ok: EncryptedPii;
                                 });
   remove_guardian_relationship: (guardian: principal, child_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   revoke_pii_read: (pii_id: text, field_id: text, reader: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   revoke_pii_read_club: (pii_id: text, field_id: text, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_domain_canister: (canister: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
 };
type EncryptedPii = 
 record {
   ciphertext: vec nat8;
   field_id: text;
   master_key_id: text;
   nonce: vec nat8;
   pii_id: text;
 };
type AuditRecord = 
 record {
   allowed: bool;
   field_id: text;
   operation: text;
   pii_id: text;
   purpose: text;
   requesting_principal: principal;
   timestamp: nat64;
 };
type AuditFilter = 
 record {
   opt_field_id: opt text;
   opt_from_ts: opt nat64;
   opt_pii_id: opt text;
   opt_principal: opt principal;
   opt_to_ts: opt nat64;
 };
/// PII Access Control Canister
/// Mediates access to personally identifiable information (PII) with
/// field-level access policies and an audit trail.
/// 
/// Encryption construction (vetKeys / IBE):
/// - The canister holds NO key material. Values are encrypted client-side
///   with identity-based encryption (IBE) under the subnet's vetKD master
///   key: the writer derives this canister's IBE public key offline (master
///   public key -> canister key -> context subkey) and encrypts to the
///   identity `pii_id ++ "\u{1F}" ++ field_id` — no canister call needed to
///   write, so first registration of a record needs no key ceremony.
/// - Readers call `get_encrypted_pii_vetkeys_batch`, which enforces the
///   exact same authorization as the old decrypt path (governor, domain
///   owner, granted readers, verified guardians, club-scoped read grants
///   verified live via club_domain) and only then relays the vetKey for the
///   record's identity, encrypted under the caller's one-time transport key.
///   The subnet never sees the raw key; the canister only relays the
///   still-encrypted key and never sees plaintext.
/// - The frontend (@icp-sdk/vetkeys) does all cryptography: transport keys,
///   decryptAndVerify, IBE encrypt/decrypt. The Motoko vetKeys library
///   deliberately exposes only the management-canister relay.
/// - VETKD_KEY_NAME selects the subnet key ("test_key_1" local, "key_1"
///   production). It is captured at first install and immutable for the life
///   of the derived keys — the deploy script MUST set it before first use.
/// - `vetkd_derive_key` costs cycles per derivation; readers cache derived
///   vetKeys client-side per session, so each (pii_id, field_id) costs one
///   derivation per reader session.
service : (governorInit: principal) -> Main
