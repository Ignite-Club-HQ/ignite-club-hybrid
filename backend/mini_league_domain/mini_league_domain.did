type MiniLeagueSessionAvailability = 
 record {
   created_at_ms: nat64;
   id: text;
   marked_by: opt principal;
   player_id: text;
   session_id: text;
   status: text;
   updated_at_ms: nat64;
 };
type MiniLeagueSession = 
 record {
   address: opt text;
   created_at_ms: nat64;
   created_by: principal;
   end_time: opt text;
   id: text;
   linked_event_id: opt text;
   location_name: opt text;
   mini_league_id: text;
   postcode: opt text;
   session_date: text;
   start_time: text;
   status: text;
   team_size_override: opt nat16;
   updated_at_ms: nat64;
 };
type MiniLeaguePlayer = 
 record {
   ability_rating: opt nat16;
   child_id: opt text;
   claimed_by: opt principal;
   created_at_ms: nat64;
   id: text;
   mini_league_id: text;
   name: text;
   notes: opt text;
   parent_user_id: opt text;
   updated_at_ms: nat64;
 };
type MiniLeagueInvite = 
 record {
   claimed_at_ms: opt nat64;
   claimed_by: opt principal;
   created_at_ms: nat64;
   created_by: principal;
   label_text: opt text;
   mini_league_id: text;
   player_id: opt text;
   status: text;
   token: text;
 };
type MiniLeagueGroupPlayer = 
 record {
   created_at_ms: nat64;
   group_id: text;
   jersey_number: opt nat16;
   player_id: text;
 };
type MiniLeagueGroupDuty = 
 record {
   assigned_to: opt text;
   completed: bool;
   created_at_ms: nat64;
   group_id: text;
   id: text;
   name: text;
   points: opt nat16;
   points_awarded: bool;
   status: text;
   updated_at_ms: nat64;
 };
type MiniLeagueGroup = 
 record {
   ability_band: opt text;
   created_at_ms: nat64;
   display_order: nat16;
   id: text;
   linked_event_id: opt text;
   name: text;
   pitch_name: opt text;
   session_id: text;
   target_size: nat16;
   updated_at_ms: nat64;
 };
type MiniLeagueAdmin = 
 record {
   created_at_ms: nat64;
   granted_by: opt principal;
   id: text;
   mini_league_id: text;
   user_id: principal;
 };
type MiniLeague = 
 record {
   bib_colors: vec text;
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   description: opt text;
   id: text;
   logo_url: opt text;
   min_players_per_side: nat16;
   minutes_per_half: nat16;
   name: text;
   show_matches_to_members: bool;
   status: text;
   team_size: nat16;
   updated_at_ms: nat64;
 };
type ClaimedInvite = 
 record {
   club_id: text;
   mini_league_id: text;
   player_id: text;
 };
service : {
  add_admin: (mini_league_id: text, user_id: principal) ->
   (variant {
      Err: text;
      Ok: MiniLeagueAdmin;
    });
  add_player: (mini_league_id: text, name: text, child_id: opt text,
   parent_user_id: opt text, ability_rating: opt nat16, notes: opt text) ->
   (variant {
      Err: text;
      Ok: MiniLeaguePlayer;
    });
  assign_player_to_group: (group_id: text, player_id: text, jersey_number:
   opt nat16) -> (variant {
                    Err: text;
                    Ok: MiniLeagueGroupPlayer;
                  });
  cancel_session: (id: text) -> (variant {
                                   Err: text;
                                   Ok: MiniLeagueSession;
                                 });
  claim_duty: (id: text, player_id: text) ->
   (variant {
      Err: text;
      Ok: MiniLeagueGroupDuty;
    });
  claim_invite: (token: text, player_name: text) ->
   (variant {
      Err: text;
      Ok: ClaimedInvite;
    });
  complete_duty: (id: text, points_awarded: bool) ->
   (variant {
      Err: text;
      Ok: MiniLeagueGroupDuty;
    });
  create_duty: (group_id: text, name: text, points: opt nat16) ->
   (variant {
      Err: text;
      Ok: MiniLeagueGroupDuty;
    });
  create_group: (session_id: text, name: text, ability_band: opt text,
   display_order: nat16, target_size: nat16, pitch_name: opt text) ->
   (variant {
      Err: text;
      Ok: MiniLeagueGroup;
    });
  create_invite: (mini_league_id: text, player_id: opt text, label_text:
   opt text) -> (variant {
                   Err: text;
                   Ok: MiniLeagueInvite;
                 });
  create_mini_league: (club_id: text, name: text, description: opt text,
   logo_url: opt text, team_size: nat16, min_players_per_side: nat16,
   minutes_per_half: nat16, bib_colors: vec text, show_matches_to_members:
   bool) -> (variant {
               Err: text;
               Ok: MiniLeague;
             });
  create_session: (mini_league_id: text, session_date: text, start_time:
   text, end_time: opt text, location_name: opt text, address: opt text,
   postcode: opt text, team_size_override: opt nat16) ->
   (variant {
      Err: text;
      Ok: MiniLeagueSession;
    });
  get_availability: (session_id: text, player_id: text) ->
   (variant {
      Err: text;
      Ok: opt MiniLeagueSessionAvailability;
    }) query;
  get_mini_league: (id: text) -> (variant {
                                    Err: text;
                                    Ok: MiniLeague;
                                  }) query;
  grant_role: ("principal": principal, role: text, club_id: text, team_id:
   opt text) -> (variant {
                   Err: text;
                   Ok;
                 });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  list_admins: (mini_league_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueAdmin;
    }) query;
  list_duties: (group_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueGroupDuty;
    }) query;
  list_group_players: (group_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueGroupPlayer;
    }) query;
  list_groups: (session_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueGroup;
    }) query;
  list_invites: (mini_league_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueInvite;
    }) query;
  list_mini_leagues_by_club: (club_id: text) -> (vec MiniLeague) query;
  list_players: (mini_league_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeaguePlayer;
    }) query;
  list_session_availability: (session_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueSessionAvailability;
    }) query;
  list_sessions: (mini_league_id: text) ->
   (variant {
      Err: text;
      Ok: vec MiniLeagueSession;
    }) query;
  my_availability: () -> (vec MiniLeagueSessionAvailability) query;
  my_leagues: () -> (vec MiniLeague) query;
  remove_admin: (mini_league_id: text, user_id: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  remove_player: (id: text) -> (variant {
                                  Err: text;
                                  Ok;
                                });
  set_availability: (session_id: text, player_id: text, status: text) ->
   (variant {
      Err: text;
      Ok: MiniLeagueSessionAvailability;
    });
  set_mini_league_status: (id: text, status: text) ->
   (variant {
      Err: text;
      Ok: MiniLeague;
    });
  set_session_status: (id: text, status: text) ->
   (variant {
      Err: text;
      Ok: MiniLeagueSession;
    });
  unassign_player_from_group: (group_id: text, player_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  update_group: (id: text, name: text, ability_band: opt text, display_order:
   nat16, target_size: nat16, pitch_name: opt text) ->
   (variant {
      Err: text;
      Ok: MiniLeagueGroup;
    });
  update_mini_league: (id: text, name: text, description: opt text, logo_url:
   opt text, team_size: nat16, min_players_per_side: nat16, minutes_per_half:
   nat16, bib_colors: vec text, show_matches_to_members: bool) ->
   (variant {
      Err: text;
      Ok: MiniLeague;
    });
  update_player: (id: text, name: text, ability_rating: opt nat16, notes:
   opt text) -> (variant {
                   Err: text;
                   Ok: MiniLeaguePlayer;
                 });
  update_session: (id: text, session_date: text, start_time: text, end_time:
   opt text, location_name: opt text, address: opt text, postcode: opt text,
   team_size_override: opt nat16) ->
   (variant {
      Err: text;
      Ok: MiniLeagueSession;
    });
}
