type WsAppMessage = variant {
                      chat_poke:
                       record {
                         conversation_id: text;
                         sequence: nat64;
                       };};
type WebsocketMessage = 
 record {
   client_key: ClientKey;
   content: blob;
   is_service_message: bool;
   sequence_num: nat64;
   timestamp: nat64;
 };
type UserMessagingSettings = 
 record {
   ai_catchup_enabled: bool;
   hide_message_preview: bool;
   user: principal;
 };
type UnreadSummary = 
 record {
   conversation_id: text;
   count: nat64;
   kind: text;
 };
type Unread = 
 record {
   conversation_id: text;
   count: nat64;
   last_read_sequence: nat64;
   user: principal;
 };
type TypingUser = 
 record {
   name: text;
   user: principal;
 };
type TypingPing = 
 record {
   conversation_id: text;
   last_typed_ms: nat64;
   name: text;
   user: principal;
 };
type State = 
 record {
   attachmentMetadata: vec AttachmentMetadata;
   clubDmSettings: vec ClubDmSettings;
   clubMemberships: vec ClubMembership;
   competitionAdmins: vec CompetitionAdmin;
   conversations: vec Conversation;
   dmAttachmentsDisabled: vec principal;
   dmLinks: vec DmLink;
   forwardRecords: vec ForwardRecord;
   governor: principal;
   groupMetadata: vec GroupMetadata;
   groupRoles: vec GroupRole;
   joinRequests: vec JoinRequest;
   messages: vec Message;
   mutePreferences: vec MutePreference;
   pinnedMessages: vec PinnedMessage;
   pollVotes: vec PollVote;
   polls: vec Poll;
   reactions: vec Reaction;
   receipts: vec Receipt;
   roles: vec RoleGrant;
   scheduledMessages: vec ScheduledMessage;
   schema: nat32;
   typingPings: vec TypingPing;
   unread: vec Unread;
   userMessagingSettings: vec UserMessagingSettings;
 };
type ScheduledMessage = 
 record {
   body: text;
   conversation_id: text;
   id: text;
   replayed_at_ms: opt nat64;
   replayed_message_id: opt text;
   scheduled_at_ms: nat64;
   sender: principal;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type RecentConversation = 
 record {
   conversation_id: text;
   kind: text;
   last_message_at_ms: opt nat64;
   last_message_sequence: nat64;
 };
type Receipt = 
 record {
   conversation_id: text;
   message_id: text;
   read: bool;
   user: principal;
 };
type RecapConfig = 
 record {
   api_key: text;
   endpoint_url: text;
   model: text;
 };
type ReactionSummary = 
 record {
   count: nat32;
   emoji: text;
 };
type Reaction = 
 record {
   emoji: text;
   message_id: text;
   user: principal;
 };
type PollVote = 
 record {
   option_index: nat32;
   poll_id: text;
   user: principal;
 };
type PollResults = 
 record {
   counts: vec nat32;
   poll: Poll;
   total_votes: nat32;
 };
type Poll = 
 record {
   closed: bool;
   conversation_id: text;
   created_at_ms: nat64;
   creator: principal;
   id: text;
   message_id: opt text;
   options: vec text;
   question: text;
 };
type PinnedMessage = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   id: text;
   message_id: text;
   pinned_by: principal;
 };
type OnlineUser = 
 record {
   last_seen_ms: nat64;
   platform: opt text;
   user: principal;
 };
type MutePreference = 
 record {
   conversation_id: text;
   muted: bool;
   user: principal;
 };
type MessageWithReactions = 
 record {
   message: Message;
   reactions: vec ReactionSummary;
 };
type MessagePage = 
 record {
   latest_sequence: nat64;
   messages: vec Message;
   next_sequence: opt nat64;
 };
type Message = 
 record {
   attachment: opt Attachment;
   body: text;
   conversation_id: text;
   created_at_ms: nat64;
   edited_at_ms: opt nat64;
   id: text;
   idempotency_key: text;
   reply_to_id: opt text;
   sender: principal;
   sequence: nat64;
 };
type Main = 
 service {
   addBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   add_group_members: (conversation_id: text, members: vec principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   approve_join_request: (conversation_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   block_user: (user: principal) -> (variant {
                                       Err: text;
                                       Ok;
                                     });
   broadcast_announcement: (club_id: text, team_ids: vec text,
    include_club_chat: bool, body: text, idempotency_key: text) ->
    (variant {
       Err: text;
       Ok: BroadcastResult;
     });
   can_dm_user: (other: principal) -> (bool) query;
   close_poll: (poll_id: text) -> (variant {
                                     Err: text;
                                     Ok: Poll;
                                   });
   create_conversation: (club_id: text, team_id: opt text, participants:
    vec principal) -> (variant {
                         Err: text;
                         Ok: Conversation;
                       });
   create_group_with_roles: (club_id: text, team_id: opt text, name: 
    text, kind: text, role_entries: vec record {
                                          principal;
                                          text;
                                        }) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   create_poll: (conversation_id: text, message_id: opt text, question: 
    text, options: vec text) -> (variant {
                                   Err: text;
                                   Ok: Poll;
                                 });
   delete_club_data: (club_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   delete_message: (message_id: text) -> (variant {
                                            Err: text;
                                            Ok: Message;
                                          });
   delete_poll: (poll_id: text) -> (variant {
                                      Err: text;
                                      Ok;
                                    });
   delete_team_data: (team_id: text) -> (variant {
                                           Err: text;
                                           Ok: nat32;
                                         });
   dm_attachments_disabled: (user: principal) -> (bool) query;
   enable_ai_catch_up_for_all_members: (club_id: text) ->
    (variant {
       Err: text;
       Ok: nat32;
     });
   ensure_broadcast_conversation: () ->
    (variant {
       Err: text;
       Ok: Conversation;
     });
   ensure_club_admin_thread: (club_id: text, member: principal) ->
    (variant {
       Err: text;
       Ok: Conversation;
     });
   ensure_conversation: (club_id: text, team_id: opt text, participants:
    vec principal) -> (variant {
                         Err: text;
                         Ok: Conversation;
                       });
   export_state: () -> (variant {
                          Err: text;
                          Ok: State;
                        }) query;
   fetch_link_preview: (url: text) -> (variant {
                                         Err: text;
                                         Ok: LinkPreview;
                                       });
   forward_message: (message_id: text, to_conversation_id: text) ->
    (variant {
       Err: text;
       Ok: Message;
     });
   generate_chat_recap: (conversation_id: text, since_ms: nat64) ->
    (variant {
       Err: text;
       Ok: text;
     });
   get_club_dm_settings: (club_id: text) -> (ClubDmSettings) query;
   get_group_join_policy: (conversation_id: text) ->
    (record {
       category: opt text;
       join_policy: text;
     }) query;
   get_group_metadata: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     }) query;
   get_group_metadata_multi: (conversation_ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec GroupMetadata;
     }) query;
   get_minimum_app_versions: () ->
    (variant {
       Err: text;
       Ok: vec record {
                 text;
                 text;
               };
     }) query;
   get_mute_preference: (conversation_id: text) -> (bool) query;
   get_mute_preferences: (conversation_ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec record {
                 text;
                 bool;
               };
     }) query;
   get_or_create_dm: (other: principal) ->
    (variant {
       Err: text;
       Ok: Conversation;
     });
   get_poll_results: (poll_id: text) ->
    (variant {
       Err: text;
       Ok: PollResults;
     }) query;
   get_user_messaging_settings: () -> (UserMessagingSettings) query;
   grant_competition_admin: (conversation_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   grant_role: ("principal": principal, role: text, club_id: opt text,
    team_id: opt text) -> (variant {
                             Err: text;
                             Ok;
                           });
   has_blocked: (user: principal) -> (bool) query;
   is_competition_admin: (conversation_id: text) -> (bool) query;
   join_open_group: (conversation_id: text) -> (variant {
                                                  Err: text;
                                                  Ok;
                                                });
   leave_group: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   listBulkAccessPrincipals: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
   list_all_online_users: () ->
    (variant {
       Err: text;
       Ok: vec OnlineUser;
     }) query;
   list_blocked_users: () -> (vec principal) query;
   list_club_admin_threads: (club_id: text) ->
    (vec record {
           id: text;
           member: principal;
         });
   list_club_dm_settings: () ->
    (variant {
       Err: text;
       Ok: vec ClubDmSettings;
     }) query;
   list_deleted_groups: () ->
    (variant {
       Err: text;
       Ok: vec GroupMetadata;
     }) query;
   list_dm_attachments_disabled: () ->
    (variant {
       Err: text;
       Ok: vec principal;
     }) query;
   list_groups_by_club: (club_id: text) ->
    (variant {
       Err: text;
       Ok: vec GroupSummary;
     }) query;
   list_groups_by_clubs: (club_ids: vec text) ->
    (variant {
       Err: text;
       Ok: vec GroupSummary;
     }) query;
   list_groups_by_team: (team_id: text) ->
    (variant {
       Err: text;
       Ok: vec GroupSummary;
     }) query;
   list_join_requests: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: vec JoinRequest;
     }) query;
   list_latest_messages_page: (conversation_id: text, before: opt nat64,
    limit: nat16) -> (variant {
                        Err: text;
                        Ok: MessagePage;
                      }) query;
   list_messages: (conversation_id: text, after: opt nat64) ->
    (vec Message) query;
   list_messages_page: (conversation_id: text, after: opt nat64, limit:
    nat16) -> (variant {
                 Err: text;
                 Ok: MessagePage;
               }) query;
   list_open_groups: (club_id: text) ->
    (variant {
       Err: text;
       Ok:
        vec
         record {
           category: opt text;
           join_policy: text;
           requested: bool;
           summary: GroupSummary;
         };
     }) query;
   list_pinned_messages: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: vec PinnedMessage;
     }) query;
   list_reactions: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: vec Reaction;
     }) query;
   list_read_receipts: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: vec Receipt;
     }) query;
   list_typing: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: vec TypingUser;
     }) query;
   mark_read: (conversation_id: text, message_id: text) ->
    (variant {
       Err: text;
       Ok: Receipt;
     });
   messages_since: (conversation_id: text, since_ms: nat64) ->
    (variant {
       Err: text;
       Ok: vec MessageWithReactions;
     }) query;
   my_unread_counts: () -> (vec UnreadSummary) query;
   online_count: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: nat64;
     }) query;
   pin_message: (conversation_id: text, message_id: text) ->
    (variant {
       Err: text;
       Ok: PinnedMessage;
     });
   presence_heartbeat: (platform: opt text) -> (variant {
                                                  Err: text;
                                                  Ok;
                                                });
   purge_group: (conversation_id: text) -> (variant {
                                              Err: text;
                                              Ok;
                                            });
   recapTransform: (record {
                      context: blob;
                      response: HttpRequestResult;
                    }) -> (HttpRequestResult) query;
   recent_conversations: ("principal": principal, limit: nat16) ->
    (variant {
       Err: text;
       Ok: vec RecentConversation;
     }) query;
   register_attachment_metadata: (conversation_id: text, message_id:
    opt text, kind: text, ref_id: text, url: opt text, size_bytes:
    opt nat64) -> (variant {
                     Err: text;
                     Ok: AttachmentMetadata;
                   });
   register_scheduled_message: (conversation_id: text, body: text,
    scheduled_at_ms: nat64) -> (variant {
                                  Err: text;
                                  Ok: ScheduledMessage;
                                });
   reject_join_request: (conversation_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   removeBulkAccessPrincipal: ("principal": principal) ->
    (variant {
       Err: text;
       Ok;
     });
   remove_group_member: (conversation_id: text, member: principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   replay_scheduled_message: (id: text) ->
    (variant {
       Err: text;
       Ok: ScheduledMessage;
     });
   request_join_group: (conversation_id: text) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   restore_group: (conversation_id: text) -> (variant {
                                                Err: text;
                                                Ok;
                                              });
   send_message: (conversation_id: text, body: text, idempotency_key: 
    text, attachment: opt Attachment, reply_to_id: opt text) ->
    (variant {
       Err: text;
       Ok: Message;
     });
   send_system_message: (to_user: principal, body: text, idempotency_key:
    text) -> (variant {
                Err: text;
                Ok: Message;
              });
   send_welcome_message: (body: text) -> (variant {
                                            Err: text;
                                            Ok: Message;
                                          });
   set_club_ai_catch_up: (club_id: text, ai_catch_up_enabled: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_dm_allowed_roles: (club_id: text, allowed_roles: vec text) ->
    (variant {
       Err: text;
       Ok;
     });
   set_club_dm_settings: (club_id: text, dm_disabled: bool,
    attachments_disabled: bool) -> (variant {
                                      Err: text;
                                      Ok;
                                    });
   set_club_domain_canister: (id: principal) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
   set_club_message_privacy: (club_id: text, force_disable_previews: 
    bool) -> (variant {
                Err: text;
                Ok;
              });
   set_dm_attachments_disabled: (user: principal, disabled: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_group_join_policy: (conversation_id: text, join_policy: text,
    category: opt text) -> (variant {
                              Err: text;
                              Ok;
                            });
   set_minimum_app_versions: (versions: vec record {
                                              text;
                                              text;
                                            }) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   set_mute_preference: (conversation_id: text, muted: bool) ->
    (variant {
       Err: text;
       Ok;
     });
   set_notification_queue_canister: (id: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   set_recap_config: (config: opt RecapConfig) -> (variant {
                                                     Err: text;
                                                     Ok;
                                                   });
   set_typing: (conversation_id: text, is_typing: bool, name: text) ->
    (variant {
       Err: text;
       Ok;
     });
   set_user_messaging_settings: (hide_message_preview: bool,
    ai_catchup_enabled: bool) -> (variant {
                                    Err: text;
                                    Ok;
                                  });
   soft_delete_group: (conversation_id: text) -> (variant {
                                                    Err: text;
                                                    Ok;
                                                  });
   toggle_reaction: (message_id: text, emoji: text) ->
    (variant {
       Err: text;
       Ok;
     });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   unblock_user: (user: principal) -> (variant {
                                         Err: text;
                                         Ok;
                                       });
   unpin_message: (conversation_id: text, message_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   unread_count: (conversation_id: text) ->
    (variant {
       Err: text;
       Ok: Unread;
     }) query;
   unread_count_by_club: ("principal": principal) ->
    (variant {
       Err: text;
       Ok: vec ClubUnreadSummary;
     }) query;
   update_group: (conversation_id: text, name: opt text, avatar: opt text,
    description: opt text, admin_only_posting: opt bool) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   update_message: (message_id: text, body: text) ->
    (variant {
       Err: text;
       Ok: Message;
     });
   upsert_club_membership: (user: principal, club_id: text) ->
    (variant {
       Err: text;
       Ok;
     });
   upsert_group_metadata: (conversation_id: text, name: text, kind: text,
    club_id: opt text, team_id: opt text, members: vec principal) ->
    (variant {
       Err: text;
       Ok: GroupMetadata;
     });
   vote_poll: (poll_id: text, option_index: nat32) ->
    (variant {
       Err: text;
       Ok;
     });
   ws_close: (args: CanisterWsCloseArguments) -> (CanisterWsCloseResult);
   ws_get_messages: (args: CanisterWsGetMessagesArguments) ->
    (CanisterWsGetMessagesResult) query;
   ws_message: (args: CanisterWsMessageArguments, msg_type:
    opt WsAppMessage) -> (CanisterWsMessageResult);
   ws_open: (args: CanisterWsOpenArguments) -> (CanisterWsOpenResult);
 };
type LinkPreview = 
 record {
   description: opt text;
   image: opt text;
   site_name: opt text;
   title: opt text;
 };
type JoinRequest = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   status: text;
   user: principal;
 };
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type GroupSummary = 
 record {
   avatar: opt text;
   club_id: opt text;
   conversation_id: text;
   description: opt text;
   is_member: bool;
   kind: text;
   member_count: nat32;
   name: text;
   team_id: opt text;
 };
type GroupRole = 
 record {
   conversation_id: text;
   role: text;
   user: principal;
 };
type GroupMetadata = 
 record {
   admin_only_posting: bool;
   avatar: opt text;
   club_id: opt text;
   conversation_id: text;
   created_at_ms: nat64;
   deleted: bool;
   deleted_at_ms: opt nat64;
   deleted_by: opt principal;
   description: opt text;
   kind: text;
   members: vec principal;
   name: text;
   team_id: opt text;
 };
type GatewayPrincipal = principal;
type ForwardRecord = 
 record {
   from_conversation_id: text;
   from_message_id: text;
   message_id: text;
   original_sender: principal;
   to_conversation_id: text;
 };
type DmLink = 
 record {
   a: principal;
   b: principal;
   conversation_id: text;
 };
type Conversation = 
 record {
   club_id: text;
   id: text;
   next_sequence: nat64;
   participants: vec principal;
   team_id: opt text;
 };
type CompetitionAdmin = 
 record {
   conversation_id: text;
   user: principal;
 };
type ClubUnreadSummary = 
 record {
   club_id: text;
   count: nat64;
 };
type ClubMembership = 
 record {
   club_id: text;
   user: principal;
 };
type ClubDmSettings = 
 record {
   ai_catch_up_enabled: bool;
   allowed_roles: vec text;
   attachments_disabled: bool;
   club_id: text;
   dm_disabled: bool;
   force_disable_previews: bool;
 };
type ClientPrincipal = principal;
type ClientKey = 
 record {
   client_nonce: nat64;
   client_principal: ClientPrincipal;
 };
type CanisterWsOpenResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsOpenArguments = 
 record {
   client_nonce: nat64;
   gateway_principal: GatewayPrincipal;
 };
type CanisterWsMessageResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsMessageArguments = record {msg: WebsocketMessage;};
type CanisterWsGetMessagesResult = 
 variant {
   Err: text;
   Ok: CanisterOutputCertifiedMessages;
 };
type CanisterWsGetMessagesArguments = record {nonce: nat64;};
type CanisterWsCloseResult = 
 variant {
   Err: text;
   Ok;
 };
type CanisterWsCloseArguments = record {client_key: ClientKey;};
type CanisterOutputMessage = 
 record {
   client_key: ClientKey;
   content: blob;
   key: text;
 };
type CanisterOutputCertifiedMessages = 
 record {
   cert: blob;
   is_end_of_queue: bool;
   messages: vec CanisterOutputMessage;
   tree: blob;
 };
type BroadcastResult = 
 record {
   delivered: nat32;
   skipped: vec text;
 };
type AttachmentMetadata = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   id: text;
   kind: text;
   message_id: opt text;
   ref_id: text;
   size_bytes: opt nat64;
   uploader: principal;
   url: opt text;
 };
type Attachment = 
 record {
   kind: text;
   ref_id: text;
   url: opt text;
 };
service : (governorInit: principal) -> Main
