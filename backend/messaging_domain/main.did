type UnreadSummary = 
 record {
   conversation_id: text;
   count: nat64;
   kind: text;
 };
type Unread = 
 record {
   conversation_id: text;
   count: nat64;
   last_read_sequence: nat64;
   user: principal;
 };
type State = 
 record {
   clubMemberships: vec ClubMembership;
   competitionAdmins: vec CompetitionAdmin;
   conversations: vec Conversation;
   dmAttachmentsDisabled: vec principal;
   governor: principal;
   groupMetadata: vec GroupMetadata;
   messages: vec Message;
   receipts: vec Receipt;
   roles: vec RoleGrant;
   schema: nat32;
   unread: vec Unread;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type Receipt = 
 record {
   conversation_id: text;
   message_id: text;
   read: bool;
   user: principal;
 };
type MessagePage = 
 record {
   latest_sequence: nat64;
   messages: vec Message;
   next_sequence: opt nat64;
 };
type Message = 
 record {
   attachment: opt Attachment;
   body: text;
   conversation_id: text;
   edited_at_ms: opt nat64;
   id: text;
   idempotency_key: text;
   sender: principal;
   sequence: nat64;
 };
type GroupMetadata = 
 record {
   club_id: opt text;
   conversation_id: text;
   created_at_ms: nat64;
   kind: text;
   members: vec principal;
   name: text;
   team_id: opt text;
 };
type Conversation = 
 record {
   club_id: text;
   id: text;
   next_sequence: nat64;
   participants: vec principal;
   team_id: opt text;
 };
type CompetitionAdmin = 
 record {
   conversation_id: text;
   user: principal;
 };
type ClubMembership = 
 record {
   club_id: text;
   user: principal;
 };
type BroadcastResult = 
 record {
   delivered: nat32;
   skipped: vec text;
 };
type Attachment = 
 record {
   kind: text;
   ref_id: text;
   url: opt text;
 };
service : {
  addBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  broadcast_announcement: (club_id: text, team_ids: vec text,
   include_club_chat: bool, body: text, idempotency_key: text) ->
   (variant {
      Err: text;
      Ok: BroadcastResult;
    });
  can_dm_user: (other: principal) -> (bool) query;
  create_conversation: (club_id: text, team_id: opt text, participants:
   vec principal) -> (variant {
                        Err: text;
                        Ok: Conversation;
                      });
  delete_message: (message_id: text) -> (variant {
                                           Err: text;
                                           Ok: Message;
                                         });
  dm_attachments_disabled: (user: principal) -> (bool) query;
  export_state: () -> (variant {
                         Err: text;
                         Ok: State;
                       }) query;
  get_group_metadata: (conversation_id: text) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    }) query;
  grant_competition_admin: (conversation_id: text, user: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  grant_role: ("principal": principal, role: text, club_id: opt text,
   team_id: opt text) -> (variant {
                            Err: text;
                            Ok;
                          });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  is_competition_admin: (conversation_id: text) -> (bool) query;
  listBulkAccessPrincipals: () ->
   (variant {
      Err: text;
      Ok: vec principal;
    }) query;
  list_messages: (conversation_id: text, after: opt nat64) ->
   (vec Message) query;
  list_messages_page: (conversation_id: text, after: opt nat64, limit:
   nat16) -> (variant {
                Err: text;
                Ok: MessagePage;
              }) query;
  mark_read: (conversation_id: text, message_id: text) ->
   (variant {
      Err: text;
      Ok: Receipt;
    });
  my_unread_counts: () -> (vec UnreadSummary) query;
  removeBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  send_message: (conversation_id: text, body: text, idempotency_key: 
   text, attachment: opt Attachment) -> (variant {
                                           Err: text;
                                           Ok: Message;
                                         });
  set_dm_attachments_disabled: (user: principal, disabled: bool) ->
   (variant {
      Err: text;
      Ok;
    });
  unread_count: (conversation_id: text) ->
   (variant {
      Err: text;
      Ok: Unread;
    }) query;
  update_message: (message_id: text, body: text) ->
   (variant {
      Err: text;
      Ok: Message;
    });
  upsert_club_membership: (user: principal, club_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  upsert_group_metadata: (conversation_id: text, name: text, kind: text,
   club_id: opt text, team_id: opt text, members: vec principal) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    });
}
