type UserMessagingSettings = 
 record {
   ai_catchup_enabled: bool;
   hide_message_preview: bool;
   user: principal;
 };
type UnreadSummary = 
 record {
   conversation_id: text;
   count: nat64;
   kind: text;
 };
type Unread = 
 record {
   conversation_id: text;
   count: nat64;
   last_read_sequence: nat64;
   user: principal;
 };
type State = 
 record {
   attachmentMetadata: vec AttachmentMetadata;
   clubDmSettings: vec ClubDmSettings;
   clubMemberships: vec ClubMembership;
   competitionAdmins: vec CompetitionAdmin;
   conversations: vec Conversation;
   dmAttachmentsDisabled: vec principal;
   dmLinks: vec DmLink;
   forwardRecords: vec ForwardRecord;
   governor: principal;
   groupMetadata: vec GroupMetadata;
   groupRoles: vec GroupRole;
   joinRequests: vec JoinRequest;
   messages: vec Message;
   mutePreferences: vec MutePreference;
   pollVotes: vec PollVote;
   polls: vec Poll;
   reactions: vec Reaction;
   receipts: vec Receipt;
   roles: vec RoleGrant;
   scheduledMessages: vec ScheduledMessage;
   schema: nat32;
   unread: vec Unread;
   userMessagingSettings: vec UserMessagingSettings;
 };
type ScheduledMessage = 
 record {
   body: text;
   conversation_id: text;
   id: text;
   replayed_at_ms: opt nat64;
   replayed_message_id: opt text;
   scheduled_at_ms: nat64;
   sender: principal;
 };
type RoleGrant = 
 record {
   club_id: opt text;
   role: text;
   team_id: opt text;
   user: principal;
 };
type RecentConversation = 
 record {
   conversation_id: text;
   kind: text;
   last_message_at_ms: opt nat64;
   last_message_sequence: nat64;
 };
type Receipt = 
 record {
   conversation_id: text;
   message_id: text;
   read: bool;
   user: principal;
 };
type ReactionSummary = 
 record {
   count: nat32;
   emoji: text;
 };
type Reaction = 
 record {
   emoji: text;
   message_id: text;
   user: principal;
 };
type PollVote = 
 record {
   option_index: nat32;
   poll_id: text;
   user: principal;
 };
type PollResults = 
 record {
   counts: vec nat32;
   poll: Poll;
   total_votes: nat32;
 };
type Poll = 
 record {
   closed: bool;
   conversation_id: text;
   created_at_ms: nat64;
   creator: principal;
   id: text;
   message_id: opt text;
   options: vec text;
   question: text;
 };
type MutePreference = 
 record {
   conversation_id: text;
   muted: bool;
   user: principal;
 };
type MessageWithReactions = 
 record {
   message: Message;
   reactions: vec ReactionSummary;
 };
type MessagePage = 
 record {
   latest_sequence: nat64;
   messages: vec Message;
   next_sequence: opt nat64;
 };
type Message = 
 record {
   attachment: opt Attachment;
   body: text;
   conversation_id: text;
   created_at_ms: nat64;
   edited_at_ms: opt nat64;
   id: text;
   idempotency_key: text;
   sender: principal;
   sequence: nat64;
 };
type JoinRequest = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   status: text;
   user: principal;
 };
type GroupRole = 
 record {
   conversation_id: text;
   role: text;
   user: principal;
 };
type GroupMetadata = 
 record {
   avatar: opt text;
   club_id: opt text;
   conversation_id: text;
   created_at_ms: nat64;
   deleted: bool;
   description: opt text;
   kind: text;
   members: vec principal;
   name: text;
   team_id: opt text;
 };
type ForwardRecord = 
 record {
   from_conversation_id: text;
   from_message_id: text;
   message_id: text;
   original_sender: principal;
   to_conversation_id: text;
 };
type DmLink = 
 record {
   a: principal;
   b: principal;
   conversation_id: text;
 };
type Conversation = 
 record {
   club_id: text;
   id: text;
   next_sequence: nat64;
   participants: vec principal;
   team_id: opt text;
 };
type CompetitionAdmin = 
 record {
   conversation_id: text;
   user: principal;
 };
type ClubUnreadSummary = 
 record {
   club_id: text;
   count: nat64;
 };
type ClubMembership = 
 record {
   club_id: text;
   user: principal;
 };
type ClubDmSettings = 
 record {
   attachments_disabled: bool;
   club_id: text;
   dm_disabled: bool;
 };
type BroadcastResult = 
 record {
   delivered: nat32;
   skipped: vec text;
 };
type AttachmentMetadata = 
 record {
   conversation_id: text;
   created_at_ms: nat64;
   id: text;
   kind: text;
   message_id: opt text;
   ref_id: text;
   size_bytes: opt nat64;
   uploader: principal;
   url: opt text;
 };
type Attachment = 
 record {
   kind: text;
   ref_id: text;
   url: opt text;
 };
service : {
  addBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  add_group_members: (conversation_id: text, members: vec principal) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    });
  approve_join_request: (conversation_id: text, user: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  broadcast_announcement: (club_id: text, team_ids: vec text,
   include_club_chat: bool, body: text, idempotency_key: text) ->
   (variant {
      Err: text;
      Ok: BroadcastResult;
    });
  can_dm_user: (other: principal) -> (bool) query;
  close_poll: (poll_id: text) -> (variant {
                                    Err: text;
                                    Ok: Poll;
                                  });
  create_conversation: (club_id: text, team_id: opt text, participants:
   vec principal) -> (variant {
                        Err: text;
                        Ok: Conversation;
                      });
  create_group_with_roles: (club_id: text, team_id: opt text, name: text,
   kind: text, role_entries: vec record {
                                   principal;
                                   text;
                                 }) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    });
  create_poll: (conversation_id: text, message_id: opt text, question: 
   text, options: vec text) -> (variant {
                                  Err: text;
                                  Ok: Poll;
                                });
  delete_message: (message_id: text) -> (variant {
                                           Err: text;
                                           Ok: Message;
                                         });
  dm_attachments_disabled: (user: principal) -> (bool) query;
  export_state: () -> (variant {
                         Err: text;
                         Ok: State;
                       }) query;
  forward_message: (message_id: text, to_conversation_id: text) ->
   (variant {
      Err: text;
      Ok: Message;
    });
  get_club_dm_settings: (club_id: text) -> (ClubDmSettings) query;
  get_group_metadata: (conversation_id: text) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    }) query;
  get_mute_preference: (conversation_id: text) -> (bool) query;
  get_or_create_dm: (other: principal) ->
   (variant {
      Err: text;
      Ok: Conversation;
    });
  get_poll_results: (poll_id: text) ->
   (variant {
      Err: text;
      Ok: PollResults;
    }) query;
  get_user_messaging_settings: () -> (UserMessagingSettings) query;
  grant_competition_admin: (conversation_id: text, user: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  grant_role: ("principal": principal, role: text, club_id: opt text,
   team_id: opt text) -> (variant {
                            Err: text;
                            Ok;
                          });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  is_competition_admin: (conversation_id: text) -> (bool) query;
  listBulkAccessPrincipals: () ->
   (variant {
      Err: text;
      Ok: vec principal;
    }) query;
  list_join_requests: (conversation_id: text) ->
   (variant {
      Err: text;
      Ok: vec JoinRequest;
    }) query;
  list_messages: (conversation_id: text, after: opt nat64) ->
   (vec Message) query;
  list_messages_page: (conversation_id: text, after: opt nat64, limit:
   nat16) -> (variant {
                Err: text;
                Ok: MessagePage;
              }) query;
  mark_read: (conversation_id: text, message_id: text) ->
   (variant {
      Err: text;
      Ok: Receipt;
    });
  messages_since: (conversation_id: text, since_ms: nat64) ->
   (variant {
      Err: text;
      Ok: vec MessageWithReactions;
    }) query;
  my_unread_counts: () -> (vec UnreadSummary) query;
  recent_conversations: ("principal": principal, limit: nat16) ->
   (variant {
      Err: text;
      Ok: vec RecentConversation;
    }) query;
  register_attachment_metadata: (conversation_id: text, message_id: opt text,
   kind: text, ref_id: text, url: opt text, size_bytes: opt nat64) ->
   (variant {
      Err: text;
      Ok: AttachmentMetadata;
    });
  register_scheduled_message: (conversation_id: text, body: text,
   scheduled_at_ms: nat64) -> (variant {
                                 Err: text;
                                 Ok: ScheduledMessage;
                               });
  reject_join_request: (conversation_id: text, user: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  removeBulkAccessPrincipal: ("principal": principal) ->
   (variant {
      Err: text;
      Ok;
    });
  replay_scheduled_message: (id: text) ->
   (variant {
      Err: text;
      Ok: ScheduledMessage;
    });
  request_join_group: (conversation_id: text) -> (variant {
                                                    Err: text;
                                                    Ok;
                                                  });
  send_message: (conversation_id: text, body: text, idempotency_key: 
   text, attachment: opt Attachment) -> (variant {
                                           Err: text;
                                           Ok: Message;
                                         });
  set_club_dm_settings: (club_id: text, dm_disabled: bool,
   attachments_disabled: bool) -> (variant {
                                     Err: text;
                                     Ok;
                                   });
  set_dm_attachments_disabled: (user: principal, disabled: bool) ->
   (variant {
      Err: text;
      Ok;
    });
  set_mute_preference: (conversation_id: text, muted: bool) ->
   (variant {
      Err: text;
      Ok;
    });
  set_user_messaging_settings: (hide_message_preview: bool,
   ai_catchup_enabled: bool) -> (variant {
                                   Err: text;
                                   Ok;
                                 });
  soft_delete_group: (conversation_id: text) -> (variant {
                                                   Err: text;
                                                   Ok;
                                                 });
  toggle_reaction: (message_id: text, emoji: text) ->
   (variant {
      Err: text;
      Ok;
    });
  unread_count: (conversation_id: text) ->
   (variant {
      Err: text;
      Ok: Unread;
    }) query;
  unread_count_by_club: ("principal": principal) ->
   (variant {
      Err: text;
      Ok: vec ClubUnreadSummary;
    }) query;
  update_group: (conversation_id: text, name: opt text, avatar: opt text,
   description: opt text) -> (variant {
                                Err: text;
                                Ok: GroupMetadata;
                              });
  update_message: (message_id: text, body: text) ->
   (variant {
      Err: text;
      Ok: Message;
    });
  upsert_club_membership: (user: principal, club_id: text) ->
   (variant {
      Err: text;
      Ok;
    });
  upsert_group_metadata: (conversation_id: text, name: text, kind: text,
   club_id: opt text, team_id: opt text, members: vec principal) ->
   (variant {
      Err: text;
      Ok: GroupMetadata;
    });
  vote_poll: (poll_id: text, option_index: nat32) ->
   (variant {
      Err: text;
      Ok;
    });
}
