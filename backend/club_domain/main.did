type TeamSponsorAllocation = 
 record {
   sponsor_id: text;
   team_id: text;
 };
type TeamPlayerPosition = 
 record {
   member_id: text;
   position: text;
   team_id: text;
 };
type TeamInviteLink = 
 record {
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   id: text;
   revoked: bool;
   role: text;
   rotated_at_ms: opt nat64;
   team_id: text;
   token: text;
 };
type TeamInvite = 
 record {
   accepted_by: opt principal;
   club_id: text;
   created_at_ms: nat64;
   email: text;
   expires_at_ms: nat64;
   id: text;
   invited_by: principal;
   revoked: bool;
   role: text;
   team_id: text;
 };
type TeamFolder = 
 record {
   club_id: text;
   color: text;
   created_at_ms: nat64;
   created_by: principal;
   description: opt text;
   id: text;
   name: text;
   sort_order: nat32;
 };
type TeamCreationRequest = 
 record {
   age_group: opt text;
   club_id: text;
   created_at_ms: nat64;
   decided_at_ms: opt nat64;
   decided_by: opt principal;
   division: opt text;
   id: text;
   name: text;
   requested_by: principal;
   status: text;
   team_id: opt text;
 };
type TeamCaptain = 
 record {
   team_id: text;
   user: principal;
 };
type Team = 
 record {
   club: text;
   id: text;
 };
type State = 
 record {
   accounts: vec Account;
   challenges: vec Challenge;
   exclusions: vec AccountExclusion;
   families: vec Family;
   next_challenge: nat64;
   roles: vec AccountRole;
   schema: nat32;
 };
type Snapshot = 
 record {
   clubs: vec record {
                text;
                Listing;
              };
   schema: nat32;
 };
type SeasonTeamSummary = 
 record {
   avg_attendance_pct: float64;
   club_id: text;
   events_count: nat32;
   roster_size: nat32;
   season_id: text;
   team_id: text;
   team_name: text;
   updated_at_ms: nat64;
 };
type SeasonPlayerStat = 
 record {
   attendance_pct: float64;
   club_id: text;
   club_player_id: text;
   events_attended: nat32;
   events_total: nat32;
   games_played: nat32;
   player_name: text;
   season_id: text;
   team_id: text;
   updated_at_ms: nat64;
 };
type Season = 
 record {
   club_id: text;
   created_at_ms: nat64;
   end_date: text;
   id: text;
   name: text;
   start_date: text;
   status: text;
   updated_at_ms: nat64;
 };
type RoleRequest = 
 record {
   account_id: text;
   club: text;
   created_at_ms: nat64;
   decided_at_ms: opt nat64;
   decided_by: opt principal;
   id: text;
   role: text;
   status: text;
   team: opt text;
   user: principal;
 };
type RoleGrant = 
 record {
   club: opt text;
   role: text;
   team: opt text;
   user: principal;
 };
type Request = 
 record {
   club: text;
   expected_revision: nat64;
   operation: Operation;
   request_id: text;
 };
type RemovedMember = 
 record {
   club: text;
   removed_at_ms: nat64;
   removed_by: principal;
   user: principal;
 };
type ProfileTeamHistoryEntry = 
 record {
   club_id: text;
   club_name: text;
   joined_at_ms: nat64;
   membership_id: text;
   season_end_date: text;
   season_id: text;
   season_name: text;
   season_start_date: text;
   season_status: text;
   team_id: text;
   team_level_age: opt text;
   team_name: text;
 };
type PendingInvite = 
 record {
   accepted_at_ms: opt nat64;
   accepted_by: opt principal;
   child_id: opt text;
   club_id: text;
   created_at_ms: nat64;
   email: text;
   id: text;
   invited_by: principal;
   kind: text;
   resent_at_ms: opt nat64;
   role: opt text;
   status: text;
   team_id: opt text;
 };
type ParentInvite = 
 record {
   accepted_by: opt principal;
   child_id: text;
   club_id: text;
   created_at_ms: nat64;
   expires_at_ms: nat64;
   id: text;
   invited_by: principal;
   team_id: opt text;
 };
type Operation = 
 variant {
   Remove: record {id: text;};
   Reorder: record {
              first: text;
              second: text;
            };
   Save: record {
           draft: Draft;
           id: opt text;
         };
   SetActive: record {
                active: bool;
                id: text;
              };
 };
type NewsPost = 
 record {
   body: text;
   club_id: text;
   created_at_ms: nat64;
   created_by: principal;
   id: text;
   revision: nat64;
   status: text;
   title: text;
   updated_at_ms: nat64;
 };
type Mutation = 
 record {
   link: opt Link;
   revision: nat64;
 };
type MemberPayment = 
 record {
   amount: float64;
   child_id: opt text;
   club_id: text;
   created_at_ms: nat64;
   id: text;
   marked_by: principal;
   notes: opt text;
   payment_period: text;
   payment_type: text;
   user_id: text;
 };
type Main = 
 service {
   accept_identity_link: (id: nat64) -> (variant {
                                           Err: text;
                                           Ok: Account;
                                         });
   accept_parent_invite: (token: text) ->
    (variant {
       Err: text;
       Ok: ParentInvite;
     });
   accept_pending_invite: (id: text) ->
    (variant {
       Err: text;
       Ok: PendingInvite;
     });
   accept_team_invite: (id: text) -> (variant {
                                        Err: text;
                                        Ok: TeamInvite;
                                      });
   add_role_grant: (user: principal, club: text, role: text, team:
