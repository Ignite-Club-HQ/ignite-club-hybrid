                Ok;
              });
   set_theme_preference: (preference: text) -> (variant {
                                                  Err: text;
                                                  Ok;
                                                });
   soft_delete_club: (id: text, cascade_teams: bool) ->
    (variant {
       Err: text;
       Ok: ClubProfile;
     });
   soft_delete_team: (id: text) -> (variant {
                                      Err: text;
                                      Ok: ClubTeam;
                                    });
   transfer_governorship: (new_governor: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   unarchive_team: (id: text) -> (variant {
                                    Err: text;
                                    Ok: ClubTeam;
                                  });
   unfreeze_club: (club: text, rev: nat64) -> (variant {
                                                 Err: text;
                                                 Ok;
                                               });
   unlink_guardian: (child_id: text, user: principal) ->
    (variant {
       Err: text;
       Ok;
     });
   unmark_member_paid: (id: text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
   update_news_post: (id: text, title: text, body: text, status: text,
    expected_revision: nat64) -> (variant {
                                    Err: text;
                                    Ok: NewsPost;
                                  });
   whoami: () -> (variant {
                    Err: text;
                    Ok: Account;
                  }) query;
 };
type Listing = 
 record {
   links: vec Link;
   revision: nat64;
 };
type Link = 
 record {
   club_id: text;
   created_at_ms: nat64;
   draft: Draft;
   id: text;
   sort_order: nat32;
 };
type InviteStats = 
 record {
   accepted: nat;
   total: nat;
 };
type InvitePayload = 
 record {
   body: text;
   subject: text;
   to: text;
 };
type HttpResponse = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   status_code: nat16;
 };
type HttpRequest = 
 record {
   body: blob;
   headers: vec record {
                  text;
                  text;
                };
   method: text;
   url: text;
 };
type Guardian = 
 record {
   child: text;
   user: principal;
 };
type Family = 
 record {
   account_id: text;
   child_id: text;
 };
type Exclusion = 
 record {
   club: text;
   user: principal;
 };
type Draft = 
 record {
   icon: text;
   is_active: bool;
   open_mode: text;
   subtitle: opt text;
   title: text;
   url: text;
 };
type Config = 
 record {
   acl: Acl;
   acl_version: nat64;
   governor: principal;
   schema: nat32;
 };
type ClubTerm = 
 record {
   club_id: text;
   created_at_ms: nat64;
   end_date: text;
   id: text;
   is_active: bool;
   name: text;
   start_date: text;
   status: text;
 };
type ClubTeam = 
 record {
   age_group: opt text;
   archived: bool;
   club_id: text;
   deleted_at_ms: opt nat64;
   description: opt text;
   division: opt text;
   folder_id: opt text;
   gender: opt text;
   id: text;
   is_active: bool;
   is_shell: bool;
   logo_url: opt text;
   name: text;
   playhq_auto_create_events: bool;
   playhq_competition_id: opt text;
   playhq_team_id: opt text;
   shell_claim_token: opt text;
   shell_claimed_at_ms: opt nat64;
   shell_claimed_by: opt principal;
   shell_contact_email: opt text;
   shell_contact_name: opt text;
   shell_invited_by: opt principal;
   team_type: opt text;
 };
type ClubSubscription = 
 record {
   activated_at_ms: opt nat64;
   admin_pro_football_override: bool;
   admin_pro_override: bool;
   cancelled_at_ms: opt nat64;
   club_id: text;
   expires_at_ms: opt nat64;
   is_pro: bool;
   is_pro_football: bool;
   is_trial: bool;
   plan: text;
   team_limit: opt nat32;
   trial_ends_at_ms: opt nat64;
 };
type ClubSponsor = 
 record {
   club_id: text;
   description: opt text;
   exposure_percentage: opt nat8;
   id: text;
   is_active: bool;
   is_team_only: bool;
   logo_url: opt text;
   name: text;
   sort_order: nat32;
   tier: text;
   website_url: opt text;
 };
type ClubSettings = 
 record {
   announcement: opt text;
   chat_thread_ads_enabled: bool;
   club_id: text;
   club_switcher_hint: opt text;
   contact_email: opt text;
   events_sponsor_strip_enabled: bool;
   header_club_name_enabled: bool;
   header_logo_enabled: bool;
   invite_email_style: opt text;
   logo_only_mode: bool;
   media_header_sponsors_enabled: bool;
   media_sponsors_enabled: bool;
   membership_open: bool;
   public_directory: bool;
   theme_accent_color: opt text;
   theme_dark_accent_color: opt text;
   theme_dark_primary_color: opt text;
   theme_dark_secondary_color: opt text;
   theme_enabled: bool;
