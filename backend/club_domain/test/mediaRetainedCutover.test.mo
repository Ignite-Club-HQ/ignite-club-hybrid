import Cutover "../src/mediaRetainedCutover";
import Quota "../src/mediaRetainedQuota";
import Principal "mo:core/Principal";
let a = Principal.fromText("ryjl3-tyaaa-aaaaa-aaaba-cai");
let b = Principal.fromText("rrkah-fqaaa-aaaaa-aaaaq-cai");
let authority = Principal.fromText("r7inp-6aaaa-aaaaa-aaabq-cai");
let indexed : Cutover.Cursor = { phase = #indexed; offset = 0; after = "" };
let done : Cutover.Cursor = { phase = #done; offset = 0; after = "" };
let row : Cutover.Row = { path = "clubs/c/gallery/a"; club = ?"c"; bytes = 7; content_hash = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"; revision = 0 };
let first : Cutover.Page = { frozen = true; pending = 0; authority = ?authority; revision = 4; total = 1; total_bytes = 7; cursor = Cutover.first; next = indexed; rows = [row] };
func ok(r : { #Ok; #Err : Text }) { assert r == #Ok };
func deny(r : { #Ok; #Err : Text }) { switch(r) { case (#Err(_)) {}; case _ assert false } };
let state = Cutover.empty();
assert not Cutover.start(state, [a,a]); assert Cutover.start(state, [a,b]); assert not Cutover.start(state, [a]);
deny(Cutover.apply(state, authority, a, { first with pending = 1 }));
deny(Cutover.apply(state, authority, a, { first with authority = ?b }));
deny(Cutover.apply(state, authority, b, { first with rows = [row, row]; total = 2; total_bytes = 14 }));
assert Quota.usage(state.ledger,"c").finalized == 0;
ok(Cutover.apply(state, authority, a, first));
assert Quota.usage(state.ledger,"c").finalized == 7;
deny(Cutover.apply(state, authority, a, first));
deny(Cutover.apply(state, authority, a, { first with cursor = indexed; next = done; rows = []; revision = 5 }));
ok(Cutover.apply(state, authority, a, { first with cursor = indexed; next = done; rows = [] }));
assert not Cutover.complete(state);
ok(Cutover.apply(state, authority, b, { first with rows = []; total = 0; total_bytes = 0 }));
assert not Cutover.complete(state);
ok(Cutover.apply(state, authority, b, { first with cursor = indexed; next = done; rows = []; total = 0; total_bytes = 0 }));
assert Cutover.complete(state); assert not Cutover.ready(state,a);
state.active := true; assert Cutover.ready(state,a); assert not Cutover.ready(state,authority);
