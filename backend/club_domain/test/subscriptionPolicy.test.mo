import Policy "../src/subscriptionPolicy";
import Types "../src/types";
let base : Types.ClubSubscription = {
  club_id = "club"; is_pro = true; is_pro_football = false; admin_pro_override = false;
  admin_pro_football_override = false; expires_at_ms = ?200; plan = "standard";
  team_limit = ?20; trial_ends_at_ms = null; is_trial = false; cancelled_at_ms = null; activated_at_ms = null;
};
assert Policy.limit(null, 100) == 20;
assert Policy.limit(?base, 100) == 20;
assert Policy.limit(?{ base with team_limit = ?21 }, 100) == 21;
assert Policy.limit(?{ base with team_limit = ?21 }, 200) == 20;
assert Policy.limit(?{ base with is_pro = false; is_trial = true; trial_ends_at_ms = ?200; team_limit = ?21 }, 100) == 20;
assert Policy.limit(?{ base with team_limit = ?3 }, 100) == 3;
assert Policy.limit(?{ base with team_limit = ?5 }, 100) == 5;
assert Policy.limit(?{ base with plan = "unlimited"; team_limit = null }, 100) == 100_000;
assert Policy.limit(?{ base with plan = "unlimited"; team_limit = null }, 200) == 20;
assert Policy.mediaBase(null, 100) == 262_144_000;
assert Policy.mediaBase(?base, 100) == 5_368_709_120;
assert Policy.mediaBase(?{ base with plan = "small" }, 100) == 3_221_225_472;
assert Policy.mediaBase(?{ base with plan = "unlimited" }, 100) == 5_368_709_120;
assert Policy.mediaBase(?base, 200) == 262_144_000;
assert Policy.mediaBase(?{ base with plan = "usd_v2_starter" }, 100) == 3_221_225_472;
assert Policy.mediaBase(?{ base with plan = "usd_v2_standard" }, 100) == 3_221_225_472;
assert Policy.limit(?{ base with plan = "usd_v2_small"; team_limit = ?21 }, 100) == 3;
assert Policy.limit(?{ base with plan = "usd_v2_growing"; team_limit = ?21 }, 100) == 5;
assert Policy.limit(?{ base with plan = "usd_v2_starter"; team_limit = ?21 }, 100) == 10;
assert Policy.limit(?{ base with plan = "usd_v2_standard"; team_limit = null }, 100) == 20;
assert Policy.limit(?{ base with plan = "usd_v2_standard"; team_limit = ?21 }, 100) == 21;
