import Receiver "../RemovalReceiver";
import Map "mo:core/Map";
import Principal "mo:core/Principal";
import Blob "mo:core/Blob";
import Array "mo:core/Array";
import Text "mo:core/Text";
let identity = Principal.fromText("rrkah-fqaaa-aaaaa-aaaaq-cai");
let subject = Principal.fromText("ryjl3-tyaaa-aaaaa-aaaba-cai");
let outsider = Principal.fromText("r7inp-6aaaa-aaaaa-aaabq-cai");
let intents = Map.empty<Text, Receiver.Request>();
let subjects = Map.empty<Principal, Text>();
let active = Map.empty<Principal, Nat>();
let gate = Receiver.Gate(true, ?identity, intents, subjects, active);
let request : Receiver.Request = { account_id = "removed"; generation = 1; subjects = [subject]; inventory_digest = Blob.fromArray(Array.repeat<Nat8>(0,32)) };
assert gate.enter(subject);
assert gate.prepare(outsider, request) == #Err("Configured rehearsal identity required");
assert not gate.denied(subject);
assert gate.prepare(identity, request) == #Ok;
assert gate.denied(subject);
assert gate.snapshotDenied(Principal.toBlob(subject));
assert gate.snapshotDenied(Text.encodeUtf8(subject.toText()));
assert not gate.snapshotDenied(Principal.toBlob(outsider));
assert not gate.enter(subject);
assert gate.prepare(identity, request) == #Ok;
assert gate.prepare(identity, { request with generation = 2 }) == #Err("Immutable removal fence conflict");
switch (gate.receipt(identity, request, identity, 2)) { case (#Ok(r)) assert r.outstanding == 3; case _ assert false };
// Reconstruct from persistent collections: a restart must not reset a hold.
let restored = Receiver.Gate(true, ?identity, intents, subjects, active);
assert not restored.enter(subject);
switch (restored.receipt(identity, request, identity, 0)) { case (#Ok(r)) assert r.outstanding == 1; case _ assert false };
assert restored.seal(identity, request, identity, 0) == #Err("Removal work remains outstanding");
restored.leave(subject);
switch (restored.seal(identity, request, identity, 0)) { case (#Ok(r)) assert r.outstanding == 0; case _ assert false };
assert restored.seal(identity, request, identity, 1) == #Err("Removal work remains outstanding");
assert restored.seal(outsider, request, identity, 0) == #Err("Configured rehearsal identity required");
switch (restored.receipt(identity, request, identity, 0)) { case (#Ok(r)) assert r.outstanding == 0; case _ assert false };
assert restored.enter(outsider);
assert Receiver.Gate(false, ?identity, intents, subjects, active).prepare(identity, request) == #Err("Configured rehearsal identity required");