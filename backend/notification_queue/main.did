type Status = 
 variant {
   Delivered;
   Failed;
   Pending;
   Processing;
 };
type ScheduledStatus = 
 variant {
   Cancelled;
   Failed;
   Pending;
   Sent;
 };
type ScheduledResults = 
 variant {
   Err: text;
   Ok: vec ScheduledMessage;
 };
type ScheduledResult = 
 variant {
   Err: text;
   Ok: ScheduledMessage;
 };
type ScheduledMessage = 
 record {
   attempted_at_ms: opt nat64;
   author: text;
   body: text;
   chat_type: ChatType;
   club_id: opt text;
   conversation_id: opt text;
   created_at_ms: nat64;
   error_message: opt text;
   group_id: opt text;
   id: text;
   image_url: opt text;
   recurrence: Recurrence;
   recurrence_parent_id: opt text;
   recurrence_until_ms: opt nat64;
   reply_to_id: opt text;
   scheduled_for_ms: nat64;
   sent_message_id: opt text;
   status: ScheduledStatus;
   team_id: opt text;
   updated_at_ms: nat64;
 };
type Results = 
 variant {
   Err: text;
   Ok: vec Notification;
 };
type ResultNat16 = 
 variant {
   Err: text;
   Ok: nat16;
 };
type Result = 
 variant {
   Err: text;
   Ok: Notification;
 };
type Recurrence = 
 variant {
   Daily;
   Monthly;
   None;
   Weekly;
 };
type PushAlertSettingsInput = 
 record {
   alerts_enabled: bool;
   check_window_hours: nat32;
   cooldown_hours: nat32;
   failure_threshold_percent: nat32;
   min_notifications: nat32;
 };
type PushAlertSettings = 
 record {
   alerts_enabled: bool;
   check_window_hours: nat32;
   cooldown_hours: nat32;
   failure_threshold_percent: nat32;
   min_notifications: nat32;
   updated_at_ms: nat64;
   updated_by: opt text;
 };
type PreferencesResult = 
 variant {
   Err: text;
   Ok: Preferences;
 };
type PreferencesPageResult = 
 variant {
   Err: text;
   Ok: PreferencesPage;
 };
type PreferencesPage = 
 record {
   items: vec Preferences;
   total: nat32;
 };
type PreferencesInput = 
 record {
   admin_enabled: bool;
   email_admin_enabled: bool;
   email_events_enabled: bool;
   email_media_enabled: bool;
   email_membership_enabled: bool;
   email_messages_enabled: bool;
   email_pitch_board_enabled: bool;
   email_pom_enabled: bool;
   email_rewards_enabled: bool;
   events_enabled: bool;
   media_enabled: bool;
   membership_enabled: bool;
   messages_enabled: bool;
   pitch_board_enabled: bool;
   pom_enabled: bool;
   rewards_enabled: bool;
   show_message_preview: bool;
 };
type Preferences = 
 record {
   admin_enabled: bool;
   created_at_ms: nat64;
   email_admin_enabled: bool;
   email_events_enabled: bool;
   email_media_enabled: bool;
   email_membership_enabled: bool;
   email_messages_enabled: bool;
   email_pitch_board_enabled: bool;
   email_pom_enabled: bool;
   email_rewards_enabled: bool;
   events_enabled: bool;
   media_enabled: bool;
   membership_enabled: bool;
   messages_enabled: bool;
   pitch_board_enabled: bool;
   pom_enabled: bool;
   rewards_enabled: bool;
   show_message_preview: bool;
   updated_at_ms: nat64;
   user: text;
 };
type Notification = 
 record {
   attempts: nat32;
   body: text;
   club: text;
   created_at_ms: nat64;
   id: text;
   idempotency_key: text;
   kind: text;
   next_attempt_ms: nat64;
   read: bool;
   related_id: opt text;
   status: Status;
   user: text;
 };
type DigestSource = 
 variant {
   Club;
   Group;
   Team;
 };
type DigestResults = 
 variant {
   Err: text;
   Ok: vec DigestItem;
 };
type DigestResult = 
 variant {
   Err: text;
   Ok: DigestItem;
 };
type DigestItem = 
 record {
   chat_scope_id: text;
   classification: DigestClassification;
   digested_at_ms: nat64;
   id: text;
   mentions: vec text;
   message_created_at_ms: nat64;
   message_id: text;
   message_type: DigestSource;
   provider: opt text;
   summary: text;
   topic: opt text;
 };
type DigestClassification = 
 variant {
   Action;
   Decision;
   Info;
   Question;
   Social;
 };
type ChatType = 
 variant {
   Broadcast;
   Club;
   ClubAdmin;
   Direct;
   Group;
   Team;
 };
type ChatNotifyBatchResult = 
 variant {
   Err: text;
   Ok: nat16;
 };
service : {
  acknowledge: (id: text, key: text) -> (Result);
  cancel_scheduled: (id: text, author: text) -> (ScheduledResult);
  claim: (now_ms: nat64, limit: nat16) -> (Results);
  clear_inbox: (user: text, club: opt text) -> (ResultNat16);
  delete_notification: (id: text) -> (variant {
                                        Err: text;
                                        Ok;
                                      });
  due_scheduled: (now_ms: nat64, limit: nat16) -> (ScheduledResults) query;
  enqueue: (id: text, user: text, club: text, kind: text, body: text, key:
   text) -> (Result);
  fail: (id: text, error: text, retry_at_ms: opt nat64) -> (Result);
  fan_out: (users: vec text, club: text, kind: text, body: text, key_prefix:
   text, related_id: opt text) -> (ResultNat16);
  get_digest: (source: DigestSource, chat_scope_id: text, since_ms: nat64,
   limit: nat16) -> (DigestResults) query;
  get_notification: (id: text) -> (opt Notification) query;
  get_preferences: (user: text) -> (Preferences) query;
  get_push_alert_settings: () -> (PushAlertSettings) query;
  grant_worker: ("principal": principal) -> (variant {
                                               Err: text;
                                               Ok;
                                             });
  initialize: () -> (variant {
                       Err: text;
                       Ok;
                     });
  list_inbox: (user: text, club: opt text, limit: nat16) -> (Results) query;
  list_preferences_by_club: (club_id: text, limit: nat32, offset: nat32) ->
   (PreferencesPageResult) query;
  list_scheduled: (author: text, target: opt text) ->
   (ScheduledResults) query;
  mark_all_read: (user: text, club: opt text) -> (ResultNat16);
  mark_failed: (id: text, error: text) -> (ScheduledResult);
  mark_read: (id: text) -> (Result);
  mark_sent: (id: text, sent_message_id: text) -> (ScheduledResult);
  record_chat_notify_batch: (message_id: text, conversation_id: text, sender:
   text, preview: text, recipients: vec text, mute_list: vec text) ->
   (ChatNotifyBatchResult);
  record_digest_item: (id: text, message_id: text, message_type:
   DigestSource, chat_scope_id: text, message_created_at_ms: nat64,
   classification: DigestClassification, summary: text, topic: opt text,
   mentions: vec text, provider: opt text) -> (DigestResult);
  recover: () -> (ResultNat16);
  schedule_message: (id: text, author: text, chat_type: ChatType, team_id:
   opt text, club_id: opt text, group_id: opt text, conversation_id:
   opt text, body: text, image_url: opt text, reply_to_id: opt text,
   scheduled_for_ms: nat64, recurrence: Recurrence, recurrence_until_ms:
   opt nat64) -> (ScheduledResult);
  set_messaging_domain_canister: (id: principal) -> (variant {
                                                       Err: text;
                                                       Ok;
                                                     });
  transfer_governorship: (new_governor: principal) ->
   (variant {
      Err: text;
      Ok;
    });
  update_scheduled_message: (id: text, author: text, body: opt text,
   image_url: opt text, scheduled_for_ms: opt nat64, recurrence:
   opt Recurrence, recurrence_until_ms: opt nat64) -> (ScheduledResult);
  upsert_preferences: (user: text, input: PreferencesInput) ->
   (PreferencesResult);
  upsert_push_alert_settings: (input: PushAlertSettingsInput) ->
   (PushAlertSettings);
}
