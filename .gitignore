node_modules/
frontend/dist*/
frontend/.lab-cache*/
frontend/.vitest-cache/
.mops/
.env*
**/.env*
!.env.example
*.pem
.icp/
# Keep the mainnet canister ID mapping (reruns must reuse existing canisters)
!deploy/mainnet/.icp/
deploy/mainnet/.icp/*
!deploy/mainnet/.icp/data/
deploy/mainnet/.icp/data/*
!deploy/mainnet/.icp/data/mappings/
.local-icp/
target/
# Keep the frontend canister ID mapping too
!deploy/frontend/.icp/
deploy/frontend/.icp/*
!deploy/frontend/.icp/data/
deploy/frontend/.icp/data/*
!deploy/frontend/.icp/data/mappings/
