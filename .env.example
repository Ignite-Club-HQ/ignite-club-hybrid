# Public browser configuration for the approved DEV Supabase project.
# Never put a service-role key or production credentials here.
IGNITE_LIVE_SUPABASE_ALIAS=dev
IGNITE_LIVE_SUPABASE_URL=https://cdrxmelhysdqrccttsjg.supabase.co
IGNITE_LIVE_SUPABASE_ANON_KEY=your-public-anon-key
# Enable only after confirming Google OAuth and callbacks on the production backend.
IGNITE_LIVE_GOOGLE_SIGN_IN_ENABLED=false

# Public ICP gateway and deployed canister IDs for the reviewed environment.
IGNITE_LIVE_ICP_ALIAS=icp-public-mainnet
IGNITE_LIVE_ICP_HOST=https://icp-api.io
IGNITE_LIVE_ICP_CANISTER_IDS_JSON={}
# Show personal names protected by each club's key in chats, schedules and
# rosters. The release is live on mainnet, so the build scripts default this
# to 1; set it to 0 here to keep protected names hidden.
IGNITE_LIVE_PRIVATE_CLUB_NAME_DISPLAYS=1
